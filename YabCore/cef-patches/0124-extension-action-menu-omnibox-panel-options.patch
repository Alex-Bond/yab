+}  // namespace
+
+void InstallSurfaceHooks() {
+  auto& hooks = extensions::GetExternalSurfaceHooks();
+  if (!hooks.side_panel_options_changed) {
+    hooks.side_panel_options_changed = &SidePanelOptionsChanged;
+  }
+}
+
+CefRefPtr<CefListValue> ActionMenu(CefBrowserHostBase* browser,
+                                   const std::string& extension_id) {
+  const Extension* extension = nullptr;
+  auto* contents = PageFor(browser, extension_id, &extension);
+  if (!contents) {
+    return nullptr;
+  }
+  ActionItems items(contents->GetBrowserContext(), *extension);
+  return Rows(&items.model, items.matcher, items.matcher.extension_item_map());
+}
+
+bool RunActionMenuItem(CefBrowserHostBase* browser,
+                       const std::string& extension_id,
+                       const std::string& item_id) {
+  const Extension* extension = nullptr;
+  auto* contents = PageFor(browser, extension_id, &extension);
+  if (!contents || item_id.empty() ||
+      contents->GetVisibility() != content::Visibility::VISIBLE) {
+    return false;
+  }
+  // The item as the menu lists it now, as Chrome's menu runs only a row it
+  // shows: rebuilt, so a removed, hidden or disabled one is refused.
+  ActionItems items(contents->GetBrowserContext(), *extension);
+  for (const auto& [command, id] : items.matcher.extension_item_map()) {
+    if (ItemID(id) != item_id) {
+      continue;
+    }
+    if (!items.matcher.IsCommandIdVisible(command) ||
+        !items.matcher.IsCommandIdEnabled(command) || !Front(contents)) {
+      return false;
+    }
+    // ExtensionContextMenuModel::ExecuteCommand: MenuManager grants
+    // activeTab, toggles a checkbox or radio and sends onClicked.
+    items.matcher.ExecuteCommand(command, contents, nullptr,
+                                 content::ContextMenuParams());
+    return true;
+  }
+  return false;
+}
+
+CefRefPtr<CefDictionaryValue> OmniboxInput(
+    CefBrowserHostBase* browser,
+    const std::string& extension_id,
+    CefRefPtr<CefDictionaryValue> input) {
+  const Extension* extension = nullptr;
+  auto* contents = PageFor(browser, extension_id, &extension);
+  if (!contents || !input ||
+      extensions::OmniboxInfo::GetKeyword(extension).empty()) {
+    return nullptr;
+  }
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  const std::string event = input->GetString("event").ToString();
+  const std::string text = input->GetString("text").ToString();
+  auto result = CefDictionaryValue::Create();
+  bool listening = true;
+  if (event == "started") {
+    extensions::ExtensionOmniboxEventRouter::OnInputStarted(profile,
+                                                            extension_id);
+  } else if (event == "changed") {
+    if (auto* relay = SuggestionsRelay::For(profile->GetOriginalProfile())) {
+      relay->Asked(extension_id, contents);
+    }
+    listening = extensions::ExtensionOmniboxEventRouter::OnInputChanged(
+        profile, extension_id, text, input->GetInt("requestId"));
+  } else if (event == "entered") {
+    // OnInputEntered grants activeTab through this page's granter, and
+    // the extension acts on it as the window's active tab.
+    if (!extensions::ActiveTabPermissionGranter::FromWebContents(contents) ||
+        contents->GetVisibility() != content::Visibility::VISIBLE ||
+        !Front(contents)) {
+      return nullptr;
+    }
+    const std::string way = input->GetString("disposition").ToString();
+    WindowOpenDisposition disposition =
+        way == "newForegroundTab"   ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+        : way == "newBackgroundTab" ? WindowOpenDisposition::NEW_BACKGROUND_TAB
+                                    : WindowOpenDisposition::CURRENT_TAB;
+    extensions::ExtensionOmniboxEventRouter::OnInputEntered(
+        contents, extension_id, text, disposition);
+  } else if (event == "cancelled") {
+    extensions::ExtensionOmniboxEventRouter::OnInputCancelled(profile,
+                                                              extension_id);
+  } else {
+    return nullptr;
+  }
+  result->SetBool("listening", listening);
+  if (event == "started" || event == "changed") {
+    if (auto description = DefaultSuggestion(profile, extension_id)) {
+      result->SetString("default", *description);
+    } else {
+      result->SetNull("default");
+    }
+  }
+  return result;
+}
