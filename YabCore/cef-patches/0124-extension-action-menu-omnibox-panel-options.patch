--- /dev/null
+++ b/chrome/browser/extensions/external_surface_hooks.h
@@ -0,0 +1,34 @@
+// Yab: what Chrome tells an embedder that draws an extension surface itself
+// (the side panel, here) instead of Chrome's own concealed window. Ordinary
+// Chrome installs no hook and nothing changes for it.
+#ifndef CHROME_BROWSER_EXTENSIONS_EXTERNAL_SURFACE_HOOKS_H_
+#define CHROME_BROWSER_EXTENSIONS_EXTERNAL_SURFACE_HOOKS_H_
+
+#include <optional>
+#include <string>
+
+namespace content {
+class BrowserContext;
+}
+
+namespace extensions {
+
+struct ExternalSurfaceHooks {
+  // chrome.sidePanel.setOptions kept |path| and |enabled| for |tab_id| (-1:
+  // the global options) of |extension_id| in |context|, after Chrome's own
+  // ExtensionSidePanelCoordinators heard it.
+  void (*side_panel_options_changed)(content::BrowserContext* context,
+                                     const std::string& extension_id,
+                                     int tab_id,
+                                     const std::optional<std::string>& path,
+                                     std::optional<bool> enabled) = nullptr;
+};
+
+inline ExternalSurfaceHooks& GetExternalSurfaceHooks() {
+  static ExternalSurfaceHooks hooks;
+  return hooks;
+}
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_EXTERNAL_SURFACE_HOOKS_H_
