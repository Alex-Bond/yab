+
+// The CEF browser and display handler whose page owns |contents|.
+CefRefPtr<CefDisplayHandler> DisplayHandlerFor(
+    content::WebContents* contents,
+    CefRefPtr<CefBrowserHostBase>* browser) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !contents) {
+    return nullptr;
+  }
+  *browser = CefBrowserHostBase::GetBrowserForContents(contents);
+  auto client = *browser ? (*browser)->client() : nullptr;
+  return client ? client->GetDisplayHandler() : nullptr;
+}
+
+// Tells the client of the bound page |contents| about one of its surfaces,
+// over the channel 0095's "sidePanel" uses.
+void Tell(content::WebContents* contents, CefRefPtr<CefDictionaryValue> info) {
+  if (!contents || !extensions::ExternalTabWindow::Bound(contents)) {
+    return;
+  }
+  CefRefPtr<CefBrowserHostBase> browser;
+  auto handler = DisplayHandlerFor(contents, &browser);
+  if (handler && browser) {
+    handler->OnExtensionTabCreated(browser.get(), info);
+  }
+}
+
+// The page in |browser| an extension may act for: bound, alive, enabled
+// extension allowed in its profile. Null otherwise.
+content::WebContents* PageFor(CefBrowserHostBase* browser,
+                              const std::string& extension_id,
+                              const Extension** extension) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !browser) {
+    return nullptr;
+  }
+  auto* contents = browser->GetWebContents();
+  if (!contents || contents->IsBeingDestroyed() ||
+      !extensions::ExternalTabWindow::Bound(contents)) {
+    return nullptr;
+  }
+  auto* context = contents->GetBrowserContext();
+  *extension =
+      extensions::ExtensionRegistry::Get(context)->enabled_extensions().GetByID(
+          extension_id);
+  if (!*extension ||
+      (context->IsOffTheRecord() &&
+       !extensions::util::IsIncognitoEnabled(extension_id, context))) {
+    return nullptr;
+  }
+  return contents;
+}
+
+// The page Chrome would act for, as the active tab of its window: several
+// presented pages can share one logical Chrome window (0116's RunCommand).
+bool Front(content::WebContents* contents) {
+  if (auto* model = extensions::ExternalTabModel::Get(contents);
+      model && !model->Activate()) {
+    return false;
+  }
+  extensions::ExternalTabFocus::Remember(contents);
+  return true;
+}
+
+// --- The toolbar button's own menu ---------------------------------------
+
+// ExtensionContextMenuModel's MenuItemMatchesAction.
+bool MatchesAction(std::optional<ActionInfo::Type> type, const MenuItem* item) {
+  if (!type) {
+    return false;
+  }
+  const MenuItem::ContextList& contexts = item->contexts();
+  return contexts.Contains(MenuItem::ALL) ||
+         (contexts.Contains(MenuItem::PAGE_ACTION) &&
+          *type == ActionInfo::Type::kPage) ||
+         (contexts.Contains(MenuItem::BROWSER_ACTION) &&
+          *type == ActionInfo::Type::kBrowser) ||
+         (contexts.Contains(MenuItem::ACTION) &&
+          *type == ActionInfo::Type::kAction);
+}
+
+// The model's commands run through the matcher, never through it.
+class NoCommands : public ui::SimpleMenuModel::Delegate {
+ public:
+  void ExecuteCommand(int command_id, int event_flags) override {}
+};
+
+// The extension's items as Chrome's action menu appends them.
+struct ActionItems {
+  ActionItems(content::BrowserContext* context, const Extension& extension)
+      : model(&delegate),
+        matcher(context,
+                &delegate,
+                &model,
+                base::BindRepeating(
+                    &MatchesAction,
+                    ActionInfo::GetExtensionActionInfo(&extension)
+                        ? std::make_optional(
+                              ActionInfo::GetExtensionActionInfo(&extension)
+                                  ->type)
+                        : std::nullopt)) {
+    auto* manager = extensions::MenuManager::Get(context);
+    if (!manager ||
+        !manager->MenuItems(MenuItem::ExtensionKey(extension.id()))) {
+      return;
+    }
+    int index = 0;
+    matcher.AppendExtensionItems(MenuItem::ExtensionKey(extension.id()),
+                                 std::u16string(), &index,
+                                 /*is_action_menu=*/true);
+  }
+
+  NoCommands delegate;
+  ui::SimpleMenuModel model;
+  ContextMenuMatcher matcher;
+};
+
+std::string ItemID(const MenuItem::Id& id) {
+  return id.string_uid.empty() ? "#" + base::NumberToString(id.uid)
+                               : id.string_uid;
+}
+
+CefRefPtr<CefListValue> Rows(ui::MenuModel* model,
+                             ContextMenuMatcher& matcher,
+                             const std::map<int, MenuItem::Id>& ids) {
+  auto rows = CefListValue::Create();
+  size_t count = 0;
+  for (size_t i = 0; i < model->GetItemCount(); ++i) {
+    auto row = CefDictionaryValue::Create();
+    const auto type = model->GetTypeAt(i);
+    if (type == ui::MenuModel::TYPE_SEPARATOR) {
+      row->SetString("type", "separator");
+      rows->SetDictionary(count++, row);
+      continue;
+    }
+    const int command = model->GetCommandIdAt(i);
+    auto found = ids.find(command);
+    if (found == ids.end() || !matcher.IsCommandIdVisible(command)) {
+      continue;
+    }
+    row->SetString("id", ItemID(found->second));
+    row->SetString("title", model->GetLabelAt(i));
+    row->SetString("type", type == ui::MenuModel::TYPE_CHECK   ? "checkbox"
+                           : type == ui::MenuModel::TYPE_RADIO ? "radio"
+                                                               : "normal");
+    row->SetBool("checked", matcher.IsCommandIdChecked(command));
+    row->SetBool("enabled", matcher.IsCommandIdEnabled(command));
+    if (type == ui::MenuModel::TYPE_SUBMENU) {
+      if (auto* submenu = model->GetSubmenuModelAt(i)) {
+        row->SetList("items", Rows(submenu, matcher, ids));
+      }
+    }
+    rows->SetDictionary(count++, row);
+  }
+  return rows;
+}
+
+// --- The side panel's options ---------------------------------------------
+
+// The first bound page of |context|'s windows, in creation order.
+content::WebContents* AnyBoundPage(content::BrowserContext* context) {
+  if (auto* focused = extensions::ExternalTabFocus::Get(context)) {
+    if (extensions::ExternalTabWindow::Bound(focused)) {
+      return focused;
+    }
+  }
+  content::WebContents* found = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* window) {
+        if (window->GetProfile() != context) {
+          return true;
+        }
+        TabStripModel* strip = window->GetTabStripModel();
+        for (int i = 0; strip && i < strip->count(); ++i) {
+          auto* contents = strip->GetWebContentsAt(i);
+          if (extensions::ExternalTabWindow::Bound(contents)) {
+            found = contents;
+            return false;
+          }
+        }
+        return true;
+      });
+  return found;
+}
+
+void SidePanelOptionsChanged(content::BrowserContext* context,
+                             const std::string& extension_id,
+                             int tab_id,
+                             const std::optional<std::string>& path,
+                             std::optional<bool> enabled) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !context) {
+    return;
+  }
+  content::WebContents* page = nullptr;
+  if (tab_id >= 0) {
+    extensions::ExtensionTabUtil::GetTabById(tab_id, context,
+                                             /*include_incognito=*/false,
+                                             &page);
+  } else {
+    page = AnyBoundPage(context);
+  }
+  if (!page) {
+    return;
+  }
+  auto info = CefDictionaryValue::Create();
+  info->SetString("requestedKind", "sidePanelOptions");
+  info->SetString("extensionId", extension_id);
+  info->SetInt("tabId", tab_id);
+  if (path) {
+    info->SetString("path", *path);
+  }
+  if (enabled) {
+    info->SetBool("enabled", *enabled);
+  }
+  Tell(page, info);
+}
+
+// --- The omnibox keyword --------------------------------------------------
+
+// The pages whose field last asked each extension for suggestions, on the
+// original profile, as the watcher is. The watcher, a keyed service, is gone
+// before the profile's user data: this never removes itself from it.
+class SuggestionsRelay : public base::SupportsUserData::Data,
+                         public OmniboxSuggestionsWatcher::Observer {
+ public:
+  static SuggestionsRelay* For(Profile* profile) {
+    auto* relay = static_cast<SuggestionsRelay*>(profile->GetUserData(&kKey));
+    if (relay) {
+      return relay;
+    }
+    auto* watcher =
+        OmniboxSuggestionsWatcherFactory::GetForBrowserContext(profile);
+    if (!watcher) {
+      return nullptr;
+    }
+    auto made = std::make_unique<SuggestionsRelay>();
+    relay = made.get();
+    profile->SetUserData(&kKey, std::move(made));
+    watcher->AddObserver(relay);
+    return relay;
+  }
+
+  void Asked(const std::string& extension_id, content::WebContents* page) {
+    pages_[extension_id] = page->GetWeakPtr();
+  }
+
+  // OmniboxSuggestionsWatcher::Observer:
+  void OnOmniboxSuggestionsReady(
+      const std::vector<ExtensionSuggestion>& suggestions,
+      const int request_id,
+      const std::string& extension_id) override {
+    auto found = pages_.find(extension_id);
+    content::WebContents* page =
+        found == pages_.end() ? nullptr : found->second.get();
+    if (!page || page->IsBeingDestroyed()) {
+      return;
+    }
+    auto rows = CefListValue::Create();
+    size_t count = 0;
+    for (const auto& suggestion : suggestions) {
+      auto row = CefDictionaryValue::Create();
+      row->SetString("content", suggestion.content);
+      row->SetString("description", suggestion.description);
+      rows->SetDictionary(count++, row);
+    }
+    auto info = CefDictionaryValue::Create();
+    info->SetString("requestedKind", "omniboxSuggestions");
+    info->SetString("extensionId", extension_id);
+    info->SetInt("requestId", request_id);
+    info->SetList("suggestions", rows);
+    Tell(page, info);
+  }
+
+ private:
+  inline static const int kKey = 0;
+  std::map<std::string, base::WeakPtr<content::WebContents>> pages_;
+};
+
+// omnibox.setDefaultSuggestion's description, as Chrome keeps it.
+std::optional<std::string> DefaultSuggestion(Profile* profile,
+                                             const std::string& extension_id) {
+  auto* prefs = extensions::ExtensionPrefs::Get(profile);
+  const base::DictValue* dict =
+      prefs ? prefs->ReadPrefAsDict(extension_id, "omnibox_default_suggestion")
+            : nullptr;
+  const std::string* description =
+      dict ? dict->FindString("description") : nullptr;
+  return description ? std::make_optional(*description) : std::nullopt;
+}
