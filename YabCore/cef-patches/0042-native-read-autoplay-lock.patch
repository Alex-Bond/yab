+bool CefBrowserHostBase::LockNativeReadAutoplay() {
+  CEF_REQUIRE_UIT_RETURN(false);
+  if(!CEF_API_IS_ADDED(CEF_EXPERIMENTAL))return false;
+  if(native_read_autoplay_locked_)return true;
+  auto* contents=GetWebContents();
+  if(!contents || native_nonblank_document_seen_ || contents->IsBeingDestroyed() || !contents->GetPrimaryMainFrame() || contents->GetController().GetPendingEntry())return false;
+  bool blank=true;
+  contents->GetPrimaryMainFrame()->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+    const auto& url=frame->GetLastCommittedURL();if(!url.is_empty() && !url.IsAboutBlank())blank=false;
+  });
+  if(!blank)return false;
+  native_read_autoplay_locked_=true;
+  contents->OnWebPreferencesChanged();return true;
+}
