+
+void NativeWidgetMacNSWindowHost::ReleaseCompositorWhileHidden() {
+  // A capture (a picture of the page asked as it went to sleep) may still hold
+  // the compositor visible: the release then waits for the capture's end
+  // (OnVideoCaptureLockDestroyed).
+  if (getenv("YAB_TRACE_FRAME_SINK")) {
+    fprintf(stderr, "YabFrameSink: release asked hosted=%d compositor=%d visible=%d captures=%u\n",
+            externally_hosted_, !!compositor_, is_visible_, video_capture_count_);
+  }
+  if (!externally_hosted_ || !compositor_ || is_visible_) {
+    return;
+  }
+  release_compositor_while_hidden_ = true;
+  UpdateCompositorVisibility();
+  if (getenv("YAB_TRACE_FRAME_SINK")) {
+    fprintf(stderr, "YabFrameSink: released=%d\n", compositor_->frame_sink_released());
