+void HostFrameSinkManager::DestroyRootCompositorFrameSink(
+    const FrameSinkId& frame_sink_id) {
+  auto it = frame_sink_data_map_.find(frame_sink_id);
+  if (it == frame_sink_data_map_.end() || !it->second.is_root ||
+      !it->second.has_created_compositor_frame_sink || !frame_sink_manager_) {
+    return;
+  }
+  it->second.has_created_compositor_frame_sink = false;
+  display_hit_test_query_.erase(frame_sink_id);
+  frame_sink_manager_->DestroyCompositorFrameSink(frame_sink_id,
+                                                  base::DoNothing());
+}
