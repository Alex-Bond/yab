+void RecyclableCompositorMac::ReleaseFrameSink() {
+  if (frame_sink_released_ || compositor_.IsVisible()) {
+    return;
+  }
+  frame_sink_released_ = true;
+  compositor_.ReleaseAcceleratedWidget();
+  // Releasing the widget drops this side's frame sink only: viz keeps the root
+  // CompositorFrameSink, its Display and the last frame's resources until it
+  // is told, as it is when a lost context creates the next one.
+  if (auto* manager = compositor_.context_factory()->GetHostFrameSinkManager()) {
+    manager->DestroyRootCompositorFrameSink(compositor_.frame_sink_id());
+  }
+  if (getenv("YAB_TRACE_FRAME_SINK")) {
+    fprintf(stderr, "YabFrameSink: root frame sink destroyed\n");
+  }
+}
+
+void RecyclableCompositorMac::RestoreFrameSink() {
+  if (!frame_sink_released_) {
+    return;
+  }
+  frame_sink_released_ = false;
+  compositor_.SetAcceleratedWidget(
+      accelerated_widget_mac_->accelerated_widget());
+}
