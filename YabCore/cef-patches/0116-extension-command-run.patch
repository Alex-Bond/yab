+#include "cef/libcef/browser/views/external_command.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/values.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/common/api_version_util.h"
+#include "chrome/browser/extensions/commands/command_service.h"
+#include "chrome/browser/extensions/extension_tab_util.h"
+#include "chrome/browser/extensions/external_tab_model.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/event_router.h"
+#include "extensions/browser/extension_event_histogram_value.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_util.h"
+#include "extensions/browser/permissions/active_tab_permission_granter.h"
+#include "extensions/common/command.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/mojom/context_type.mojom.h"
+#include "ui/base/accelerators/command.h"
+
+namespace cef::external_host {
+
+bool RunCommand(CefBrowserHostBase* browser,
+                const std::string& extension_id,
+                const std::string& command_name) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !browser ||
+      command_name.empty() ||
+      extensions::Command::IsActionRelatedCommand(command_name)) {
+    return false;
+  }
+  auto* owner = browser->GetWebContents();
+  if (!owner || owner->IsBeingDestroyed() ||
+      owner->GetVisibility() != content::Visibility::VISIBLE) {
+    return false;
+  }
+  // The page in front of its window, as Chrome's registry runs a command for
+  // the active tab of the window that has the key.
+  auto* window =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(owner);
+  if (!window || window->GetTabStripModel()->GetActiveWebContents() != owner) {
+    return false;
+  }
+  auto* context = owner->GetBrowserContext();
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(context)->enabled_extensions().GetByID(
+          extension_id);
+  if (!extension ||
+      (context->IsOffTheRecord() &&
+       !extensions::util::IsIncognitoEnabled(extension_id, context))) {
+    return false;
+  }
+  // Only a command the manifest declares; its scope as the user set it.
+  ui::CommandMap commands;
+  extensions::CommandService::Get(context)->GetNamedCommands(
+      extension_id, extensions::CommandService::ALL,
+      extensions::CommandService::ANY_SCOPE, &commands);
+  auto found = commands.find(command_name);
+  if (found == commands.end()) {
+    return false;
+  }
+
+  base::ListValue args;
+  args.Append(command_name);
+  base::Value tab_value;
+  if (!found->second.global()) {
+    // Several presented pages can share one logical Chrome window: this one
+    // is its active tab for the command's tabs queries, as for an action.
+    if (auto* model = extensions::ExternalTabModel::Get(owner);
+        model && !model->Activate()) {
+      return false;
+    }
+    extensions::ExternalTabFocus::Remember(owner);
+    // ExtensionKeybindingRegistry::CommandExecuted: grant before sending the
+    // event, so the permission is there when the extension acts on it.
+    if (auto* granter =
+            extensions::ActiveTabPermissionGranter::FromWebContents(owner)) {
+      granter->GrantIfRequested(extension);
+    }
+    constexpr extensions::mojom::ContextType kContextType =
+        extensions::mojom::ContextType::kPrivilegedExtension;
+    tab_value = base::Value(
+        extensions::ExtensionTabUtil::CreateTabObject(
+            owner,
+            extensions::ExtensionTabUtil::GetScrubTabBehavior(
+                extension, kContextType, owner),
+            extension)
+            .ToValue());
+  }
+  args.Append(std::move(tab_value));
+
+  auto event = std::make_unique<extensions::Event>(
+      extensions::events::COMMANDS_ON_COMMAND, "commands.onCommand",
+      std::move(args), context);
+  event->user_gesture = extensions::EventRouter::UserGestureState::kEnabled;
+  extensions::EventRouter::Get(context)->DispatchEventToExtension(
+      extension_id, std::move(event));
+  return true;
+}
+
