+// An extension's named command run for a page the client presents, as
+// Chrome's ExtensionKeybindingRegistry runs it when the command's key is
+// pressed in a Chrome window. The client owns the key map: CEF_CTT_NONE
+// windows have no Chrome accelerators, and the client hands every key Chrome
+// would have taken back to its own.
+#ifndef CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_COMMAND_H_
+#define CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_COMMAND_H_
+#pragma once
+
+#include <string>
+
+class CefBrowserHostBase;
+
+namespace cef::external_host {
+// Grants activeTab for |browser|'s tab and dispatches commands.onCommand
+// with |command_name| and that tab to |extension_id|, as a user gesture; a
+// global command without tab or grant. False for an action command, a
+// command the extension doesn't declare, a hidden or inactive owner, or an
+// extension not enabled (or not allowed in this off-the-record profile).
+// UI thread.
+bool RunCommand(CefBrowserHostBase* browser,
+                const std::string& extension_id,
+                const std::string& command_name);
+}  // namespace cef::external_host
+
+#endif  // CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_COMMAND_H_
