+// Native extension operations on the embedder's authoritative tab model.
+#ifndef CHROME_BROWSER_EXTENSIONS_EXTERNAL_TAB_OPERATIONS_H_
+#define CHROME_BROWSER_EXTENSIONS_EXTERNAL_TAB_OPERATIONS_H_
+#include "chrome/browser/extensions/external_action_origin.h"
+#include "chrome/browser/extensions/external_tab_model.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "extensions/browser/extension_function.h"
+#include "extensions/common/extension.h"
+namespace extensions {
+inline bool RequestExternalTabOperation(ExtensionFunction* function,
+    const std::string& method, const base::ListValue& args,
+    base::OnceCallback<void(base::Value, std::string)> done) {
+  auto hook = GetExternalExtensionHooks().tab_operation;
+  if (!hook || !function->extension()) return false;
+  auto* owner = function->GetSenderWebContents();
+  if (auto* origin = owner ? ExternalActionOrigin::Get(owner) : nullptr)
+    owner = origin->Owner(owner);
+  auto usable = [function](content::WebContents* page) {
+    auto* model = ExternalTabModel::Get(page);
+    return page && page->GetBrowserContext() == function->browser_context() &&
+           model && model->embedded();
+  };
+  if (!usable(owner)) owner = ExternalTabFocus::Get(function->browser_context());
+  if (!usable(owner)) {
+    owner = nullptr;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          auto* page = browser->GetTabStripModel()->GetActiveWebContents();
+          if (!usable(page)) return true;
+          owner = page; return false;
+        });
+  }
+  return owner && hook(owner, function->extension()->id(), method, args, &done);
+}
+}  // namespace extensions
+#endif
