 namespace {
+bool LogicalTabUpdated(base::WeakPtr<content::WebContents> weak,
+    const std::vector<std::string>& properties,
+    content::BrowserContext* context, extensions::mojom::ContextType target,
+    const extensions::Extension* extension, const base::DictValue* filter,
+    std::optional<base::ListValue>& args,
+    extensions::mojom::EventFilteringInfoPtr& filtering, bool* separate) {
+  auto* contents = weak.get();
+  if (!contents) return false;
+  auto scrub = extensions::ExtensionTabUtil::GetScrubTabBehavior(extension, target, contents);
+  auto tab = extensions::ExtensionTabUtil::CreateTabObject(contents, scrub, extension).ToValue();
+  base::DictValue changed;
+  for (const auto& property : properties)
+    if (const auto* value = tab.Find(property)) changed.Set(property, value->Clone());
+  args.emplace(); args->Append(extensions::ExtensionTabUtil::GetTabId(contents));
+  args->Append(std::move(changed)); args->Append(std::move(tab));
+  return true;
+}
+class TabOperations : public base::SupportsUserData::Data {
+ public:
+  using Done = base::OnceCallback<void(base::Value, std::string)>;
+  inline static const int key = 0;
+  int next = 0;
+  std::map<int, Done> pending;
+  ~TabOperations() override {
+    for (auto& [id, done] : pending)
+      std::move(done).Run(base::Value(), "The owning window was closed");
+  }
+  static TabOperations* Get(content::WebContents* page) {
