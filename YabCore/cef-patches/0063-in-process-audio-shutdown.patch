-                std::unique_ptr<audio::Service>>
-                service;
-            service.GetOrCreateValue() = audio::CreateEmbeddedService(
-                audio_manager, std::move(receiver));
+            InProcessAudioService().GetOrCreateValue() =
+                audio::CreateEmbeddedService(audio_manager,
+                                             std::move(receiver));
           },
           BrowserMainLoop::GetAudioManager(), std::move(receiver)));
 }
@@ -179,6 +190,23 @@
 
 }  // namespace
 
+void ShutDownInProcessAudioService() {
+  // Streams a page still had open when the browser quit close here, against
+  // a live AudioManager. Left to the UI thread's sequence-local storage on
+  // macOS, the service was destroyed by BrowserTaskExecutor::Shutdown(),
+  // after ~BrowserMainLoop had freed the AudioManager, and
+  // ~DeviceListenerOutputStream called into the freed object.
+  auto* runner = audio::Service::GetInProcessTaskRunner();
+  if (runner->RunsTasksInCurrentSequence()) {
+    InProcessAudioService().reset();
+    return;
+  }
+  // Elsewhere the audio thread runs this before AudioManager::Shutdown()'s
+  // own task stops it.
+  runner->PostTask(FROM_HERE,
+                   base::BindOnce([] { InProcessAudioService().reset(); }));
+}
