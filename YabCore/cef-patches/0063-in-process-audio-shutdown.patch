+// The in-process service, kept in the sequence-local storage of the audio
+// task runner. On macOS that runner is the UI thread (the AudioManager must
+// run there), whose storage outlives BrowserMainLoop and with it the
+// AudioManager the service's streams point at: see
+// ShutDownInProcessAudioService().
+base::SequenceLocalStorageSlot<std::unique_ptr<audio::Service>>&
+InProcessAudioService() {
+  // Trivially destructible, as the slot this replaces was: no NoDestructor.
+  static base::SequenceLocalStorageSlot<std::unique_ptr<audio::Service>>
+      service;
+  return service;
+}
