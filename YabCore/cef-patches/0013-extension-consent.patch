+#include "cef/libcef/browser/views/external_consent.h"
+
+#include <atomic>
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/scoped_observation.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "base/unguessable_token.h"
+#include "cef/include/cef_browser_process_handler.h"
+#include "cef/include/cef_values.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "cef/libcef/common/api_version_util.h"
+#include "cef/libcef/common/app_manager.h"
+#include "chrome/browser/extensions/extension_uninstall_dialog.h"
+#include "chrome/browser/extensions/external_action_origin.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "content/public/browser/web_contents.h"
+#include "crypto/hash.h"
+#include "extensions/browser/extension_install_prompt_client.h"
+#include "extensions/browser/install_prompt_data.h"
+#include "extensions/common/extension.h"
+
+namespace cef::external_host {
+namespace {
+
+using extensions::ExtensionInstallPromptClient;
+using extensions::ExtensionUninstallDialog;
+using extensions::InstallPromptData;
+using Result = ExtensionInstallPromptClient::Result;
+
+constexpr char kConsentSwitch[] = "yab-extension-consent";
+constexpr int64_t kMaxManifestBytes = 1024 * 1024;
+constexpr size_t kMaxPending = 16;
+
+CefRefPtr<CefBrowserProcessHandler> Handler() {
+  auto app = CefAppManager::Get()->GetApplication();
+  return app ? app->GetBrowserProcessHandler() : nullptr;
+}
+
+// One request waiting for the embedder. Lives in the registry until answered
+// or withdrawn; destroying it never runs Chrome's callback by itself.
+class Pending {
+ public:
+  virtual ~Pending() = default;
+  // The embedder answered. Runs Chrome's side exactly once.
+  virtual void Answer(bool accept) = 0;
+  // Chrome withdrew the request (profile gone, dialog closed by Chrome).
+  virtual void Withdraw() = 0;
+  virtual bool Owns(const void*) const { return false; }
+};
+
+using Registry = std::map<std::string, std::unique_ptr<Pending>>;
+Registry& GetRegistry() {
+  static base::NoDestructor<Registry> registry;
+  return *registry;
+}
+
+std::unique_ptr<Pending> Take(const std::string& token) {
+  auto& registry = GetRegistry();
+  auto found = registry.find(token);
+  if (found == registry.end()) return nullptr;
+  auto pending = std::move(found->second);
+  registry.erase(found);
+  return pending;
+}
+
+void NotifyWithdrawn(const std::string& token) {
+  if (auto handler = Handler()) handler->OnExtensionConsentWithdrawn(token);
+}
+
+// Chrome withdrew |token|: stop waiting, tell the embedder.
+void Withdrawn(const std::string& token) {
+  if (auto pending = Take(token)) {
+    pending->Withdraw();
+    NotifyWithdrawn(token);
+  }
+}
+
+void Answer(std::string token, bool accept) {
+  if (auto pending = Take(token)) pending->Answer(accept);
+}
+
+class ConsentCallback : public CefExtensionConsentCallback {
+ public:
+  explicit ConsentCallback(std::string token) : token_(std::move(token)) {}
+  ~ConsentCallback() override { Finish(false); }
+  void Continue(bool accept) override { Finish(accept); }
+
+ private:
+  void Finish(bool accept) {
+    if (answered_.exchange(true)) return;
+    if (CEF_CURRENTLY_ON_UIT()) {
+      Answer(token_, accept);
+    } else {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&Answer, token_, accept));
+    }
+  }
+  const std::string token_;
+  std::atomic<bool> answered_{false};
+  IMPLEMENT_REFCOUNTING(ConsentCallback);
+};
+
+class InstallPending : public Pending, public ProfileObserver {
+ public:
+  InstallPending(std::string token,
+                 Profile* profile,
+                 std::unique_ptr<InstallPromptData> prompt,
+                 ExtensionInstallPromptClient::DoneCallback done)
+      : token_(std::move(token)),
+        prompt_(std::move(prompt)),
+        done_(std::move(done)) {
+    observation_.Observe(profile);
+  }
+  void Answer(bool accept) override {
+    observation_.Reset();
+    Result result = Result::USER_CANCELED;
+    if (accept) {
+      result = prompt_->ShouldWithheldPermissionsOnDialogAccept()
+                   ? Result::ACCEPTED_WITH_WITHHELD_PERMISSIONS
+                   : Result::ACCEPTED;
+      prompt_->OnDialogAccepted();
+    } else {
+      prompt_->OnDialogCanceled();
+    }
+    std::move(done_).Run(
+        ExtensionInstallPromptClient::DoneCallbackPayload(result));
+  }
+  void Withdraw() override {
+    observation_.Reset();
+    prompt_->OnDialogCanceled();
+    std::move(done_).Run(
+        ExtensionInstallPromptClient::DoneCallbackPayload(Result::ABORTED));
+  }
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile*) override {
+    // Destroys this; nothing below touches a member.
+    const std::string token = token_;
+    Withdrawn(token);
+  }
+
+ private:
+  const std::string token_;
+  std::unique_ptr<InstallPromptData> prompt_;
+  ExtensionInstallPromptClient::DoneCallback done_;
+  base::ScopedObservation<Profile, ProfileObserver> observation_{this};
+};
+
+class UninstallPending : public Pending {
+ public:
+  explicit UninstallPending(base::WeakPtr<ExtensionUninstallDialog> dialog)
+      : dialog_(std::move(dialog)) {}
+  void Answer(bool accept) override {
+    // A dialog that already closed has nothing left to answer.
+    if (dialog_) {
+      dialog_->OnDialogClosed(
+          accept ? ExtensionUninstallDialog::CLOSE_ACTION_UNINSTALL
+                 : ExtensionUninstallDialog::CLOSE_ACTION_CANCELED);
+    }
+  }
+  void Withdraw() override {}
+  bool Owns(const void* dialog) const override {
+    return dialog_.get() == dialog;
+  }
+
+ private:
+  base::WeakPtr<ExtensionUninstallDialog> dialog_;
+};
+
+const char* OperationFor(InstallPromptData::PromptType type) {
+  switch (type) {
+    case InstallPromptData::RE_ENABLE_PROMPT:
+      return "reenable";
+    case InstallPromptData::PERMISSIONS_PROMPT:
+      return "permissions";
+    default:
+      return "install";
+  }
+}
+
+CefRefPtr<CefDictionaryValue> Describe(const std::string& token,
+                                       const char* operation,
+                                       Profile* profile,
+                                       const extensions::Extension* extension) {
+  auto request = CefDictionaryValue::Create();
+  request->SetString("request", token);
+  request->SetString("operation", operation);
+  request->SetString("extensionId", extension->id());
+  request->SetString("displayName", extension->name());
+  request->SetString("version", extension->GetVersionForDisplay());
+  request->SetBool("fromWebstore", extension->from_webstore());
+  request->SetString("profilePath", profile->GetPath().AsUTF8Unsafe());
+  request->SetBool("offTheRecord", profile->IsOffTheRecord());
+  return request;
+}
+
+struct Manifest {
+  bool ok = false;
+  std::string text;
+};
+
+Manifest ReadManifest(base::FilePath directory) {
+  Manifest manifest;
+  manifest.ok = base::ReadFileToStringWithMaxSize(
+      directory.AppendASCII("manifest.json"), &manifest.text,
+      kMaxManifestBytes);
+  if (!manifest.ok) manifest.text.clear();
+  return manifest;
+}
+
+void DeliverInstall(std::string token,
+                    CefRefPtr<CefDictionaryValue> request,
+                    base::WeakPtr<content::WebContents> parent,
+                    Manifest manifest) {
+  if (!GetRegistry().count(token)) return;  // Answered or withdrawn meanwhile.
+  auto handler = Handler();
+  if (!handler || !manifest.ok) {
+    // Without the verified manifest nothing is shown: fail closed.
+    Answer(token, false);
+    return;
+  }
+  request->SetString("manifestSHA256",
+                     base::ToLowerASCII(base::HexEncode(
+                         crypto::hash::Sha256(std::string_view(manifest.text)))));
+  request->SetString("manifest", manifest.text);
+  CefRefPtr<CefBrowser> browser;
+  if (parent && !parent->IsBeingDestroyed()) {
+    browser = CefBrowserHostBase::GetBrowserForContents(parent.get());
+  }
+  handler->OnExtensionConsent(browser, request, new ConsentCallback(token));
+}
+
+bool InstallConsent(Profile* profile,
+                    content::WebContents* parent,
+                    const extensions::Extension* extension,
+                    std::unique_ptr<InstallPromptData>* prompt,
+                    ExtensionInstallPromptClient::DoneCallback* done) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !profile || !extension ||
+      !prompt || !*prompt || !done || !Handler() ||
+      GetRegistry().size() >= kMaxPending) {
+    return false;
+  }
+  const std::string token = base::UnguessableToken::Create().ToString();
+  auto data = std::move(*prompt);
+  auto request = Describe(token, OperationFor(data->type()), profile, extension);
+  request->SetInt("promptType", static_cast<int>(data->type()));
+  // Chrome's own permission messages for exactly this extension.
+  auto permissions = data->GetPermissions();
+  auto warnings = CefListValue::Create();
+  for (size_t i = 0; i < permissions.permissions.size(); ++i) {
+    auto row = CefDictionaryValue::Create();
+    row->SetString("text", base::UTF16ToUTF8(permissions.permissions[i]));
+    row->SetString("details", i < permissions.details.size()
+                                  ? base::UTF16ToUTF8(permissions.details[i])
+                                  : std::string());
+    warnings->SetDictionary(i, row);
+  }
+  request->SetList("warnings", warnings);
+  GetRegistry()[token] = std::make_unique<InstallPending>(
+      token, profile, std::move(data), std::move(*done));
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ReadManifest, extension->path()),
+      base::BindOnce(&DeliverInstall, token, request,
+                     parent ? parent->GetWeakPtr()
+                            : base::WeakPtr<content::WebContents>()));
+  return true;
+}
+
+bool UninstallConsent(Profile* profile,
+                      const extensions::Extension* extension,
+                      const extensions::Extension* triggering,
+                      bool report_abuse_offered,
+                      base::WeakPtr<ExtensionUninstallDialog> dialog) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !profile || !extension ||
+      !dialog || !Handler() || GetRegistry().size() >= kMaxPending) {
+    return false;
+  }
+  const std::string token = base::UnguessableToken::Create().ToString();
+  auto request = Describe(token, "uninstall", profile, extension);
+  request->SetBool("reportAbuseOffered", report_abuse_offered);
+  if (triggering) request->SetString("triggeringExtensionId", triggering->id());
+  GetRegistry()[token] = std::make_unique<UninstallPending>(std::move(dialog));
+  // The answer may come before this returns.
+  Handler()->OnExtensionConsent(nullptr, request, new ConsentCallback(token));
+  return true;
+}
+
+void UninstallClosed(ExtensionUninstallDialog* dialog) {
+  for (auto& [token, pending] : GetRegistry()) {
+    if (pending->Owns(dialog)) {
+      const std::string copy = token;
+      Withdrawn(copy);
+      return;
+    }
+  }
+}
+
+}  // namespace
+
+void InstallConsentHooks() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(kConsentSwitch)) {
+    return;
+  }
+  auto& hooks = extensions::GetExternalExtensionHooks();
+  hooks.install_consent = &InstallConsent;
+  hooks.uninstall_consent = &UninstallConsent;
+  hooks.uninstall_closed = &UninstallClosed;
+}
+
+}  // namespace cef::external_host
