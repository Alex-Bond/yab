--- a/content/browser/renderer_host/render_widget_host_view_mac.mm
+++ b/content/browser/renderer_host/render_widget_host_view_mac.mm
@@ -2080,6 +2080,13 @@
     OnFirstResponderChanged(true);
     OnWindowIsKeyChanged(true);
   } else {
+    // End text input first. SetActive(false) asks HasFocus(), which needs
+    // the window key, and OnWindowIsKeyChanged(false) has just cleared it;
+    // OnFirstResponderChanged(false) finds the widget already unfocused.
+    // Neither reset the password-input enabler, so secure keyboard input
+    // stayed on after a password field lost the keys, and macOS kept Caps
+    // Lock from switching input sources everywhere (Yab feedback #949).
+    SetTextInputActive(false);
     OnWindowIsKeyChanged(false);
     OnFirstResponderChanged(false);
   }
