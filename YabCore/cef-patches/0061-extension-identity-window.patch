+// Only Chromium's original WebAuthFlow marks a native identity provider.
+#ifndef CHROME_BROWSER_EXTENSIONS_EXTERNAL_IDENTITY_FLOW_H_
+#define CHROME_BROWSER_EXTENSIONS_EXTERNAL_IDENTITY_FLOW_H_
+#include <memory>
+#include "base/supports_user_data.h"
+#include "content/public/browser/web_contents.h"
+namespace extensions {
+class ExternalIdentityFlow : public base::SupportsUserData::Data {
+ public:
+  static void Mark(content::WebContents* contents) {
+    if (contents && !contents->IsBeingDestroyed())
+      contents->SetUserData(&kKey, std::make_unique<ExternalIdentityFlow>());
+  }
+  static bool IsProvider(content::WebContents* contents) {
+    return contents && !contents->IsBeingDestroyed() && contents->GetUserData(&kKey);
+  }
+ private:
+  inline static const int kKey = 0;
+};
+}  // namespace extensions
+#endif
