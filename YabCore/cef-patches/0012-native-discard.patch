+
+bool CefBrowserHostBase::CanDiscardPage() {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+  return GetWebContents() &&
+         base::FeatureList::IsEnabled(features::kWebContentsDiscard);
+}
+
+void CefBrowserHostBase::DiscardPage(
+    CefRefPtr<CefCompletionCallback> callback) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return;
+  }
+  // The callback runs exactly once: after the renderer acknowledged the
+  // discard, or when this attempt is refused (Chromium then drops its
+  // closure, which destroys the runner).
+  base::ScopedClosureRunner done(base::BindOnce(
+      [](CefRefPtr<CefCompletionCallback> callback) {
+        if (callback) {
+          callback->OnComplete();
+        }
+      },
+      callback));
+  auto* web_contents = GetWebContents();
+  if (!web_contents || !CanDiscardPage() || web_contents->WasDiscarded() ||
+      web_contents->GetVisibility() == content::Visibility::VISIBLE) {
+    return;
+  }
+  web_contents->Discard(base::BindOnce(
+      [](base::ScopedClosureRunner) {}, std::move(done)));
+}
+
+bool CefBrowserHostBase::IsPageDiscarded() {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+  auto* web_contents = GetWebContents();
+  return web_contents && web_contents->WasDiscarded();
+}
+
+bool CefBrowserHostBase::RestoreDiscardedPage() {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+  auto* web_contents = GetWebContents();
+  if (!web_contents || !web_contents->WasDiscarded()) {
+    return false;
+  }
+  // Loads only the selected entry from its saved page state.
+  web_contents->GetController().LoadIfNecessary();
+  if (auto client = GetClient()) {
+    if (auto handler = client->GetDisplayHandler()) {
+      handler->OnPageDiscardedChange(this, web_contents->WasDiscarded());
+    }
+  }
+  return true;
+}
+
+bool CefBrowserHostBase::SetPageFrozen(bool frozen) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+  auto* web_contents = GetWebContents();
+  if (!web_contents ||
+      web_contents->GetVisibility() == content::Visibility::VISIBLE) {
+    return false;
+  }
+  web_contents->SetPageFrozen(frozen);
+  return true;
 }
 
