+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extension_action.h"
+#include "extensions/browser/extension_action_manager.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_util.h"
+#include "extensions/common/extension.h"
+#include "ui/gfx/image/image.h"
+
+namespace cef::external_host {
+namespace {
+
+constexpr size_t kMaxIconBytes = 150000;
+
+using extensions::ExtensionAction;
+using extensions::ExtensionActionDispatcher;
+
+class Watch;
+using Watches = std::map<ExtensionActionDispatcher*, std::unique_ptr<Watch>>;
+Watches& GetWatches() {
+  static base::NoDestructor<Watches> watches;
+  return *watches;
+}
+
+// One per profile's dispatcher (shared with its off-the-record profile).
+// Changes are reported on a later task, never from inside Chrome's
+// notification, and repeats for the same tab and extension waiting for that
+// task are reported once: an extension that sets a badge on every tab, or
+// several properties at once, is one report each.
+class Watch : public ExtensionActionDispatcher::Observer {
+ public:
+  explicit Watch(ExtensionActionDispatcher* dispatcher)
+      : dispatcher_(dispatcher), key_(dispatcher) {
+    dispatcher_->AddObserver(this);
+  }
+  ~Watch() override {
+    if (dispatcher_) dispatcher_->RemoveObserver(this);
+  }
+
+  void OnExtensionActionUpdated(ExtensionAction* action,
+                                content::WebContents* web_contents,
+                                content::BrowserContext* context) override {
+    if (!action || !context) return;
+    CefRefPtr<CefBrowserHostBase> browser;
+    if (web_contents) {
+      browser = CefBrowserHostBase::GetBrowserForContents(web_contents);
+      // A page that is not a CEF browser (an extension's own view) is no
+      // client's tab.
+      if (!browser) return;
+    }
+    const int browser_id = browser ? browser->GetIdentifier() : 0;
+    const std::string path = context->GetPath().value();
+    if (!due_.insert({browser_id, action->extension_id(), path}).second) return;
+    if (due_.size() == 1) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&Watch::Report,
+                                            weak_factory_.GetWeakPtr()));
+    }
+  }
+
+  void OnShuttingDown() override {
+    dispatcher_->RemoveObserver(this);
+    dispatcher_ = nullptr;
+    due_.clear();
+    // Destroys this; nothing of it is touched after.
+    GetWatches().erase(key_.get());
+  }
+
+ private:
+  void Report() {
+    auto due = std::move(due_);
+    due_.clear();
+    auto app = CefAppManager::Get()->GetApplication();
+    auto handler = app ? app->GetBrowserProcessHandler() : nullptr;
+    if (!handler) return;
+    for (const auto& [browser_id, extension_id, path] : due) {
+      CefRefPtr<CefBrowser> browser;
+      if (browser_id) {
+        browser = CefBrowserHostBase::GetBrowserForBrowserId(browser_id).get();
+        if (!browser) continue;  // Closed meanwhile: nobody to tell.
+      }
+      handler->OnExtensionActionChanged(browser, extension_id, path);
+    }
+  }
+
+  raw_ptr<ExtensionActionDispatcher> dispatcher_;
+  // The registry's key, kept past the dispatcher's shutdown.
+  const raw_ptr<ExtensionActionDispatcher> key_;
+  std::set<std::tuple<int, std::string, std::string>> due_;
+  base::WeakPtrFactory<Watch> weak_factory_{this};
+};
+
+void StartWatching(content::BrowserContext* context) {
+  auto* dispatcher = ExtensionActionDispatcher::Get(context);
+  if (!dispatcher) return;
+  auto& watches = GetWatches();
+  if (watches.count(dispatcher)) return;
+  watches.emplace(dispatcher, std::make_unique<Watch>(dispatcher));
+}
+
+int Argb(SkColor color) {
+  return static_cast<int>(color);
+}
+
+}  // namespace
+
+CefRefPtr<CefDictionaryValue> ActionState(CefBrowserHostBase* browser,
+                                          const std::string& extension_id) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !browser) return nullptr;
+  auto* contents = browser->GetWebContents();
+  if (!contents || contents->IsBeingDestroyed()) return nullptr;
+  auto* context = contents->GetBrowserContext();
+  StartWatching(context);
+  scoped_refptr<const extensions::Extension> extension =
+      extensions::ExtensionRegistry::Get(context)->enabled_extensions().GetByID(
+          extension_id);
+  if (!extension || (context->IsOffTheRecord() &&
+                     !extensions::util::IsIncognitoEnabled(extension_id,
+                                                           context))) {
+    return nullptr;
+  }
+  auto* action = extensions::ExtensionActionManager::Get(context)
+                     ->GetExtensionAction(*extension);
+  const int tab = sessions::SessionTabHelper::IdForTab(contents).id();
+  if (!action || tab < 0) return nullptr;
+
+  auto state = CefDictionaryValue::Create();
+  state->SetInt("tabId", tab);
+  state->SetString("title", action->GetTitle(tab));
+  state->SetString("badge", action->GetDisplayBadgeText(tab));
+  state->SetInt("badgeBackgroundColor",
+                Argb(action->GetBadgeBackgroundColor(tab)));
+  state->SetInt("badgeTextColor", Argb(action->GetBadgeTextColor(tab)));
+  state->SetBool("enabled", action->GetIsVisible(tab));
+  state->SetBool("popup", action->HasPopup(tab));
+  // What Chrome's toolbar draws before the manifest icon: an icon the
+  // extension set (this tab's, else every tab's), then a declarative one.
+  gfx::Image icon = action->GetExplicitlySetIcon(tab);
+  const bool tab_icon = action->HasIcon(tab);
+  if (icon.IsEmpty()) icon = action->GetDeclarativeIcon(tab);
+  state->SetBool("iconSet", !icon.IsEmpty());
+  state->SetBool("iconEverywhere",
+                 !icon.IsEmpty() && !tab_icon &&
+                     action->HasIcon(ExtensionAction::kDefaultTabId));
+  if (!icon.IsEmpty()) {
+    scoped_refptr<base::RefCountedMemory> png = icon.As1xPNGBytes();
+    if (png && png->size() > 0 && png->size() <= kMaxIconBytes) {
+      state->SetString("icon", "data:image/png;base64," +
+                                   base::Base64Encode(base::span(*png)));
+    }
+  }
+  return state;
+}
