+// Chrome's own extension action state for a page, and its changes, read in
+// the browser process: no DevTools session on the extension's service worker,
+// which Chrome never stops while one is attached.
+#ifndef CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_ACTION_WATCH_H_
+#define CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_ACTION_WATCH_H_
+#pragma once
+
+#include <string>
+
+#include "cef/include/cef_values.h"
+
+class CefBrowserHostBase;
+
+namespace cef::external_host {
+// The action of |extension_id| as Chrome holds it for |browser|'s tab, or
+// null. Starts watching the profile's actions (idempotent); each change then
+// reaches CefBrowserProcessHandler::OnExtensionActionChanged. UI thread.
+CefRefPtr<CefDictionaryValue> ActionState(CefBrowserHostBase* browser,
+                                          const std::string& extension_id);
+}  // namespace cef::external_host
+
+#endif  // CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_ACTION_WATCH_H_
