+namespace {
+void TabActivateRequested(content::WebContents* contents) {
+  CefRefPtr<CefBrowserHostBase> browser;
+  auto handler = DisplayHandlerFor(contents, &browser);
+  if (!handler) return;
+  auto value = CefDictionaryValue::Create();
+  value->SetString("requestedKind", "activate");
+  handler->OnExtensionTabCreated(browser.get(), value);
+}
+}  // namespace
+
+bool GroupPage(CefBrowserHostBase* browser, CefBrowserHostBase* lead, int index, bool active) {
+  auto* contents = browser ? browser->GetWebContents() : nullptr;
+  auto* owner = lead ? lead->GetWebContents() : nullptr;
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !contents || !owner) return false;
+  bool activated = false;
+  if (!extensions::ExternalTabModel::BindEmbedded(contents, owner,
+          sessions::SessionTabHelper::IdForWindowContainingTab(owner).id(),
+          index, active, &activated)) {
+    return false;
+  }
+  if (activated) {
+    extensions::api::tabs::OnActivated::ActiveInfo info;
+    info.tab_id = extensions::ExtensionTabUtil::GetTabId(contents);
+    info.window_id = extensions::ExtensionTabUtil::GetWindowIdOfTab(contents);
+    if (auto* router = extensions::EventRouter::Get(contents->GetBrowserContext())) {
+      router->BroadcastEvent(std::make_unique<extensions::Event>(
+          extensions::events::TABS_ON_ACTIVATED,
+          extensions::api::tabs::OnActivated::kEventName,
+          extensions::api::tabs::OnActivated::Create(info),
+          contents->GetBrowserContext()));
+    }
+  }
+  return true;
+}
