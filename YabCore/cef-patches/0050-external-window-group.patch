+  // The embedder lists its window: every page in its order, one active.
+  // `activated` says the active page changed. A page moves between windows
+  // here, unlike Bind. Native session ID of the first lead stays the window's.
+  static bool BindEmbedded(content::WebContents* contents,
+                           content::WebContents* lead, int native_window_id,
+                           int index, bool active, bool* activated) {
+    if (!contents || !lead || contents->IsBeingDestroyed() ||
+        lead->IsBeingDestroyed() || native_window_id < 0 ||
+        contents->GetBrowserContext() != lead->GetBrowserContext())
+      return false;
+    if (!Get(lead)) {
+      auto group = std::make_shared<Group>();
+      group->window = native_window_id;
+      group->active = lead->GetWeakPtr();
+      group->tabs.push_back(lead->GetWeakPtr());
+      lead->SetUserData(&kKey, std::unique_ptr<ExternalTabModel>(
+          new ExternalTabModel(lead, group, nullptr, lead)));
+    }
+    auto group = Get(lead)->group_;
+    group->embedded = true;
+    auto* context = contents->GetBrowserContext();
+    if (!context->GetUserData(&kEmbeddedKey))
+      context->SetUserData(&kEmbeddedKey, std::make_unique<base::SupportsUserData::Data>());
+    auto* current = Get(contents);
+    if (current && current->group_ != group) {
+      auto& old = current->group_->tabs;
+      std::erase_if(old, [contents](const auto& tab) { return tab.get() == contents; });
+      if (current->group_->active.get() == contents) current->group_->active.reset();
+      current = nullptr;
+    }
+    if (!current) {
+      contents->SetUserData(&kKey, std::unique_ptr<ExternalTabModel>(
+          new ExternalTabModel(contents, group, nullptr, lead)));
+    }
+    Compact(*group);
+    auto& tabs = group->tabs;
+    std::erase_if(tabs, [contents](const auto& tab) { return tab.get() == contents; });
+    const auto at = index < 0 ? tabs.size()
+                             : std::min(static_cast<size_t>(index), tabs.size());
+    tabs.insert(tabs.begin() + at, contents->GetWeakPtr());
+    if (active && group->active.get() != contents) {
+      group->active = contents->GetWeakPtr();
+      if (activated) *activated = true;
+    }
+    return true;
+  }
