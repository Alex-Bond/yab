+#include "external_pip_mac.h"
+#include <cmath>
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "cef/libcef/browser/views/external_host_mac.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/public/browser/external_pip_routes.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/browser/picture_in_picture/video_picture_in_picture_window_controller_impl.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/accelerated_widget_mac/accelerated_widget_mac.h"
+#include "ui/compositor/compositor.h"
+
+CefExternalPiP::CefExternalPiP(content::WebContents* owner, Changed changed)
+    : content::WebContentsObserver(owner), changed_(std::move(changed)),
+      registration_(base::UnguessableToken::Create()) {
+  content::external_pip::Register(owner, {registration_,
+      base::BindRepeating(&CefExternalPiP::Begin, weak_.GetWeakPtr()),
+      base::BindRepeating([](base::WeakPtr<CefExternalPiP> self, views::Widget* widget) {
+        return self && self->Bind(widget);
+      }, weak_.GetWeakPtr()),
+      base::BindRepeating(&CefExternalPiP::Geometry, weak_.GetWeakPtr()),
+      base::BindRepeating(&CefExternalPiP::End, weak_.GetWeakPtr())});
+}
+CefExternalPiP::~CefExternalPiP() {
+  content::external_pip::Remove(web_contents(), registration_);
+  ClearWidget();
+}
+bool CefExternalPiP::Live() const {
+  auto* owner = web_contents();
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  return owner && !owner->IsBeingDestroyed() && !token_.is_empty() && frame &&
+      frame->IsActive() && frame->IsRenderFrameLive() &&
+      content::WebContents::FromRenderFrameHost(frame) == owner;
+}
+void CefExternalPiP::Begin(content::RenderFrameHost* frame) {
+  End();
+  if (!frame || !frame->IsActive() || !frame->IsRenderFrameLive() ||
+      content::WebContents::FromRenderFrameHost(frame) != web_contents()) return;
+  document_ = frame->GetWeakDocumentPtr(); token_ = base::UnguessableToken::Create();
+  owner_document_ = static_cast<content::RenderFrameHostImpl*>(frame)->GetDocumentToken().ToString();
+  reason_.clear(); SchedulePublish();
+}
+bool CefExternalPiP::Bind(views::Widget* widget) {
+  if (!Live() || !widget || widget->IsClosed() ||
+      (widget_ && widget_.get() != widget) || !cef::external_host::Enable(widget)) return false;
+  auto* compositor = widget->GetCompositor();
+  if (!compositor) return false;
+  auto accelerated = compositor->widget();
+  if (accelerated == gfx::kNullAcceleratedWidget) return false;
+  ClearWidget();
+  widget_ = widget->GetWeakPtr(); observation_.Observe(widget);
+  accelerated_ = accelerated;
+  if (!ui::AcceleratedWidgetMac::SetFrameCallback(accelerated_,
+      base::BindRepeating(&CefExternalPiP::Frame, weak_.GetWeakPtr()))) {
+    ClearWidget(); return false;
+  }
+  SchedulePublish(); return true;
+}
+void CefExternalPiP::Geometry(const gfx::Rect& crop, const gfx::Size& natural,
+    const std::string& surface) {
+  if (!Live() || !widget_) return;
+  crop_ = crop; natural_ = natural;
+  if (!surface.empty()) surface_ = surface;
+  SchedulePublish();
+}
+void CefExternalPiP::Frame(uint32_t context, const gfx::Size& pixels, float scale) {
+  if (!Live() || !widget_ || !std::isfinite(scale) || scale <= 0 ||
+      (context && pixels.IsEmpty())) return;
+  context_ = context; pixels_ = context ? pixels : gfx::Size(); scale_ = scale;
+  SchedulePublish();
+}
+void CefExternalPiP::End() {
+  if (!token_.is_empty()) {
+    retired_token_ = token_.ToString(); retired_document_ = owner_document_;
+  }
+  owner_document_.clear();
+  token_ = {}; document_ = {}; context_ = 0; pixels_ = {}; crop_ = {}; natural_ = {}; surface_.clear();
+  if (reason_.empty()) reason_ = "native-session-ended";
+  SchedulePublish();
+}
+void CefExternalPiP::ClearWidget() {
+  if (accelerated_ != gfx::kNullAcceleratedWidget)
+    ui::AcceleratedWidgetMac::SetFrameCallback(accelerated_, {});
+  accelerated_ = gfx::kNullAcceleratedWidget;
+  observation_.Reset(); widget_.reset(); context_ = 0; pixels_ = {};
+}
+CefRefPtr<CefDictionaryValue> CefExternalPiP::State() {
+  auto state = CefDictionaryValue::Create();
+  state->SetInt("version", 1); state->SetString("kind", "video");
+  const bool active = Live();
+  state->SetBool("active", active);
+  state->SetBool("surfaceReady", active && widget_ && context_ && !surface_.empty() && !crop_.IsEmpty());
+  state->SetString("reason", reason_);
+  if (!active) {
+    state->SetString("retiredToken", retired_token_);
+    state->SetString("retiredDocument", retired_document_);
+    return state;
+  }
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  state->SetString("token", token_.ToString());
+  state->SetString("document", static_cast<content::RenderFrameHostImpl*>(frame)->GetDocumentToken().ToString());
+  state->SetString("frameId", frame->GetDevToolsFrameToken().ToString());
+  state->SetBool("main", frame == web_contents()->GetPrimaryMainFrame());
+  state->SetString("url", frame->GetLastCommittedURL().spec());
+  state->SetString("origin", frame->GetLastCommittedOrigin().Serialize());
+  state->SetDouble("contextId", context_);
+  state->SetInt("pixelWidth", pixels_.width()); state->SetInt("pixelHeight", pixels_.height());
+  state->SetDouble("scale", scale_);
+  state->SetInt("videoX", crop_.x()); state->SetInt("videoY", crop_.y());
+  state->SetInt("videoWidth", crop_.width()); state->SetInt("videoHeight", crop_.height());
+  state->SetInt("naturalWidth", natural_.width()); state->SetInt("naturalHeight", natural_.height());
+  state->SetString("nativeSurface", surface_);
+  return state;
+}
+bool CefExternalPiP::Control(const std::string& token, const std::string& action, const gfx::Size& size) {
+  if (!Live() || token.empty() || token_.ToString() != token || !widget_) return false;
+  auto* controller = content::VideoPictureInPictureWindowControllerImpl::FromWebContents(web_contents());
+  if (!controller) return false;
+  if (action == "resize") {
+    if (size.width() < 120 || size.height() < 80 || size.width() > 3840 || size.height() > 2160) return false;
+    widget_->SetSize(size); controller->UpdateLayerBounds(); return true;
+  }
+  if (action == "play") { controller->Play(); return true; }
+  if (action == "pause") { controller->Pause(); return true; }
+  if (action == "close" || action == "return") {
+    reason_ = action == "return" ? "return-requested" : "closed-by-embedder";
+    // The embedder selects its original Yab tab after return-requested. Never
+    // activate the concealed native source application or producer window.
+    controller->Close(false); return true;
+  }
+  return false;
+}
+void CefExternalPiP::SchedulePublish() {
+  if (publish_pending_) return;
+  publish_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce(&CefExternalPiP::Publish, weak_.GetWeakPtr()));
+}
+void CefExternalPiP::Publish() { publish_pending_ = false; changed_.Run(State()); }
+void CefExternalPiP::OnWidgetDestroying(views::Widget*) { ClearWidget(); reason_="native-widget-destroyed"; End(); }
+void CefExternalPiP::DidFinishNavigation(content::NavigationHandle*) { if (!Live()) End(); }
+void CefExternalPiP::RenderFrameDeleted(content::RenderFrameHost*) { if (!Live()) End(); }
+void CefExternalPiP::PrimaryMainFrameRenderProcessGone(base::TerminationStatus) { reason_="renderer-gone"; End(); }
+void CefExternalPiP::WebContentsDestroyed() {
+  content::external_pip::Remove(web_contents(), registration_); ClearWidget();
+  Observe(nullptr); reason_="browser-closed"; End();
+}
