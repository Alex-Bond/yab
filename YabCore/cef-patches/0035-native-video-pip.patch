+#ifndef CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_PIP_MAC_H_
+#define CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_PIP_MAC_H_
+#include <string>
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/unguessable_token.h"
+#include "cef/include/cef_values.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+class CefExternalPiP final : public content::WebContentsObserver,
+    public views::WidgetObserver {
+ public:
+  using Changed = base::RepeatingCallback<void(CefRefPtr<CefDictionaryValue>)>;
+  CefExternalPiP(content::WebContents* owner, Changed changed);
+  ~CefExternalPiP() override;
+  CefRefPtr<CefDictionaryValue> State();
+  bool Control(const std::string& token, const std::string& action, const gfx::Size& size);
+  void OnWidgetDestroying(views::Widget*) override;
+  void DidFinishNavigation(content::NavigationHandle*) override;
+  void RenderFrameDeleted(content::RenderFrameHost*) override;
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override;
+  void WebContentsDestroyed() override;
+ private:
+  void Begin(content::RenderFrameHost* frame);
+  bool Bind(views::Widget* widget);
+  void Geometry(const gfx::Rect&, const gfx::Size&, const std::string&);
+  void End();
+  void Frame(uint32_t context, const gfx::Size& pixels, float scale);
+  void SchedulePublish();
+  void Publish();
+  void ClearWidget();
+  bool Live() const;
+  Changed changed_;
+  base::UnguessableToken registration_;
+  base::UnguessableToken token_;
+  content::WeakDocumentPtr document_;
+  base::WeakPtr<views::Widget> widget_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{this};
+  gfx::AcceleratedWidget accelerated_ = gfx::kNullAcceleratedWidget;
+  uint32_t context_ = 0;
+  gfx::Size pixels_;
+  float scale_ = 1;
+  gfx::Rect crop_;
+  gfx::Size natural_;
+  std::string surface_;
+  std::string reason_;
+  std::string owner_document_;
+  std::string retired_token_;
+  std::string retired_document_;
+  bool publish_pending_ = false;
+  base::WeakPtrFactory<CefExternalPiP> weak_{this};
+};
+#endif
