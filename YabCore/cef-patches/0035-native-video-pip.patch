+// Original native video-PiP owner/widget routing. UI sequence only.
+#ifndef CONTENT_PUBLIC_BROWSER_EXTERNAL_PIP_ROUTES_H_
+#define CONTENT_PUBLIC_BROWSER_EXTERNAL_PIP_ROUTES_H_
+#include <map>
+#include <string>
+#include <utility>
+#include "base/functional/callback.h"
+#include "base/no_destructor.h"
+#include "base/unguessable_token.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+namespace views { class Widget; }
+namespace content {
+class WebContents;
+class RenderFrameHost;
+namespace external_pip {
+struct Route {
+  base::UnguessableToken registration;
+  base::RepeatingCallback<void(RenderFrameHost*)> begin;
+  base::RepeatingCallback<bool(views::Widget*)> bind;
+  base::RepeatingCallback<void(const gfx::Rect&, const gfx::Size&, const std::string&)> geometry;
+  base::RepeatingClosure end;
+};
+inline std::map<WebContents*, Route>& Routes() {
+  static base::NoDestructor<std::map<WebContents*, Route>> routes;
+  return *routes;
+}
+inline void Register(WebContents* owner, Route route) { Routes().insert_or_assign(owner, std::move(route)); }
+inline void Remove(WebContents* owner, const base::UnguessableToken& registration) {
+  auto found = Routes().find(owner);
+  if (found != Routes().end() && found->second.registration == registration) Routes().erase(found);
+}
+inline void Begin(WebContents* owner, RenderFrameHost* frame) {
+  auto found = Routes().find(owner);
+  if (found != Routes().end()) found->second.begin.Run(frame);
+}
+inline bool Bind(WebContents* owner, views::Widget* widget) {
+  auto found = Routes().find(owner);
+  return found != Routes().end() && found->second.bind.Run(widget);
+}
+inline void Geometry(WebContents* owner, const gfx::Rect& crop, const gfx::Size& natural,
+                     const std::string& surface) {
+  auto found = Routes().find(owner);
+  if (found != Routes().end()) found->second.geometry.Run(crop, natural, surface);
+}
+inline void End(WebContents* owner) {
+  auto found = Routes().find(owner);
+  if (found != Routes().end()) found->second.end.Run();
+}
+}  // namespace external_pip
+}  // namespace content
+#endif
