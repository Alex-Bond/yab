+#pragma once
+#include <cstdint>
+#include <optional>
+#include "cc/trees/render_frame_metadata.h"
+#include "components/viz/common/surfaces/local_surface_id.h"
+#include "third_party/blink/public/common/widget/visual_properties.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace content {
+// Match an embedder request to the *sent* visual-properties LocalSurfaceId,
+// then to renderer activation. Receipt of renderer metadata is not activation.
+// A later window-compositor CA frame and retained fence are still required.
+class ExternalResizeTracker {
+ public:
+  bool Request(uint64_t serial, gfx::Size pixels,
+               const blink::VisualProperties* last_sent,
+               const cc::RenderFrameMetadata* last_activated) {
+    if (!serial || serial <= serial_ || pixels.IsEmpty()) return false;
+    serial_ = serial;
+    valid_ = true;
+    pixels_ = pixels;
+    expected_.reset();
+    activated_ = false;
+    // A true no-op resize can reuse the already active matching renderer.
+    // If an intermediate resize is in flight, last_sent differs and cannot
+    // seed this request from an older frame of the same dimensions.
+    if (last_sent) VisualPropertiesSent(*last_sent);
+    if (last_activated) RendererActivated(*last_activated);
+    return true;
+  }
+  void VisualPropertiesSent(const blink::VisualProperties& properties) {
+    if (!valid_ || properties.new_size_device_px != pixels_ ||
+        !properties.local_surface_id ||
+        !properties.local_surface_id->is_valid()) return;
+    expected_ = properties.local_surface_id;
+    activated_ = false;
+  }
+  bool RendererActivated(const cc::RenderFrameMetadata& metadata) {
+    activated_ = valid_ && expected_ && metadata.viewport_size_in_pixels == pixels_ &&
+        metadata.local_surface_id &&
+        metadata.local_surface_id->IsSameOrNewerThan(*expected_);
+    return activated_;
+  }
+  uint64_t ready_serial() const { return activated_ ? serial_ : 0; }
+  void Invalidate() {
+    expected_.reset();
+    activated_ = false;
+    valid_ = false;
+  }
+ private:
+  uint64_t serial_ = 0;
+  gfx::Size pixels_;
+  std::optional<viz::LocalSurfaceId> expected_;
+  bool activated_ = false, valid_ = false;
+};
+}  // namespace content
