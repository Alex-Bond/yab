+// Delegates <select> popups of an externally hosted WebContents to the CEF
+// client. One popup at a time; a new one cancels the previous. Hide on the
+// PopupMenuRunner pipe (navigation, element removal) withdraws it.
+class ExternalSelect : public content::WebContentsObserver,
+                       public remote_cocoa::mojom::PopupMenuRunner,
+                       public content::WebContentsUserData<ExternalSelect> {
+ public:
+  void Install() {
+    if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !web_contents()) return;
+    auto* view = web_contents()->GetRenderWidgetHostView();
+    if (!view || static_cast<content::RenderWidgetHostViewBase*>(view)
+                     ->IsRenderWidgetHostViewChildFrame()) return;
+    static_cast<content::RenderWidgetHostViewMac*>(view)->SetExternalSelectCallback(
+        base::BindRepeating(&ExternalSelect::Show, weak_factory_.GetWeakPtr()));
+  }
+  void Uninstall() {
+    Finish(std::nullopt, true);
+    if (!web_contents()) return;
+    if (auto* view = web_contents()->GetRenderWidgetHostView()) {
+      if (!static_cast<content::RenderWidgetHostViewBase*>(view)
+               ->IsRenderWidgetHostViewChildFrame())
+        static_cast<content::RenderWidgetHostViewMac*>(view)
+            ->SetExternalSelectCallback({});
+    }
+  }
+  bool Reply(int token, int index) {
+    if (!closed_ || token != token_) return false;
+    if (index < 0 || index >= count_) Finish(std::nullopt, false);
+    else Finish(static_cast<uint32_t>(index), false);
+    return true;
+  }
+  // PopupMenuRunner:
+  void Hide() override { Finish(std::nullopt, true); }
+  // WebContentsObserver:
+  void RenderViewReady() override { Install(); }
+  void RenderViewHostChanged(content::RenderViewHost*,
+                             content::RenderViewHost*) override {
+    Finish(std::nullopt, true);
+    Install();
+  }
+  void WebContentsDestroyed() override {
+    closed_.Reset();
+    receiver_.reset();
+    Observe(nullptr);
+  }
+
+ private:
+  friend class content::WebContentsUserData<ExternalSelect>;
+  explicit ExternalSelect(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<ExternalSelect>(*contents) {}
+
+  static const char* TypeName(blink::mojom::MenuItem::Type type) {
+    switch (type) {
+      case blink::mojom::MenuItem::Type::kCheckableOption: return "checkable";
+      case blink::mojom::MenuItem::Type::kGroup: return "group";
+      case blink::mojom::MenuItem::Type::kSeparator: return "separator";
+      case blink::mojom::MenuItem::Type::kSubMenu: return "submenu";
+      default: return "option";
+    }
+  }
+
+  void Show(remote_cocoa::mojom::PopupMenuPtr menu,
+            base::OnceCallback<void(std::optional<uint32_t>)> closed) {
+    Finish(std::nullopt, true);
+    auto browser = CefBrowserHostBase::GetBrowserForContents(web_contents());
+    auto client = browser ? browser->client() : nullptr;
+    auto handler = client ? client->GetDisplayHandler() : nullptr;
+    if (!handler) {
+      std::move(closed).Run(std::nullopt);
+      return;
+    }
+    token_ = ++sequence_;
+    count_ = static_cast<int>(menu->items.size());
+    closed_ = std::move(closed);
+    receiver_.reset();
+    receiver_.Bind(std::move(menu->receiver));
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &ExternalSelect::Hide, base::Unretained(this)));
+    auto value = CefDictionaryValue::Create();
+    value->SetInt("token", token_);
+    value->SetInt("x", menu->bounds.x());
+    value->SetInt("y", menu->bounds.y());
+    value->SetInt("width", menu->bounds.width());
+    value->SetInt("height", menu->bounds.height());
+    value->SetDouble("fontSize", menu->item_font_size);
+    value->SetBool("rightAligned", menu->right_aligned);
+    value->SetInt("selected", static_cast<int>(menu->selected_item));
+    auto items = CefListValue::Create();
+    items->SetSize(menu->items.size());
+    for (size_t i = 0; i < menu->items.size(); ++i) {
+      const auto& item = menu->items[i];
+      auto row = CefDictionaryValue::Create();
+      row->SetString("label", item->label.value_or(std::string()));
+      row->SetString("toolTip", item->tool_tip.value_or(std::string()));
+      row->SetString("type", TypeName(item->type));
+      row->SetBool("enabled", item->enabled);
+      row->SetBool("checked", item->checked);
+      items->SetDictionary(i, row);
+    }
+    value->SetList("items", items);
+    const int token = token_;
+    auto self = weak_factory_.GetWeakPtr();
+    // The client may reply synchronously or close the browser.
+    const bool presented = handler->OnExternalSelectMenu(browser.get(), value);
+    if (self && !presented && token_ == token) Finish(std::nullopt, false);
+  }
+
+  void Finish(std::optional<uint32_t> index, bool withdrawn) {
+    if (!closed_) return;
+    const int token = token_;
+    auto closed = std::move(closed_);
+    receiver_.reset();
+    if (withdrawn && web_contents()) {
+      auto browser = CefBrowserHostBase::GetBrowserForContents(web_contents());
+      auto client = browser ? browser->client() : nullptr;
+      if (auto handler = client ? client->GetDisplayHandler() : nullptr)
+        handler->OnExternalSelectMenuDismissed(browser.get(), token);
+    }
+    std::move(closed).Run(index);
+  }
+
+  base::OnceCallback<void(std::optional<uint32_t>)> closed_;
+  mojo::Receiver<remote_cocoa::mojom::PopupMenuRunner> receiver_{this};
+  int token_ = 0, sequence_ = 0, count_ = 0;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+  base::WeakPtrFactory<ExternalSelect> weak_factory_{this};
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ExternalSelect);
+}  // namespace
