+bool CefWindowImpl::ReplyExternalSelect(CefRefPtr<CefBrowserView> browser_view,
+                                        int token,
+                                        int index) {
+  CEF_REQUIRE_VALID_RETURN(false);
+#if BUILDFLAG(IS_MAC)
+  if (!widget_ || !browser_view) return false;
+  auto* view_impl = static_cast<CefBrowserViewImpl*>(browser_view.get());
+  if (view_impl->cef_window_impl() != this) return false;
+  return cef::external_host::ReplySelect(browser_view, token, index);
+#else
+  return false;
+#endif
+}
