+bool ReplySelect(CefRefPtr<CefBrowserView> browser_view, int token, int index) {
+  auto browser = CefBrowserHostBase::FromBrowser(browser_view->GetBrowser());
+  auto* contents = browser ? browser->GetWebContents() : nullptr;
+  auto* select = contents ? ExternalSelect::FromWebContents(contents) : nullptr;
+  return select && select->Reply(token, index);
+}
 
