+CefRefPtr<CefRequestContext> CefRequestContextImpl::CreateOffTheRecordContext(
+    CefRefPtr<CefRequestContextHandler> handler) {
+  CEF_REQUIRE_UIT_RETURN(nullptr);
+  auto* parent_context = browser_context();
+  if (!parent_context || !parent_context->IsInitialized()) {
+    return nullptr;
+  }
+  Profile* parent = parent_context->AsProfile();
+  if (!parent || parent->IsOffTheRecord()) {
+    return nullptr;
+  }
+  Config config;
+  config.handler = handler;
+  config.unique_id = g_next_id.GetNext();
+  config.off_the_record_parent = parent;
+  // On the UI thread this initializes at once, while |parent| is alive.
+  return GetOrCreateRequestContext(std::move(config));
+}
