+namespace {
+// A Chrome-created page is bound before OnAfterCreated. Its native Browser
+// must own exactly this one page; no view-tree search or borrowed geometry.
+class ExternalPage : public content::WebContentsObserver,
+                     public views::WidgetObserver,
+                     public content::WebContentsUserData<ExternalPage> {
+ public:
+  bool Bind(CefBrowserHostBase* browser, views::Widget* widget) {
+    if (!browser || !widget || widget_ || !Enable(widget)) return false;
+    widget_ = widget->GetWeakPtr();
+    observation_.Observe(widget);
+    visible_ = true;
+    ExternalVisibility::GetOrCreateForWebContents(web_contents())->Bind(widget);
+    ExternalSelect::GetOrCreateForWebContents(web_contents())->Install();
+    auto* compositor = widget->GetCompositor();
+    if (!compositor) { Reset(); return false; }
+    accelerated_ = compositor->widget();
+    if (!ui::AcceleratedWidgetMac::SetFrameCallback(accelerated_,
+          base::BindRepeating(&ExternalPage::Frame, weak_.GetWeakPtr()))) {
+      Reset(); return false;
+    }
+    return true;
+  }
+  bool Owns() const {
+    if (!widget_ || !web_contents() || web_contents()->IsBeingDestroyed()) return false;
+    auto browser = CefBrowserHostBase::GetBrowserForContents(web_contents());
+    if (!browser || !browser->IsChromeStyle()) return false;
+    auto chrome = ChromeBrowserHostImpl::FromBaseChecked(browser);
+    auto* native_browser = chrome->browser();
+    auto* view = native_browser ? BrowserView::GetBrowserViewForBrowser(native_browser) : nullptr;
+    if (!view || view->GetWidget() != widget_.get()) return false;
+    auto* tabs = native_browser->tab_strip_model();
+    return tabs->empty() || (tabs->count() == 1 &&
+                             tabs->GetActiveWebContents() == web_contents());
+  }
+  CefRefPtr<CefDictionaryValue> State() const {
+    auto result = CefDictionaryValue::Create();
+    if (!Owns()) return result;
+    auto browser = CefBrowserHostBase::GetBrowserForContents(web_contents());
+    result->SetBool("bound", true);
+    result->SetString("token", token_.ToString());
+    result->SetInt("browserId", browser->GetIdentifier());
+    result->SetBool("visible", visible_);
+    if (auto* model = extensions::ExternalTabModel::Get(web_contents())) {
+      result->SetBool("nativeTabModel", true);
+      result->SetBool("active", model->active());
+      result->SetInt("index", model->index());
+      result->SetInt("logicalWindowId", model->window());
+      auto opener = model->opener()
+          ? CefBrowserHostBase::GetBrowserForContents(model->opener()) : nullptr;
+      result->SetInt("openerBrowserId", opener ? opener->GetIdentifier() : 0);
+    }
+    result->SetDouble("contextId", static_cast<double>(context_));
+    result->SetInt("pixelWidth", pixels_.width());
+    result->SetInt("pixelHeight", pixels_.height());
+    result->SetDouble("scale", scale_);
+    NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+    result->SetInt("windowNumber", window ? static_cast<int>(window.windowNumber) : 0);
+    auto* renderer = web_contents()->GetRenderWidgetHostView();
+    if (renderer && !static_cast<content::RenderWidgetHostViewBase*>(renderer)
+                         ->IsRenderWidgetHostViewChildFrame()) {
+      NSView* page = renderer->GetNativeView().GetNativeNSView();
+      // Native frame identity is supplied by WebContents, never a recursive
+      // first matching RenderWidgetHostViewCocoa or a rectangle heuristic.
+      if (page && page.window == window) {
+        NSRect rectangle = [page convertRect:page.bounds toView:window.contentView];
+        result->SetDouble("pageX", NSMinX(rectangle));
+        result->SetDouble("pageY", NSHeight(window.contentView.bounds) - NSMaxY(rectangle));
+        result->SetDouble("pageWidth", NSWidth(rectangle));
+        result->SetDouble("pageHeight", NSHeight(rectangle));
+        result->SetBool("rendererBound", true);
+      }
+    }
+    return result;
+  }
+  bool Resize(const gfx::Size& size) {
+    if (!Owns() || size.IsEmpty() || size.width() > 8192 || size.height() > 8192)
+      return false;
+    if (requested_ == size) return true;
+    requested_ = size;
+    applied_ = false;
+    ApplySize();
+    return true;
+  }
+  bool SetVisible(bool visible) {
+    if (!Owns()) return false;
+    visible_ = visible;
+    auto self = weak_.GetWeakPtr();
+    if (!visible) ExternalFocus::GetOrCreateForWebContents(web_contents())->Set(widget_.get(), false);
+    if (!self || !Owns()) return false;
+    if (visible) widget_->Show(); else widget_->Hide();
+    return true;
+  }
+  bool Focus(bool focused) {
+    if (!Owns() || (focused && !visible_)) return false;
+    auto contents = web_contents()->GetWeakPtr();
+    if (!ExternalFocus::GetOrCreateForWebContents(web_contents())->Set(widget_.get(), focused))
+      return false;
+    if (focused && contents) {
+      if (auto* model = extensions::ExternalTabModel::Get(contents.get())) model->Activate();
+    }
+    return !!contents;
+  }
+  void RenderViewReady() override { ScheduleSize(); }
+  void RenderViewHostChanged(content::RenderViewHost*, content::RenderViewHost*) override {
+    // A renderer replacement needs the same target applied to the new view.
+    applied_ = false;
+    ScheduleSize();
+  }
+  void OnWidgetDestroying(views::Widget*) override { Reset(); }
+  void WebContentsDestroyed() override { Reset(); Observe(nullptr); }
+ private:
+  friend class content::WebContentsUserData<ExternalPage>;
+  explicit ExternalPage(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<ExternalPage>(*contents),
+        token_(base::UnguessableToken::Create()) {}
+  ~ExternalPage() override { Reset(); }
+  void Reset() {
+    weak_.InvalidateWeakPtrs();
+    if (accelerated_ != gfx::kNullAcceleratedWidget)
+      ui::AcceleratedWidgetMac::SetFrameCallback(accelerated_, {});
+    accelerated_ = gfx::kNullAcceleratedWidget;
+    observation_.Reset();
+    widget_.reset();
+  }
+  void ScheduleSize() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ExternalPage::ApplySize, weak_.GetWeakPtr()));
+  }
+  void ApplySize() {
+    if (applied_ || requested_.IsEmpty() || !Owns()) return;
+    auto* renderer = web_contents()->GetRenderWidgetHostView();
+    if (!renderer || static_cast<content::RenderWidgetHostViewBase*>(renderer)
+                         ->IsRenderWidgetHostViewChildFrame()) return;
+    NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+    NSView* page = renderer->GetNativeView().GetNativeNSView();
+    if (!page || page.window != window || NSWidth(page.bounds) <= 0 || NSHeight(page.bounds) <= 0)
+      return;
+    gfx::Rect bounds = widget_->GetWindowBoundsInScreen();
+    const int width = bounds.width() + requested_.width() - std::lround(NSWidth(page.bounds));
+    const int height = bounds.height() + requested_.height() - std::lround(NSHeight(page.bounds));
+    const double scale = window.backingScaleFactor;
+    if (width <= 0 || height <= 0 || scale <= 0 ||
+        width * scale > 16384 || height * scale > 16384) return;
+    // Mark BEFORE dispatch, including no-op sizes. Layout can be asynchronous;
+    // repeating outer-minus-page deltas before it settles grows the window.
+    applied_ = true;
+    bounds.set_size(gfx::Size(width, height));
+    widget_->SetBounds(bounds);
+  }
+  void Frame(uint32_t context, const gfx::Size& pixels, float scale) {
+    if (!Owns()) return;
+    context_ = context; pixels_ = pixels; scale_ = scale;
+    auto self = weak_.GetWeakPtr();
+    ApplySize();
+    if (!self) return;
+    CefRefPtr<CefBrowserHostBase> browser;
+    if (auto handler = DisplayHandlerFor(web_contents(), &browser))
+      handler->OnExternalPageFrame(browser.get(), State());
+  }
+  base::WeakPtr<views::Widget> widget_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{this};
+  gfx::AcceleratedWidget accelerated_ = gfx::kNullAcceleratedWidget;
+  uint32_t context_ = 0;
+  gfx::Size pixels_, requested_;
+  float scale_ = 1;
+  bool visible_ = true, applied_ = false;
+  const base::UnguessableToken token_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+  base::WeakPtrFactory<ExternalPage> weak_{this};
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ExternalPage);
+}  // namespace
+
+bool BindDefaultPage(CefBrowserHostBase* browser) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !browser || !browser->IsChromeStyle() ||
+      browser->platform_delegate()->IsViewsHosted() ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch("yab-external-default-windows"))
+    return false;
+  auto chrome = ChromeBrowserHostImpl::FromBaseChecked(browser);
+  auto* native_browser = chrome->browser();
+  auto* view = native_browser ? BrowserView::GetBrowserViewForBrowser(native_browser) : nullptr;
+  if (!view || !view->GetWidget() || !browser->GetWebContents()) return false;
+  auto* tabs = native_browser->tab_strip_model();
+  if (!tabs->empty() && (tabs->count() != 1 || tabs->GetActiveWebContents() != browser->GetWebContents()))
+    return false;
+  if (!ExternalPage::GetOrCreateForWebContents(browser->GetWebContents())->Bind(browser, view->GetWidget()))
+    return false;
+  if (auto* creation = extensions::ScopedExternalTabCreation::Current(); creation && creation->owner()) {
+    if (!BindNativeTabModel(browser->GetWebContents(), creation->owner(),
+                            creation->opener(), creation->active(), creation->index()))
+      return false;
+  }
+  return true;
+}
+CefRefPtr<CefDictionaryValue> PageState(CefBrowserHostBase* browser) {
+  auto* page = browser && browser->GetWebContents()
+      ? ExternalPage::FromWebContents(browser->GetWebContents()) : nullptr;
+  return page ? page->State() : CefDictionaryValue::Create();
+}
+bool ResizePage(CefBrowserHostBase* browser, const CefSize& size) {
+  auto* page = browser && browser->GetWebContents()
+      ? ExternalPage::FromWebContents(browser->GetWebContents()) : nullptr;
+  return page && page->Resize(gfx::Size(size.width, size.height));
+}
+bool ShowPage(CefBrowserHostBase* browser, bool visible) {
+  auto* page = browser && browser->GetWebContents()
+      ? ExternalPage::FromWebContents(browser->GetWebContents()) : nullptr;
+  return page && page->SetVisible(visible);
+}
+bool FocusPage(CefBrowserHostBase* browser, bool focused) {
+  auto* page = browser && browser->GetWebContents()
+      ? ExternalPage::FromWebContents(browser->GetWebContents()) : nullptr;
+  return page && page->Focus(focused);
+}
+bool SelectPage(CefBrowserHostBase* browser, int token, int index) {
+  auto* contents = browser ? browser->GetWebContents() : nullptr;
+  auto* page = contents ? ExternalPage::FromWebContents(contents) : nullptr;
+  auto* select = contents ? ExternalSelect::FromWebContents(contents) : nullptr;
+  return page && page->Owns() && select && select->Reply(token, index);
+}
 
