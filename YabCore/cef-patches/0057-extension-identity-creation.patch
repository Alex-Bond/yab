+#if BUILDFLAG(ENABLE_EXTENSIONS)
+void WebAuthFlow::SetExternalExtensionOwner(
+    const std::string& extension_id, content::WebContents* sender) {
+  // A real action popup has an original native owner. Do not retain the
+  // popup itself: showing the provider will dismiss that popup. Workers
+  // have no sender document; capture this profile's native focused owner
+  // once, before loading the provider, and never retarget a pending flow.
+  auto* owner = sender;
+  if (auto* action = sender ? ExternalActionOrigin::Get(sender) : nullptr) {
+    if (action->extension_id() != extension_id) return;
+    owner = action->Owner(sender);
+  } else if (!sender) {
+    owner = ExternalTabFocus::Get(profile_);
+  }
+  auto* model = owner ? ExternalTabModel::Get(owner) : nullptr;
+  if (!owner || owner->GetBrowserContext() != profile_ || !model ||
+      !model->embedded() || !ExternalTabWindow::Bound(owner)) return;
+  external_owner_ = owner->GetWeakPtr();
+  external_extension_id_ = extension_id;
+}
+#endif
