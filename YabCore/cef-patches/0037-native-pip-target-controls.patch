+void VideoPictureInPictureWindowControllerImpl::RequestExternalPlayerControls(
+    base::OnceCallback<void(media::mojom::MediaPlayerControlStatePtr)> callback) {
+  if (!active_session_ || !active_session_->player_id().has_value() ||
+      !active_session_->GetMediaPlayerRemote().is_bound()) {
+    std::move(callback).Run(nullptr); return;
+  }
+  active_session_->GetMediaPlayerRemote()->RequestNativeControlState(std::move(callback));
+}
+bool VideoPictureInPictureWindowControllerImpl::ControlExternalPlayer(const std::string& action, double value) {
+  if (!active_session_ || !active_session_->player_id().has_value() || !std::isfinite(value)) return false;
+  auto& player = active_session_->GetMediaPlayerRemote();
+  if (!player.is_bound()) return false;
+  if (action == "play") player->RequestPlay(false);
+  else if (action == "pause") player->RequestPause(false);
+  else if (action == "seek" && value >= 0) player->RequestSeekTo(base::Seconds(value));
+  else if (action == "seekForward" && value > 0 && value <= 86400) player->RequestSeekForward(base::Seconds(value));
+  else if (action == "seekBackward" && value > 0 && value <= 86400) player->RequestSeekBackward(base::Seconds(value));
+  else if (action == "rate" && value >= .25 && value <= 8) player->RequestNativePlaybackRate(value);
+  else if (action == "mute" && (value == 0 || value == 1)) player->RequestMute(value == 1);
+  else if (action == "captions" && (value == 0 || value == 1)) player->RequestNativeCaptions(value == 1);
+  else return false;
+  return true;
+}
