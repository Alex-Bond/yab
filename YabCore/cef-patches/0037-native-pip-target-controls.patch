+void HTMLMediaElement::RequestNativeControlState(RequestNativeControlStateCallback callback) {
+  auto state = media::mojom::blink::MediaPlayerControlState::New();
+  const double position = currentTime();
+  const double length = duration();
+  const double rate = playbackRate();
+  state->known = web_media_player_ && std::isfinite(position) && std::isfinite(rate);
+  state->has_duration = std::isfinite(length) && length >= 0;
+  state->duration = state->has_duration ? length : 0;
+  state->position = std::isfinite(position) ? position : 0;
+  state->rate = std::isfinite(rate) ? rate : 0;
+  state->paused = paused(); state->muted = muted();
+  state->can_seek = state->has_duration && seekable()->length() > 0;
+  state->can_rate = web_media_player_ && GetLoadType() != WebMediaPlayer::kLoadTypeMediaStream;
+  auto* tracks = textTracks();
+  for (unsigned i = 0; i < tracks->length(); ++i) {
+    auto* track = tracks->AnonymousIndexedGetter(i);
+    if (!track || !track->CanBeRendered()) continue;
+    state->captions_available = true;
+    state->captions_enabled |= track->mode() == TextTrackMode::kShowing;
+  }
+  std::move(callback).Run(std::move(state));
+}
+void HTMLMediaElement::RequestNativePlaybackRate(double rate) {
+  if (!std::isfinite(rate) || rate < .25 || rate > 8 ||
+      !web_media_player_ || GetLoadType() == WebMediaPlayer::kLoadTypeMediaStream) return;
+  setPlaybackRate(rate);
+}
+void HTMLMediaElement::RequestNativeCaptions(bool enabled) {
+  auto* tracks = textTracks();
+  bool selected = false;
+  for (unsigned i = 0; i < tracks->length(); ++i) {
+    auto* track = tracks->AnonymousIndexedGetter(i);
+    if (!track || !track->CanBeRendered()) continue;
+    const bool show = enabled && !selected;
+    track->setMode(V8TextTrackMode(show ? TextTrackMode::kShowing : TextTrackMode::kDisabled));
+    selected |= show;
+  }
+}
