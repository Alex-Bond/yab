+class ActionOwner : public content::WebContentsObserver,
+                    public content::WebContentsUserData<ActionOwner> {
+ public:
+  void Bind(views::Widget* popup) {
+    Close();
+    popup_ = popup->GetWeakPtr();
+  }
+  void PrimaryPageChanged(content::Page&) override { Close(); }
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (visibility == content::Visibility::HIDDEN) Close();
+  }
+  void WebContentsDestroyed() override { Close(); }
+ private:
+  friend class content::WebContentsUserData<ActionOwner>;
+  explicit ActionOwner(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<ActionOwner>(*contents) {}
+  void Close() {
+    auto popup = std::move(popup_);
+    popup_.reset();
+    if (popup) popup->Close();
+  }
+  base::WeakPtr<views::Widget> popup_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
