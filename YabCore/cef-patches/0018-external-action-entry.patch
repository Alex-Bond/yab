+bool OpenAction(CefBrowserHostBase* cef_browser, const std::string& id,
+                const CefRect& anchor) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !cef_browser) return false;
+  for (auto it = Popups().begin(); it != Popups().end();) {
+    if (!it->second) it = Popups().erase(it); else ++it;
+  }
+  if (Popups().size() >= 16) return false;
+  auto* owner = cef_browser->GetWebContents();
+  auto* focus = owner ? ExternalFocus::FromWebContents(owner) : nullptr;
+  if (!focus || !focus->focused() ||
+      owner->GetVisibility() != content::Visibility::VISIBLE) return false;
+  auto* browser = GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(owner);
+  auto* browser_view = browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!browser_view || browser->GetTabStripModel()->GetActiveWebContents() != owner)
+    return false;
+  auto* context = owner->GetBrowserContext();
+  scoped_refptr<const extensions::Extension> extension =
+      extensions::ExtensionRegistry::Get(context)->enabled_extensions().GetByID(id);
+  if (!extension || (context->IsOffTheRecord() &&
+      !extensions::util::IsIncognitoEnabled(id, context))) return false;
+  auto* action = extensions::ExtensionActionManager::Get(context)
+      ->GetExtensionAction(*extension);
+  const int tab = sessions::SessionTabHelper::IdForTab(owner).id();
+  auto* runner = extensions::ExtensionActionRunner::GetForWebContents(owner);
+  if (!action || !runner || !action->GetIsVisible(tab) || !action->HasPopup(tab))
+    return false;
+  // Same native permissions and action dispatch as a Chrome toolbar press.
+  auto owner_weak = owner->GetWeakPtr();
+  const GURL popup_url = action->GetPopupUrl(tab);
+  if (runner->RunAction(extension.get(), /*grant_tab_permissions=*/true) !=
+      extensions::ExtensionAction::ShowAction::kShowPopup || !owner_weak)
+    return false;
+  // Native permission handling can call client code. Revalidate its owner and
+  // enabled package before constructing any view after that dispatch.
+  if (extensions::ExtensionRegistry::Get(context)->enabled_extensions().GetByID(id)
+      != extension.get() || GlobalBrowserCollection::GetInstance()
+          ->FindBrowserWithTab(owner_weak.get()) != browser) return false;
+  auto host = extensions::ExtensionViewHostFactory::CreatePopupHost(
+      *extension, popup_url, browser);
+  if (!host || !extensions::ExternalActionOrigin::Attach(
+          host->host_contents(), owner, id, /*external=*/true)) return false;
+  auto popup = host->host_contents()->GetWeakPtr();
+  ExtensionPopup::ShowPopup(browser, std::move(host),
+      views::BubbleAnchor(browser_view), views::BubbleBorder::TOP_RIGHT,
+      PopupShowAction::kShow,
+      base::BindOnce([](base::WeakPtr<content::WebContents> contents,
+                        CefRect anchor, extensions::ExtensionHost*) {
+        auto* state = contents ? ExternalPopup::FromWebContents(contents.get()) : nullptr;
+        if (state && state->widget && anchor.width > 0 && anchor.height > 0) {
+          gfx::Rect bounds = state->widget->GetWindowBoundsInScreen();
+          bounds.set_origin(gfx::Point(anchor.x, anchor.y + anchor.height));
+          state->widget->SetBounds(bounds);
+        }
+      }, popup, anchor));
+  return true;
+}
+
+bool ControlPopup(CefBrowserHostBase* browser, const std::string& token,
+                  const CefRect& anchor, bool focused, bool close) {
+  auto found = Popups().find(token);
+  auto* popup = found == Popups().end() ? nullptr : found->second.get();
+  auto* origin = popup ? extensions::ExternalActionOrigin::Get(popup) : nullptr;
+  auto* state = popup ? ExternalPopup::FromWebContents(popup) : nullptr;
+  auto* owner = browser ? browser->GetWebContents() : nullptr;
+  if (!owner || !origin || origin->Owner(popup) != owner || !state ||
+      !state->widget) return false;
+  if (close) { state->widget->Close(); return true; }
+  auto* owner_focus = ExternalFocus::FromWebContents(owner);
+  if (origin->external() && (!owner_focus || !owner_focus->focused() ||
+      owner->GetVisibility() != content::Visibility::VISIBLE)) return false;
+  auto popup_weak = popup->GetWeakPtr();
+  auto widget = state->widget;
+  const bool external = origin->external();
+  if (anchor.width > 0 && anchor.height > 0) {
+    gfx::Rect bounds = widget->GetWindowBoundsInScreen();
+    bounds.set_origin(gfx::Point(anchor.x, anchor.y + anchor.height));
+    widget->SetBounds(bounds);
+  }
+  // Bounds changes can invoke embedder code and close the widget.
+  if (!popup_weak || !widget) return false;
+  return !external ||
+      ExternalFocus::GetOrCreateForWebContents(popup_weak.get())->Set(widget.get(), focused);
 }
 
