--- a/chrome/browser/printing/print_view_manager.cc
+++ b/chrome/browser/printing/print_view_manager.cc
@@ -647,9 +647,22 @@
   // (PrintRenderFrameHelper::PrintWithParams). Left to Chrome's preview, the
   // tab is dimmed for a dialog this embedding never shows.
   if (auto hook = extensions::GetExternalExtensionHooks().print_request) {
-    // Nothing to resume: this request has no suspended script.
+    // Nothing to resume: this request has no suspended script. A node's
