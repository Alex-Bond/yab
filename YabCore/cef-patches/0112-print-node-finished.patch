+      PrintPreviewForWebNode(render_frame_host);
+      done = base::BindOnce(
+          [](base::ScopedClosureRunner) {},
+          base::ScopedClosureRunner(base::BindOnce(
+              &PrintViewManager::PrintPreviewDone, weak_factory_.GetWeakPtr())));
+    }
     if (hook(web_contents(), render_frame_host, /*scripted=*/false,
-             base::DoNothing())) {
+             std::move(done))) {
       PrintPreviewAllowedForTesting();
       return;
     }
