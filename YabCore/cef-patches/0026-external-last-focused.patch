+// The embedder delegates focus without activating a concealed Chrome window.
+// Remember that authoritative native event per BrowserContext. A worker has
+// no popup controller, so physical window activation order is not its owner.
+class ExternalTabFocus : public base::SupportsUserData::Data {
+ public:
+  static void Remember(content::WebContents* contents) {
+    if (!contents || contents->IsBeingDestroyed()) return;
+    auto* context = contents->GetBrowserContext();
+    auto* state = static_cast<ExternalTabFocus*>(context->GetUserData(&kKey));
+    if (!state) {
+      auto created = std::make_unique<ExternalTabFocus>();
+      state = created.get();
+      context->SetUserData(&kKey, std::move(created));
+    }
+    state->contents_ = contents->GetWeakPtr();
+  }
+  static content::WebContents* Get(content::BrowserContext* context) {
+    auto* state = context
+        ? static_cast<ExternalTabFocus*>(context->GetUserData(&kKey)) : nullptr;
+    auto* contents = state ? state->contents_.get() : nullptr;
+    return contents && !contents->IsBeingDestroyed() &&
+                   contents->GetBrowserContext() == context
+        ? contents : nullptr;
+  }
+ private:
+  inline static const int kKey = 0;
+  base::WeakPtr<content::WebContents> contents_;
 };
