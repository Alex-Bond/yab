+// Yab: |candidate| is |profile|, or with |include_incognito| any
+// off-the-record profile of it. Chrome has one, the primary; Yab's private
+// windows are each their own unique off-the-record profile of a space's
+// profile (CEF 0092), and a spanning extension allowed in private tabs must
+// find their windows and tabs as Chrome's finds its incognito ones.
+bool IsProfileOrPrivateSide(const Profile* candidate, const Profile* profile,
+                            bool include_incognito) {
+  if (!candidate || !profile) return false;
+  if (candidate == profile) return true;
+  return include_incognito && candidate->IsOffTheRecord() &&
+         !profile->IsOffTheRecord() &&
+         candidate->GetOriginalProfile() == profile;
+}
