+// UI-sequence-only provenance for Chrome's original chooser listener.
+#ifndef CHROME_BROWSER_EXTERNAL_FILE_ORIGIN_H_
+#define CHROME_BROWSER_EXTERNAL_FILE_ORIGIN_H_
+#include <map>
+#include <vector>
+#include "base/no_destructor.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+namespace external_file_origin {
+using Listener = ui::SelectFileDialog::Listener;
+struct Source {
+  content::WeakDocumentPtr document;
+  std::vector<std::u16string> accepts;
+};
+inline auto& Origins() {
+  static base::NoDestructor<std::map<Listener*, Source>> origins;
+  return *origins;
+}
+inline thread_local unsigned suppressed = 0;
+class ScopedEmbedderChooser {
+ public:
+  ScopedEmbedderChooser() { ++suppressed; }
+  ~ScopedEmbedderChooser() { --suppressed; }
+};
+inline void Set(Listener* listener, content::RenderFrameHost* frame,
+                const std::vector<std::u16string>& accepts) {
+  if (frame && !suppressed) Origins().insert_or_assign(listener, Source{frame->GetWeakDocumentPtr(), accepts});
+}
+inline bool Has(Listener* listener) { return Origins().contains(listener); }
+inline void Remove(Listener* listener) { Origins().erase(listener); }
+inline content::RenderFrameHost* Get(Listener* listener) {
+  const auto it = Origins().find(listener);
+  return it == Origins().end() ? nullptr : it->second.document.AsRenderFrameHostIfValid();
+}
+}  // namespace external_file_origin
