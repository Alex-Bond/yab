+Pending& Requests() { static base::NoDestructor<Pending> requests; return *requests; }
+class Callback final : public CefFileDialogCallback,
+                       public content::WebContentsObserver {
+ public:
+  Callback(Listener* listener, content::RenderFrameHost* frame,
+           CefRefPtr<CefDialogHandler> handler, cef_file_dialog_mode_t mode)
+      : content::WebContentsObserver(content::WebContents::FromRenderFrameHost(frame)),
+        listener_(listener), document_(frame->GetWeakDocumentPtr()),
+        handler_(handler), mode_(mode), request_(base::UnguessableToken::Create().ToString()) {
+    auto* native = static_cast<content::RenderFrameHostImpl*>(frame);
+    receipt_ = CefDictionaryValue::Create();
+    receipt_->SetString("request", request_);
+    receipt_->SetString("document", native->GetDocumentToken().ToString());
+    receipt_->SetString("frameId", frame->GetDevToolsFrameToken().ToString());
+    const auto loader = native->GetDevToolsNavigationToken();
+    if (loader) receipt_->SetString("loaderId", loader->ToString());
+    receipt_->SetInt("processId", frame->GetGlobalId().child_id.value());
+    receipt_->SetInt("routingId", frame->GetGlobalId().frame_routing_id);
+    receipt_->SetBool("main", frame == web_contents()->GetPrimaryMainFrame());
+    receipt_->SetString("url", frame->GetLastCommittedURL().spec());
+    receipt_->SetString("origin", frame->GetLastCommittedOrigin().Serialize());
+    receipt_->SetInt("mode", mode_);
+    receipt_->SetBool("acceptedNativeChooser", true);
+  }
+  CefRefPtr<CefDictionaryValue> receipt() const { return receipt_->Copy(false); }
+  void MarkHandled() { handled_ = true; }
+  bool done() const { return done_; }
+  bool Live() const {
+    auto* frame = document_.AsRenderFrameHostIfValid();
+    if (done_ || !listener_ || !web_contents() || web_contents()->IsBeingDestroyed() ||
+        !frame || !frame->IsActive() || !frame->IsRenderFrameLive() ||
+        content::WebContents::FromRenderFrameHost(frame) != web_contents()) return false;
+    auto* tab = tabs::TabInterface::MaybeGetFromContents(web_contents());
+    return !tab || tab->IsActivated();
+  }
+  void Watch() {
+    if (done_) return;
+    if (!Live()) { Finish({}, true, "native-owner-retired"); return; }
+    // Covers same-RFH replacement and subframe/OOPIF renderer loss even when
+    // the primary renderer remains alive. No frame pointer survives a commit.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(FROM_HERE,
+        base::BindOnce(&Callback::Watch, CefRefPtr<Callback>(this)), base::Milliseconds(50));
+  }
+  void Continue(const std::vector<CefString>& paths) override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&Callback::Continue, CefRefPtr<Callback>(this), paths)); return;
+    }
+    if (!Live()) { Finish({}, true, "stale-native-document"); return; }
+    if (paths.size() > (mode_ == FILE_DIALOG_OPEN_MULTIPLE ? 1024u : 1u)) {
+      Finish({}, true, "invalid-file-count"); return;
+    }
+    std::vector<ui::SelectedFileInfo> selected;
+    for (const auto& value : paths) {
+      const std::string path = value.ToString();
+      if (path.find('\0') != std::string::npos || !base::FilePath(path).IsAbsolute()) {
+        Finish({}, true, "invalid-file-path"); return;
+      }
+      selected.emplace_back(base::FilePath(path));
+    }
+    Finish(selected, true, selected.empty() ? "cancelled" : "selected");
+  }
+  void Cancel() override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&Callback::Cancel, CefRefPtr<Callback>(this))); return;
+    }
+    Finish({}, true, "cancelled");
+  }
+  void DestroyListener() { Finish({}, false, "native-listener-retired"); }
+  void Disconnect() { handled_ = false; Finish({}, false, "fallback"); }
+  void RenderFrameDeleted(content::RenderFrameHost*) override {
+    if (!document_.AsRenderFrameHostIfValid()) Finish({}, true, "frame-removed");
+  }
+  void DidFinishNavigation(content::NavigationHandle*) override {
+    if (!document_.AsRenderFrameHostIfValid()) Finish({}, true, "document-replaced");
+  }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    Finish({}, true, "renderer-gone");
+  }
+  void WebContentsDestroyed() override { Finish({}, true, "browser-closed"); }
+ private:
+  void Finish(const std::vector<ui::SelectedFileInfo>& files, bool notify, const char* reason) {
+    if (done_) return;
+    CefRefPtr<Callback> keep(this);
+    done_ = true;
+    Listener* listener = std::exchange(listener_, nullptr);
+    auto it = Requests().find(listener);
+    if (it != Requests().end() && it->second.get() == this) Requests().erase(it);
+    // Remove exact identity before original listener or embedder reenters.
+    // A later chooser reusing its address has a different callback and token.
+    auto browser = web_contents() ? CefBrowserHostBase::GetBrowserForContents(web_contents()) : nullptr;
+    Observe(nullptr);
+    if (notify && listener) {
+      if (files.empty()) listener->FileSelectionCanceled();
+      else if (files.size() == 1) listener->FileSelected(files[0], 0);
+      else listener->MultiFilesSelected(files);
+    }
+    if (handled_ && browser && CEF_API_IS_ADDED(CEF_EXPERIMENTAL))
+      handler_->OnFileDialogClosed(browser, request_, reason);
+  }
+  Listener* listener_;  // Used only while the original dialog owns it.
+  content::WeakDocumentPtr document_;
+  CefRefPtr<CefDialogHandler> handler_;
+  cef_file_dialog_mode_t mode_;
+  std::string request_;
+  CefRefPtr<CefDictionaryValue> receipt_;
+  bool done_ = false, handled_ = false;
+  IMPLEMENT_REFCOUNTING(Callback);
+};
+}  // namespace
+bool Run(CefRefPtr<CefBrowserHostBase> browser, Listener* listener,
+         ui::SelectFileDialog::Type type, const std::u16string& title,
+         const base::FilePath& path, const ui::SelectFileDialog::FileTypeInfo* types) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !browser || !listener) return false;
+  if (!external_file_origin::Has(listener)) return false;
+  auto* frame = external_file_origin::Get(listener);
+  if (!frame || !frame->IsActive() || !frame->IsRenderFrameLive()) {
+    listener->FileSelectionCanceled(); return true;
+  }
+  if ( content::WebContents::FromRenderFrameHost(frame) != browser->GetWebContents()) return false;
+  auto handler = browser->client() ? browser->client()->GetDialogHandler() : nullptr;
+  auto cef_frame = browser->GetFrameForHost(frame);
+  if (!handler || !cef_frame || !cef_frame->IsValid()) return false;
+  cef_file_dialog_mode_t mode;
+  switch (type) {
+    case ui::SelectFileDialog::SELECT_OPEN_FILE: mode = FILE_DIALOG_OPEN; break;
+    case ui::SelectFileDialog::SELECT_OPEN_MULTI_FILE: mode = FILE_DIALOG_OPEN_MULTIPLE; break;
+    case ui::SelectFileDialog::SELECT_UPLOAD_FOLDER: mode = FILE_DIALOG_OPEN_FOLDER; break;
+    default: return false;
+  }
+  // No pending request is inferred from renderer Page.fileChooserOpened.
+  // This entry is called only by SelectFileImpl after Chrome's policy passed.
+  if (Requests().contains(listener)) return false;
+  CefRefPtr<Callback> callback = new Callback(listener, frame, handler, mode);
+  Requests().emplace(listener, callback);
+  auto receipt = callback->receipt();
+  receipt->SetInt("browserId", browser->GetIdentifier());
+  auto accepts = CefListValue::Create();
+  if (types) for (size_t i=0; i<types->extensions.size(); ++i) {
+    auto extensions = CefListValue::Create();
+    for (const auto& ext : types->extensions[i]) extensions->SetString(extensions->GetSize(), ext);
+    accepts->SetList(accepts->GetSize(), extensions);
+  }
+  receipt->SetList("acceptExtensions", accepts);
+  auto filters = CefListValue::Create();
+  for (const auto& mime : external_file_origin::Origins().at(listener).accepts)
+    filters->SetString(filters->GetSize(), mime);
+  receipt->SetList("acceptFilters", filters);
+  callback->MarkHandled();
+  const bool handled = handler->OnFileDialogForFrame(browser, cef_frame, receipt, title,
+                                                     path.value(), callback);
+  if (!handled && !callback->done()) {
+    if (!callback->Live()) { callback->Cancel(); return true; }
+    callback->Disconnect(); return false;
+  }
+  callback->Watch();
+  return true;
+}
+void CancelForContents(content::WebContents* contents) {
+  std::vector<CefRefPtr<Callback>> owned;
+  for (const auto& [listener, callback] : Requests())
+    if (callback->web_contents() == contents) owned.push_back(callback);
+  for (const auto& callback : owned) callback->Cancel();
+}
+void ListenerDestroyed(Listener* listener) {
+  auto it = Requests().find(listener);
+  if (it != Requests().end()) { auto held = it->second; held->DestroyListener(); }
+}
