+    RunDownloadTargetCallback(std::move(callback), base::FilePath());
+    return;
+  }
+  const auto name = changed_name.empty() ? fallback_name : changed_name;
+  CefRefPtr<CefDownloadItemImpl> native(new CefDownloadItemImpl(item));
