+void ChromeDownloadNameResolved(
+    base::WeakPtr<DownloadManager> manager, uint32_t id,
+    CefRefPtr<CefBrowserHostBase> browser,
+    base::FilePath fallback_name, download::DownloadTargetCallback callback,
