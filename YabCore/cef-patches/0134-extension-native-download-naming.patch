+      new CefBeforeDownloadCallbackImpl(manager, id, name, std::move(callback)));
+  const bool handled = handler->OnBeforeDownload(browser, native, name.value(), target);
+  std::ignore = native->Detach(nullptr);
+  if (!handled && !target->IsDetached()) {
+    LOG(ERROR) << "Chrome download naming requires the opting-in handler to own its target";
+    RunDownloadTargetCallback(target->Detach(), base::FilePath());
+  }
