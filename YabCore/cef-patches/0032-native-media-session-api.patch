+// Deferred native MediaSession boundary. Not installed in the active SDK.
+#ifndef CEF_LIBCEF_BROWSER_EXTERNAL_MEDIA_SESSION_H_
+#define CEF_LIBCEF_BROWSER_EXTERNAL_MEDIA_SESSION_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/unguessable_token.h"
+#include "cef/include/cef_values.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "services/media_session/public/mojom/media_session.mojom.h"
+
+namespace content { class MediaSession; }
+
+// UI sequence only. All ownership comes from the original native session's
+// routed frame. An absent routed frame is unavailable, never the main frame.
+class CefExternalMediaSession final
+    : public content::WebContentsObserver,
+      public media_session::mojom::MediaSessionObserver {
+ public:
+  using Changed = base::RepeatingCallback<void(CefRefPtr<CefDictionaryValue>)>;
+  CefExternalMediaSession(content::WebContents* contents, Changed changed);
+  ~CefExternalMediaSession() override;
+
+  CefRefPtr<CefDictionaryValue> State();
+  bool Action(const std::string& token, const std::string& action, double seconds);
+
+  void MediaSessionCreated(content::MediaSession* session) override;
+  void DidFinishNavigation(content::NavigationHandle*) override;
+  void RenderFrameDeleted(content::RenderFrameHost*) override;
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override;
+  void WebContentsDestroyed() override;
+
+  void MediaSessionInfoChanged(media_session::mojom::MediaSessionInfoPtr) override;
+  void MediaSessionMetadataChanged(
+      const std::optional<media_session::MediaMetadata>&) override;
+  void MediaSessionActionsChanged(
+      const std::vector<media_session::mojom::MediaSessionAction>&) override;
+  void MediaSessionImagesChanged(
+      const base::flat_map<media_session::mojom::MediaSessionImageType,
+                          std::vector<media_session::MediaImage>>&) override;
+  void MediaSessionPositionChanged(
+      const std::optional<media_session::MediaPosition>&) override;
+
+ private:
+  void Publish();
+  void Clear(const char* reason);
+  Changed changed_;
+  mojo::Receiver<media_session::mojom::MediaSessionObserver> receiver_{this};
+  content::WeakDocumentPtr document_;
+  base::UnguessableToken token_;
+  base::UnguessableToken registration_;
+  std::string request_;
+  base::WeakPtrFactory<CefExternalMediaSession> weak_{this};
+};
+
+#endif
--- /dev/null
+++ b/cef/libcef/browser/external_media_session.cc
@@ -0,0 +1,205 @@
+#include "external_media_session.h"
+#include "content/public/browser/external_media_session_routes.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/public/browser/media_session.h"
+#include "content/browser/media/session/media_session_impl.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+using Action = media_session::mojom::MediaSessionAction;
+using Playback = media_session::mojom::MediaPlaybackState;
+using Suspend = media_session::mojom::MediaSession::SuspendType;
+
+const char* Name(Action action) {
+  switch (action) {
+    case Action::kPlay: return "play";
+    case Action::kPause: return "pause";
+    case Action::kSeekTo: return "seek";
+    case Action::kSeekBackward: return "seekBackward";
+    case Action::kSeekForward: return "seekForward";
+    case Action::kNextTrack: return "next";
+    case Action::kPreviousTrack: return "previous";
+    case Action::kToggleMicrophone: return "toggleMicrophone";
+    case Action::kToggleCamera: return "toggleCamera";
+    case Action::kHangUp: return "hangUp";
+    default: return nullptr;
+  }
+}
+bool Live(content::WebContents* contents, content::RenderFrameHost* frame) {
+  return contents && !contents->IsBeingDestroyed() && frame && frame->IsActive() &&
+      frame->IsRenderFrameLive() &&
+      content::WebContents::FromRenderFrameHost(frame) == contents;
+}
+}  // namespace
+
+CefExternalMediaSession::CefExternalMediaSession(
+    content::WebContents* contents, Changed changed)
+    : content::WebContentsObserver(contents), changed_(std::move(changed)) {
+  registration_ = content::external_media_session::Register(contents,
+      base::BindRepeating(&CefExternalMediaSession::Publish, weak_.GetWeakPtr()));
+  if (auto* session = content::MediaSession::GetIfExists(contents))
+    MediaSessionCreated(session);
+}
+CefExternalMediaSession::~CefExternalMediaSession() {
+  content::external_media_session::Remove(web_contents(), registration_);
+}
+
+void CefExternalMediaSession::MediaSessionCreated(content::MediaSession* session) {
+  receiver_.reset();
+  if (session) session->AddObserver(receiver_.BindNewPipeAndPassRemote());
+}
+
+CefRefPtr<CefDictionaryValue> CefExternalMediaSession::State() {
+  auto result = CefDictionaryValue::Create();
+  result->SetInt("version", 1);
+  result->SetBool("available", false);
+  auto* contents = web_contents();
+  auto* session = contents && !contents->IsBeingDestroyed()
+      ? content::MediaSession::GetIfExists(contents) : nullptr;
+  auto* frame = session ? session->GetRoutedFrame() : nullptr;
+  if (!Live(contents, frame)) {
+    token_ = {}; document_ = {}; request_.clear();
+    return result;
+  }
+  const std::string request = content::MediaSession::GetRequestIdFromWebContents(contents).ToString();
+  if (token_.is_empty() || document_.AsRenderFrameHostIfValid() != frame || request_ != request) {
+    document_ = frame->GetWeakDocumentPtr();
+    request_ = request;
+    token_ = base::UnguessableToken::Create();
+  }
+  auto info = session->GetMediaSessionInfoSync();
+  if (!info) {
+    token_ = {}; document_ = {}; request_.clear();
+    return result;
+  }
+  result->SetBool("available", true);
+  result->SetString("token", token_.ToString());
+  result->SetString("session", request_);
+  result->SetString("document", static_cast<content::RenderFrameHostImpl*>(frame)->GetDocumentToken().ToString());
+  result->SetString("frameId", frame->GetDevToolsFrameToken().ToString());
+  result->SetBool("main", frame == contents->GetPrimaryMainFrame());
+  result->SetString("url", frame->GetLastCommittedURL().spec());
+  result->SetString("origin", frame->GetLastCommittedOrigin().Serialize());
+  result->SetBool("controllable", info->is_controllable);
+  result->SetBool("hideMetadata", info->hide_metadata);
+  // These are the site's native MediaSession declarations. They neither
+  // establish capture ownership nor replace MediaStreamCaptureIndicator.
+  using SessionState = media_session::mojom::MediaSessionInfo::SessionState;
+  const char* session_state = "inactive";
+  switch (info->state) {
+    case SessionState::kActive: session_state = "active"; break;
+    case SessionState::kDucking: session_state = "ducking"; break;
+    case SessionState::kSuspended: session_state = "suspended"; break;
+    case SessionState::kInactive: break;
+  }
+  result->SetString("sessionState", session_state);
+  using Microphone = media_session::mojom::MicrophoneState;
+  using Camera = media_session::mojom::CameraState;
+  result->SetString("reportedMicrophone", info->microphone_state == Microphone::kMuted
+      ? "muted" : info->microphone_state == Microphone::kUnmuted ? "unmuted" : "unknown");
+  result->SetString("reportedCamera", info->camera_state == Camera::kTurnedOn
+      ? "on" : info->camera_state == Camera::kTurnedOff ? "off" : "unknown");
+  result->SetBool("reportedPiP", info->picture_in_picture_state ==
+      media_session::mojom::MediaPictureInPictureState::kInPictureInPicture);
+  result->SetBool("outputMuted", info->muted);
+  result->SetString("playback", info->playback_state == Playback::kPlaying ? "playing" : "paused");
+  const auto& metadata = session->GetMediaSessionMetadata();
+  result->SetString("title", info->hide_metadata ? "" : base::UTF16ToUTF8(metadata.title));
+  result->SetString("artist", info->hide_metadata ? "" : base::UTF16ToUTF8(metadata.artist));
+  result->SetString("album", info->hide_metadata ? "" : base::UTF16ToUTF8(metadata.album));
+  auto artwork=CefListValue::Create();
+  if(!info->hide_metadata) {
+    for(const auto& image:static_cast<content::MediaSessionImpl*>(session)->GetExternalArtwork()) {
+      if(artwork->GetSize()>=8)break;
+      if(!image.src.is_valid() || image.src.spec().size()>8192)continue;
+      auto item=CefDictionaryValue::Create();item->SetString("src",image.src.spec());
+      item->SetString("type",base::UTF16ToUTF8(image.type).substr(0,256));
+      auto sizes=CefListValue::Create();
+      for(const auto& size:image.sizes) {
+        if(sizes->GetSize()>=8)break;
+        auto bounds=CefDictionaryValue::Create();bounds->SetInt("width",size.width());bounds->SetInt("height",size.height());
+        sizes->SetDictionary(sizes->GetSize(),bounds);
+      }
+      item->SetList("sizes",sizes);artwork->SetDictionary(artwork->GetSize(),item);
+    }
+  }
+  result->SetList("artwork",artwork);
+  auto actions = CefListValue::Create();
+  for (auto action : session->GetMediaSessionActionsSync())
+    if (const char* name = Name(action)) actions->SetString(actions->GetSize(), name);
+  result->SetList("actions", actions);
+  if (auto position = session->GetMediaSessionPosition()) {
+    const double duration = position->duration().InSecondsF();
+    const double current = position->GetPosition().InSecondsF();
+    const double rate = position->playback_rate();
+    if (std::isfinite(duration) && std::isfinite(current) && std::isfinite(rate)) {
+      auto value = CefDictionaryValue::Create();
+      value->SetDouble("duration", duration);
+      value->SetDouble("position", current);
+      value->SetDouble("rate", rate);
+      result->SetDictionary("position", value);
+    }
+  }
+  return result;
+}
+
+bool CefExternalMediaSession::Action(
+    const std::string& token, const std::string& action, double seconds) {
+  auto state = State();
+  if (token.empty() || !state->GetBool("available") ||
+      state->GetString("token").ToString() != token || !std::isfinite(seconds)) return false;
+  auto* session = content::MediaSession::GetIfExists(web_contents());
+  if (!session || document_.AsRenderFrameHostIfValid() != session->GetRoutedFrame()) return false;
+  const auto actions = session->GetMediaSessionActionsSync();
+  const std::string requested = action == "toggle"
+      ? (state->GetString("playback") == "playing" ? "pause" : "play") : action;
+  if (!std::ranges::any_of(actions, [&](auto value) {
+        const char* name = Name(value); return name && requested == name;
+      })) return false;
+  if (requested == "play") session->Resume(Suspend::kUI);
+  else if (requested == "pause") session->Suspend(Suspend::kUI);
+  else if (requested == "next") session->NextTrack();
+  else if (requested == "previous") session->PreviousTrack();
+  else if (requested == "toggleMicrophone") session->ToggleMicrophone();
+  else if (requested == "toggleCamera") session->ToggleCamera();
+  else if (requested == "hangUp") session->HangUp();
+  else if (requested == "seek") {
+    auto position = session->GetMediaSessionPosition();
+    if (seconds < 0 || !position || seconds > position->duration().InSecondsF()) return false;
+    session->SeekTo(base::Seconds(seconds));
+  } else if (requested == "seekForward" || requested == "seekBackward") {
+    if (seconds <= 0 || seconds > 86400) return false;
+    session->Seek(base::Seconds(requested == "seekBackward" ? -seconds : seconds));
+  } else return false;
+  return true;
+}
+
+void CefExternalMediaSession::Publish() { changed_.Run(State()); }
+void CefExternalMediaSession::Clear(const char* reason) {
+  token_ = {}; document_ = {}; request_.clear();
+  auto result = CefDictionaryValue::Create();
+  result->SetInt("version", 1); result->SetBool("available", false);
+  result->SetString("reason", reason);
+  changed_.Run(result);
+}
+void CefExternalMediaSession::DidFinishNavigation(content::NavigationHandle*) { Publish(); }
+void CefExternalMediaSession::RenderFrameDeleted(content::RenderFrameHost*) { Publish(); }
+void CefExternalMediaSession::PrimaryMainFrameRenderProcessGone(base::TerminationStatus) {
+  Clear("renderer-gone");
+}
+void CefExternalMediaSession::WebContentsDestroyed() {
+  content::external_media_session::Remove(web_contents(), registration_);
+  weak_.InvalidateWeakPtrs();
+  receiver_.reset(); Observe(nullptr); Clear("browser-closed");
+}
+void CefExternalMediaSession::MediaSessionInfoChanged(media_session::mojom::MediaSessionInfoPtr) { Publish(); }
+void CefExternalMediaSession::MediaSessionMetadataChanged(const std::optional<media_session::MediaMetadata>&) { Publish(); }
+void CefExternalMediaSession::MediaSessionActionsChanged(const std::vector<media_session::mojom::MediaSessionAction>&) { Publish(); }
+void CefExternalMediaSession::MediaSessionImagesChanged(const base::flat_map<media_session::mojom::MediaSessionImageType, std::vector<media_session::MediaImage>>&) { Publish(); }
+void CefExternalMediaSession::MediaSessionPositionChanged(const std::optional<media_session::MediaPosition>&) { Publish(); }
