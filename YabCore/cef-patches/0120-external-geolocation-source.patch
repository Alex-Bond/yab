+///
+/// Where the device is, as the embedder knows it: the browser's location
+/// source when the process runs with --yab-external-geolocation (see
+/// CefBrowserProcessHandler::OnGeolocationSource). Chromium then makes no
+/// CoreLocation manager of its own; macOS is asked by the embedder, which
+/// hands over its answer and its fixes. May be called on any thread.
+///
+/*--cef(source=library,added=experimental)--*/
+class CefGeolocationSource : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// What macOS said about the embedder: 0 not determined, 1 denied (or
+  /// Location Services off), 2 allowed. Chromium starts as not determined.
+  ///
+  /*--cef()--*/
+  virtual void SetPermission(int status) = 0;
+
+  ///
+  /// A fix: |position| has latitude, longitude and accuracy (meters), and may
+  /// have altitude, altitudeAccuracy, heading, speed and timestamp
+  /// (milliseconds since the Unix epoch; now if absent).
+  ///
+  /*--cef()--*/
+  virtual void SetPosition(CefRefPtr<CefDictionaryValue> position) = 0;
+
+  ///
+  /// No fix could be had: |code| 1 permission denied, 2 position
+  /// unavailable.
+  ///
+  /*--cef(optional_param=message)--*/
+  virtual void SetError(int code, const CefString& message) = 0;
+};
 #endif
 
