+#include "cef/libcef/browser/views/external_geolocation.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/mac/mac_util.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/synchronization/lock.h"
+#include "base/time/time.h"
+#include "cef/include/cef_browser_process_handler.h"
+#include "cef/include/cef_values.h"
+#include "cef/libcef/common/api_version_util.h"
+#include "cef/libcef/common/app_manager.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "services/device/public/cpp/geolocation/geolocation_system_permission_manager.h"
+#include "services/device/public/cpp/geolocation/geoposition.h"
+#include "services/device/public/cpp/geolocation/location_system_permission_status.h"
+#include "services/device/public/cpp/geolocation/system_geolocation_source.h"
+#include "services/device/public/mojom/geoposition.mojom.h"
+
+namespace cef::external_host {
+namespace {
+
+constexpr char kSwitch[] = "yab-external-geolocation";
+
+using device::LocationSystemPermissionStatus;
+using device::SystemGeolocationSource;
+
+CefRefPtr<CefBrowserProcessHandler> Handler() {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL)) {
+    return nullptr;
+  }
+  auto app = CefAppManager::Get()->GetApplication();
+  return app ? app->GetBrowserProcessHandler() : nullptr;
+}
+
+void OnUI(base::OnceClosure task) {
+  if (content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    std::move(task).Run();
+    return;
+  }
+  content::GetUIThreadTaskRunner({})->PostTask(FROM_HERE, std::move(task));
+}
+
+// The browser's SystemGeolocationSource, fed by the embedder. Owned by the
+// GeolocationSystemPermissionManager singleton for the life of the process.
+class ExternalSource;
+ExternalSource* g_source = nullptr;
+
+class ExternalSource : public SystemGeolocationSource {
+ public:
+  ExternalSource()
+      : observers_(base::MakeRefCounted<PositionObserverList>()) {
+    g_source = this;
+  }
+  ExternalSource(const ExternalSource&) = delete;
+  ExternalSource& operator=(const ExternalSource&) = delete;
+  ~ExternalSource() override {
+    if (g_source == this) {
+      g_source = nullptr;
+    }
+  }
+
+  // SystemGeolocationSource, on the UI thread unless said otherwise.
+  void RegisterPermissionUpdateCallback(
+      PermissionUpdateCallback callback) override {
+    permission_callback_ = std::move(callback);
+    permission_callback_.Run(status_);
+  }
+
+  void OpenSystemPermissionSetting() override {
+    base::mac::OpenSystemSettingsPane(
+        base::mac::SystemSettingsPane::kPrivacySecurity_LocationServices);
+  }
+
+  // Any sequence: CoreLocationProvider's.
+  void AddPositionUpdateObserver(PositionObserver* observer) override {
+    observers_->AddObserver(observer);
+  }
+  void RemovePositionUpdateObserver(PositionObserver* observer) override {
+    observers_->RemoveObserver(observer);
+  }
+
+  // Any sequence. A fix from the last two minutes answers at once, as
+  // CoreLocation's cached one does for Chrome's own source; a fresh one
+  // follows from the embedder.
+  void StartWatchingPosition(bool high_accuracy) override {
+    std::optional<device::mojom::Geoposition> last;
+    {
+      base::AutoLock hold(lock_);
+      last = last_;
+    }
+    if (last && base::Time::Now() - last->timestamp < base::Minutes(2)) {
+      observers_->Notify(FROM_HERE, &PositionObserver::OnPositionUpdated,
+                         *last);
+    }
+    OnUI(base::BindOnce(
+        [](bool high) {
+          if (auto handler = Handler()) {
+            handler->OnGeolocationWatch(true, high);
+          }
+        },
+        high_accuracy));
+  }
+
+  void StopWatchingPosition() override {
+    OnUI(base::BindOnce([] {
+      if (auto handler = Handler()) {
+        handler->OnGeolocationWatch(false, false);
+      }
+    }));
+  }
+
+  void RequestPermission() override {
+    OnUI(base::BindOnce([] {
+      if (auto handler = Handler()) {
+        handler->OnGeolocationPermissionRequested();
+      }
+    }));
+  }
+
+  // From the embedder, on the UI thread.
+  void SetPermission(LocationSystemPermissionStatus status) {
+    if (status == status_) {
+      return;
+    }
+    status_ = status;
+    if (permission_callback_) {
+      permission_callback_.Run(status_);
+    }
+  }
+
+  // From the embedder, any thread.
+  void SetPosition(const device::mojom::Geoposition& position) {
+    {
+      base::AutoLock hold(lock_);
+      last_ = position;
+    }
+    observers_->Notify(FROM_HERE, &PositionObserver::OnPositionUpdated,
+                       position);
+  }
+
+  void SetError(const device::mojom::GeopositionError& error) {
+    observers_->Notify(FROM_HERE, &PositionObserver::OnPositionError, error);
+  }
+
+ private:
+  LocationSystemPermissionStatus status_ =
+      LocationSystemPermissionStatus::kNotDetermined;
+  PermissionUpdateCallback permission_callback_;
+  scoped_refptr<PositionObserverList> observers_;
+  base::Lock lock_;
+  std::optional<device::mojom::Geoposition> last_;
+};
+
+class GeolocationSourceImpl : public CefGeolocationSource {
+ public:
+  GeolocationSourceImpl() = default;
+  GeolocationSourceImpl(const GeolocationSourceImpl&) = delete;
+  GeolocationSourceImpl& operator=(const GeolocationSourceImpl&) = delete;
+
+  void SetPermission(int status) override {
+    const auto value = status == 2   ? LocationSystemPermissionStatus::kAllowed
+                       : status == 1 ? LocationSystemPermissionStatus::kDenied
+                                     : LocationSystemPermissionStatus::kNotDetermined;
+    OnUI(base::BindOnce(
+        [](LocationSystemPermissionStatus value) {
+          if (g_source) {
+            g_source->SetPermission(value);
+          }
+        },
+        value));
+  }
+
+  void SetPosition(CefRefPtr<CefDictionaryValue> position) override {
+    if (!position || position->GetType("latitude") != VTYPE_DOUBLE ||
+        position->GetType("longitude") != VTYPE_DOUBLE ||
+        position->GetType("accuracy") != VTYPE_DOUBLE) {
+      return;
+    }
+    device::mojom::Geoposition fix;
+    fix.latitude = position->GetDouble("latitude");
+    fix.longitude = position->GetDouble("longitude");
+    fix.accuracy = position->GetDouble("accuracy");
+    if (position->GetType("altitude") == VTYPE_DOUBLE) {
+      fix.altitude = position->GetDouble("altitude");
+    }
+    if (position->GetType("altitudeAccuracy") == VTYPE_DOUBLE) {
+      fix.altitude_accuracy = position->GetDouble("altitudeAccuracy");
+    }
+    if (position->GetType("heading") == VTYPE_DOUBLE) {
+      fix.heading = position->GetDouble("heading");
+    }
+    if (position->GetType("speed") == VTYPE_DOUBLE) {
+      fix.speed = position->GetDouble("speed");
+    }
+    fix.timestamp =
+        position->GetType("timestamp") == VTYPE_DOUBLE
+            ? base::Time::FromMillisecondsSinceUnixEpoch(
+                  static_cast<int64_t>(position->GetDouble("timestamp")))
+            : base::Time::Now();
+    if (!device::ValidateGeoposition(fix)) {
+      return;
+    }
+    OnUI(base::BindOnce(
+        [](device::mojom::Geoposition fix) {
+          if (g_source) {
+            g_source->SetPosition(fix);
+          }
+        },
+        fix));
+  }
+
+  void SetError(int code, const CefString& message) override {
+    device::mojom::GeopositionError error;
+    error.error_code =
+        code == 1 ? device::mojom::GeopositionErrorCode::kPermissionDenied
+                  : device::mojom::GeopositionErrorCode::kPositionUnavailable;
+    error.error_message = message.ToString();
+    OnUI(base::BindOnce(
+        [](device::mojom::GeopositionError error) {
+          if (g_source) {
+            g_source->SetError(error);
+          }
+        },
+        std::move(error)));
+  }
+
+ private:
+  IMPLEMENT_REFCOUNTING(GeolocationSourceImpl);
+};
+
+}  // namespace
+
+void InstallGeolocationSource() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(kSwitch) ||
+      device::GeolocationSystemPermissionManager::GetInstance()) {
+    return;
+  }
+  auto handler = Handler();
+  if (!handler) {
+    return;
+  }
+  device::GeolocationSystemPermissionManager::SetInstance(
+      std::make_unique<device::GeolocationSystemPermissionManager>(
+          std::make_unique<ExternalSource>()));
+  handler->OnGeolocationSource(new GeolocationSourceImpl());
+}
+
+}  // namespace cef::external_host
