+  if(!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !callback || path.empty())return false;
+  auto* contents=GetWebContents();if(!contents)return false;
+  auto* frame=cef::external_host::ResolvePrintSource(contents,source.ToString());
+  if(!frame)return false;
+  print_util::PrintToPDF(contents,path,settings,callback,frame);return true;
+#else
+  return false;
+#endif
+}
+bool CefBrowserHostBase::ReleaseNativePrintSource(const CefString& source) {
+  CEF_REQUIRE_UIT_RETURN(false);
+#if BUILDFLAG(IS_MAC)
+  auto* contents=GetWebContents();
+  return CEF_API_IS_ADDED(CEF_EXPERIMENTAL) && contents &&
+      cef::external_host::ReleasePrintSource(contents,source.ToString());
+#else
+  return false;
+#endif
+}
