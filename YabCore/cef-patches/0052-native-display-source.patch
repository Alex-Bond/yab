+bool CefExternalCapture::Grant(const std::string& source, const std::string& origin, bool audio) {
+  const auto media = ParseDisplaySource(source, audio);
+  const url::Origin site = url::Origin::Create(GURL(origin));
+  if (media.is_null() || site.opaque()) return false;
+  granted_ = media;
+  granted_origin_ = site;
+  granted_at_ = base::TimeTicks::Now();
+  return true;
+}
+bool CefExternalCapture::Switch(const std::string& source, bool audio) {
+  const auto media = ParseDisplaySource(source, audio);
+  if (media.is_null() || media.type != content::DesktopMediaID::TYPE_WEB_CONTENTS || !switcher_) return false;
+  switching_ = media;
+  switcher_.Run(media, /*captured_surface_control_active=*/false);
+  return true;
+}
+content::DesktopMediaID CefExternalCapture::TakeSource(const content::MediaStreamRequest& request) {
+  if (request.request_type == blink::MEDIA_DEVICE_UPDATE) {
+    content::DesktopMediaID media = switching_;
+    switching_ = {};
+    content::WebContentsMediaCaptureId asked;
+    if (media.is_null() || request.requested_video_device_ids.empty() ||
+        !content::WebContentsMediaCaptureId::Parse(request.requested_video_device_ids.front(), &asked) ||
+        asked.render_process_id != media.web_contents_id.render_process_id ||
+        asked.main_render_frame_id != media.web_contents_id.main_render_frame_id) {
+      return {};
+    }
+    return media;
+  }
+  if (granted_.is_null() ||
+      (request.video_type != blink::mojom::MediaStreamType::DISPLAY_VIDEO_CAPTURE &&
+       request.video_type != blink::mojom::MediaStreamType::DISPLAY_VIDEO_CAPTURE_THIS_TAB)) {
+    return {};
+  }
+  content::DesktopMediaID media = granted_;
+  const bool fresh = base::TimeTicks::Now() - granted_at_ < kGrantLifetime &&
+      url::Origin::Create(request.security_origin) == granted_origin_;
+  granted_ = {};
+  return fresh ? media : content::DesktopMediaID();
 }
