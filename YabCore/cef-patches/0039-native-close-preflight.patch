+#include "external_close.h"
+#include <utility>
+#include <vector>
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/browser/site_instance_impl.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "content/public/browser/external_close_routes.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/javascript_dialog_manager.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+
+CefExternalClose::CefExternalClose(content::WebContents* owner,Changed changed)
+ : content::WebContentsObserver(owner),changed_(std::move(changed)),registration_(base::UnguessableToken::Create()) {}
+CefExternalClose::~CefExternalClose() { content::external_close::Remove(web_contents(),registration_); }
+CefExternalClose::Documents CefExternalClose::CurrentDocuments() const {
+  Documents result;
+  if (!web_contents() || web_contents()->IsBeingDestroyed()) return result;
+  auto* primary=web_contents()->GetPrimaryMainFrame();
+  if(!primary || !primary->IsActive()) return result;
+  primary->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+    auto* native=static_cast<content::RenderFrameHostImpl*>(frame);
+    if(frame->IsActive() && !native->IsNestedWithinFencedFrame() &&
+       content::WebContents::FromRenderFrameHost(frame)==web_contents())
+      result.emplace(frame->GetGlobalId(),frame->GetWeakDocumentPtr());
+  });
+  return result;
+}
+bool CefExternalClose::ExactDocuments() const {
+  auto current=CurrentDocuments();
+  if(current.empty() || current.size()!=documents_.size() || !primary_.AsRenderFrameHostIfValid() ||
+     primary_.AsRenderFrameHostIfValid()!=web_contents()->GetPrimaryMainFrame()) return false;
+  for(const auto& [id,doc]:documents_) {
+    auto found=current.find(id);
+    if(found==current.end() || !doc.AsRenderFrameHostIfValid() ||
+       found->second.AsRenderFrameHostIfValid()!=doc.AsRenderFrameHostIfValid()) return false;
+  }
+  return true;
+}
+CefRefPtr<CefDictionaryValue> CefExternalClose::State(bool decision,bool withdrawn) const {
+  auto state=CefDictionaryValue::Create();state->SetInt("version",1);
+  state->SetString("request",request_);state->SetString("phase",phase_);
+  state->SetString("document",document_);state->SetString("reason",reason_);
+  state->SetBool("decision",decision);state->SetBool("withdrawn",withdrawn);
+  state->SetBool("final",phase_=="closed" || phase_=="retained");
+  state->SetBool("closed",phase_=="closed");
+  state->SetBool("allow",phase_=="approved");state->SetInt("frameCount",static_cast<int>(documents_.size()));
+  if(!token_.empty())state->SetString("token",token_);
+  return state;
+}
+CefRefPtr<CefDictionaryValue> CefExternalClose::Begin() {
+  if(phase_=="pending" || phase_=="approved" || phase_=="committing" || phase_=="closed") {
+    auto state=State();state->SetBool("accepted",false);return state;
+  }
+  documents_=CurrentDocuments();
+  auto* primary=web_contents() ? static_cast<content::RenderFrameHostImpl*>(web_contents()->GetPrimaryMainFrame()):nullptr;
+  if(documents_.empty() || !primary || primary->is_waiting_for_beforeunload_completion() ||
+     primary->IsWaitingForUnloadACK() || web_contents()->GetController().GetPendingEntry() ||
+     static_cast<content::WebContentsImpl*>(web_contents())->IsJavaScriptDialogShowing()) {
+    auto state=State();state->SetBool("accepted",false);return state;
+  }
+  primary_=primary->GetWeakDocumentPtr();document_=primary->GetDocumentToken().ToString();
+  request_=base::UnguessableToken::Create().ToString();token_.clear();phase_="pending";reason_.clear();
+  prompt_shown_=false;all_allowed_=true;
+  content::external_close::Register(web_contents(),{registration_,request_,
+    base::BindRepeating([](base::WeakPtr<CefExternalClose> self,content::RenderFrameHost* frame,bool consume) {
+      return self ? self->EvaluatePrompt(frame,consume) : -1;
+    },weak_.GetWeakPtr())});
+  std::vector<content::RenderFrameHostImpl*> roots;
+  for(const auto& [id,doc]:documents_) {
+    auto* frame=static_cast<content::RenderFrameHostImpl*>(doc.AsRenderFrameHostIfValid());
+    if(!frame || !frame->is_local_root())continue;
+    bool covered=false;
+    for(auto* parent=frame->GetParent();parent;parent=parent->GetParent()) {
+      if(content::WebContents::FromRenderFrameHost(parent)!=web_contents())break;
+      if(parent->GetSiteInstance()->group()==frame->GetSiteInstance()->group()) {covered=true;break;}
+    }
+    if(!covered)roots.push_back(frame);
+  }
+  pending_=roots.size();
+  timeout_.Start(FROM_HERE,base::Seconds(30),base::BindOnce(&CefExternalClose::Invalidate,weak_.GetWeakPtr(),"renderer-timeout"));
+  // All callbacks are separate from the normal closing/navigation state machine.
+  // Even a late Leave after cancellation cannot reach Browser::CloseContents.
+  for(auto* frame:roots) frame->DispatchBeforeUnloadPreflight(request_,base::BindOnce(
+      &CefExternalClose::Completed,weak_.GetWeakPtr(),request_));
+  if(roots.empty())Completed(request_,true);
+  auto state=State();state->SetBool("accepted",true);return state;
+}
+int CefExternalClose::EvaluatePrompt(content::RenderFrameHost* frame,bool consume) {
+  if(phase_!="pending" || !ExactDocuments())return -1;
+  auto found=documents_.find(frame->GetGlobalId());
+  if(found==documents_.end() || found->second.AsRenderFrameHostIfValid()!=frame)return -1;
+  if(!consume)return 0;
+  if(prompt_shown_)return 1;
+  prompt_shown_=true;timeout_.Stop();return 0;
+}
+void CefExternalClose::Completed(const std::string& request,bool allow) {
+  if(phase_!="pending" || request_!=request)return;
+  if(!ExactDocuments()) {Invalidate("document-retired");return;}
+  all_allowed_ &= allow;
+  if(pending_)--pending_;
+  if(pending_) {
+    if (!static_cast<content::WebContentsImpl*>(web_contents())->IsJavaScriptDialogShowing())
+      timeout_.Start(FROM_HERE,base::Seconds(30),base::BindOnce(&CefExternalClose::Invalidate,weak_.GetWeakPtr(),"renderer-timeout"));
+    return;
+  }
+  timeout_.Stop();content::external_close::Remove(web_contents(),registration_);
+  phase_=all_allowed_?"approved":"denied";
+  if(all_allowed_)token_=base::UnguessableToken::Create().ToString();
+  Enqueue(State(true));
+}
+bool CefExternalClose::Cancel(const std::string& request) {
+  if((phase_!="pending" && phase_!="approved") || (request!=request_ && request!=token_))return false;
+  Invalidate("cancelled-by-embedder");return true;
+}
+void CefExternalClose::Invalidate(const char* reason) {
+  if(phase_!="pending" && phase_!="approved" && phase_!="committing")return;
+  const bool committing=phase_=="committing";
+  const bool decision=phase_=="pending",withdrawn=phase_=="approved";
+  timeout_.Stop();content::external_close::Remove(web_contents(),registration_);
+  phase_=committing?"retained":withdrawn?"withdrawn":"retired";reason_=reason;
+  if(committing)changed_.Run(State());else Enqueue(State(decision,withdrawn));
+  // Only our currently pending native dialog can be withdrawn here. The phase
+  // and request gate retire before cancellation can synchronously reply.
+  if(decision && prompt_shown_ && web_contents() && web_contents()->GetDelegate()) {
+    if(auto* dialogs=web_contents()->GetDelegate()->GetJavaScriptDialogManager(web_contents()))
+      dialogs->CancelDialogs(web_contents(),true);
+  }
+}
+bool CefExternalClose::Validate(const std::string& token) const {
+  auto* primary=static_cast<content::RenderFrameHostImpl*>(primary_.AsRenderFrameHostIfValid());
+  return phase_=="approved" && !token.empty() && token==token_ && primary && ExactDocuments() &&
+     !primary->is_waiting_for_beforeunload_completion() && !primary->IsWaitingForUnloadACK() &&
+     !web_contents()->GetController().GetPendingEntry() &&
+     !static_cast<content::WebContentsImpl*>(web_contents())->IsJavaScriptDialogShowing();
+}
+bool CefExternalClose::Commit(const std::string& token) {
+  if(!Validate(token)) {Invalidate("approval-retired");return false;}
+  auto* primary=static_cast<content::RenderFrameHostImpl*>(primary_.AsRenderFrameHostIfValid());
+  phase_="committing";timeout_.Stop();content::external_close::Remove(web_contents(),registration_);
+  // The exact current RFH gets native unload now. No queued force-close can
+  // accidentally close a later document after a navigation or a new prompt.
+  primary->ClosePreflightApprovedPage(base::BindRepeating(
+      [](base::WeakPtr<CefExternalClose> self) {return self && self->CloseCompleted();},weak_.GetWeakPtr()));
+  return true;
+}
+bool CefExternalClose::CloseCompleted() {
+  if(phase_!="committing")return false;
+  const bool exact=ExactDocuments();
+  phase_=exact?"closed":"retained";reason_=exact?"native-unload-completed":"document-retired-before-close";
+  // Final success must be delivered before the following native Close destroys
+  // this observer. The embedder only writes this immutable receipt here.
+  changed_.Run(State());
+  return exact;
+}
+void CefExternalClose::Enqueue(CefRefPtr<CefDictionaryValue> event) {
+  events_.push_back(event);
+  if(flush_pending_)return;
+  flush_pending_=true;base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce(&CefExternalClose::Flush,weak_.GetWeakPtr()));
+}
+void CefExternalClose::Flush() {
+  flush_pending_=false;
+  auto self=weak_.GetWeakPtr();
+  while(self && !events_.empty()) {
+    auto event=events_.front();events_.pop_front();changed_.Run(event);
+  }
+}
+void CefExternalClose::DidStartNavigation(content::NavigationHandle* handle) {
+  if(!handle->IsSameDocument())Invalidate("navigation-started");
+}
+void CefExternalClose::RenderFrameCreated(content::RenderFrameHost*) {Invalidate("frame-created");}
+void CefExternalClose::RenderFrameDeleted(content::RenderFrameHost*) {Invalidate("frame-deleted");}
+void CefExternalClose::PrimaryMainFrameRenderProcessGone(base::TerminationStatus) {Invalidate("renderer-gone");}
+void CefExternalClose::WebContentsDestroyed() {
+  if(phase_=="committing") {phase_="closed";reason_="browser-destroyed";changed_.Run(State());}
+  else Invalidate("browser-closed");
+  Observe(nullptr);
+}
