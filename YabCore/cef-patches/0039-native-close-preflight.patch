+// Native non-destructive beforeunload prompt policy, UI sequence only.
+#ifndef CONTENT_PUBLIC_BROWSER_EXTERNAL_CLOSE_ROUTES_H_
+#define CONTENT_PUBLIC_BROWSER_EXTERNAL_CLOSE_ROUTES_H_
+#include <map>
