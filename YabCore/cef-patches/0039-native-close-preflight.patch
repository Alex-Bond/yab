+namespace content::external_close {
+struct PromptGate {
+  base::UnguessableToken registration;
+  std::string request;
+  // -1: stale/refuse, 0: first native prompt, 1: duplicate/suppress.
+  base::RepeatingCallback<int(content::RenderFrameHost*,bool)> evaluate;
+};
+inline std::map<content::WebContents*, PromptGate>& Gates() {
+  static base::NoDestructor<std::map<content::WebContents*, PromptGate>> gates;
+  return *gates;
+}
+inline void Register(content::WebContents* owner, PromptGate gate) { Gates().insert_or_assign(owner,std::move(gate)); }
+inline void Remove(content::WebContents* owner,const base::UnguessableToken& registration) {
+  auto found=Gates().find(owner);
+  if(found!=Gates().end() && found->second.registration==registration) Gates().erase(found);
+}
+inline int EvaluatePrompt(content::RenderFrameHost* frame, const std::string& request, bool consume) {
+  auto found=Gates().find(content::WebContents::FromRenderFrameHost(frame));
+  if(found==Gates().end() || found->second.request!=request) return -1;
+  return found->second.evaluate.Run(frame,consume);
+}
+}  // namespace content::external_close
