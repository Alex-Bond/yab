+  // Yab: a page an extension's windows.create made, beside its owner tab: a
+  // group of its own, named by the window Chrome made and answered to the
+  // extension, so tabs.query reports that window and windows.remove of it
+  // reaches this page only, never the owner's window (Bitwarden's passkey
+  // popout closed the site's tab with windowId). The owner stays the page's
+  // owner, for the embedder's placement; the group is the embedder's when the
+  // owner's is.
+  static bool BindOwnWindow(content::WebContents* contents,
+                            content::WebContents* owner,
+                            int native_window_id) {
+    if (!contents || !owner || contents->IsBeingDestroyed() ||
+        owner->IsBeingDestroyed() || native_window_id < 0 ||
+        contents->GetBrowserContext() != owner->GetBrowserContext())
+      return false;
+    // Chrome may have put it in its owner's window as it navigated it.
+    if (auto* current = Get(contents)) {
+      std::erase_if(current->group_->tabs,
+                    [contents](const auto& tab) { return tab.get() == contents; });
+      if (current->group_->active.get() == contents)
+        current->group_->active.reset();
+    }
+    auto group = std::make_shared<Group>();
+    group->window = native_window_id;
+    group->embedded = Get(owner) && Get(owner)->embedded();
+    group->active = contents->GetWeakPtr();
+    group->tabs.push_back(contents->GetWeakPtr());
+    contents->SetUserData(&kKey, std::unique_ptr<ExternalTabModel>(
+        new ExternalTabModel(contents, std::move(group), nullptr, owner)));
+    return true;
+  }
