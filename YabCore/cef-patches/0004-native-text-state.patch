@@ -0,0 +1,172 @@
+#include "external_text_input.h"
+#include <utility>
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/public/browser/focused_node_details.h"
+#include "content/public/browser/render_frame_host.h"
+#include "ui/base/ime/text_input_flags.h"
+
+CefExternalTextInput::CefExternalTextInput(content::WebContents* contents,
+                                         Callback callback)
+    : content::WebContentsObserver(contents), callback_(std::move(callback)) {
+  // WebContentsImpl owns TextInputManager and destroys it after notifying
+  // WebContentsDestroyed. Observe that lifetime, not a transient focused view.
+  manager_ = static_cast<content::WebContentsImpl*>(contents)->GetTextInputManager();
+  if (manager_) manager_->AddObserver(this);
+}
+CefExternalTextInput::~CefExternalTextInput() { Detach(); }
+void CefExternalTextInput::Detach() {
+  if (manager_) manager_->RemoveObserver(this);
+  manager_ = nullptr;
+}
+void CefExternalTextInput::WebContentsDestroyed() {
+  focused_ = false;
+  focused_node_ = {};
+  ++focus_token_;
+  Detach();
+  // Send a final empty state while the receiver is still associated with its
+  // tab. The public bridge must not synchronously destroy the owning window.
+  Emit(true);
+}
+void CefExternalTextInput::Publish() { Emit(false); }
+bool CefExternalTextInput::HasNativeTarget() const {
+  if (!focused_ || !manager_ || !web_contents()) return false;
+  auto* frame = focused_node_.document.AsRenderFrameHostIfValid();
+  auto* widget = manager_->GetActiveWidget();
+  const auto* state = manager_->GetTextInputState();
+  return frame && frame->IsActive() &&
+      frame == web_contents()->GetFocusedFrame() && widget &&
+      widget == frame->GetRenderWidgetHost() && state &&
+      state->type != ui::TEXT_INPUT_TYPE_NONE &&
+      !focused_node_.target_element_dom_id.is_null() &&
+      state->node_id == focused_node_.target_element_dom_id.value();
+}
+bool CefExternalTextInput::MatchesFocus(uint64_t token) const {
+  return token && token == focus_token_ && HasNativeTarget();
+}
+bool CefExternalTextInput::IsActiveView(
+    content::RenderWidgetHostViewBase* updated) const {
+  // Compare addresses only. An unregistering updated view must not be queried.
+  auto* active = manager_ ? manager_->GetActiveWidget() : nullptr;
+  return active && active->GetView() == updated && HasNativeTarget();
+}
+void CefExternalTextInput::OnWebContentsFocused(content::RenderWidgetHost*) {
+  focused_ = true;
+  ++focus_token_;
+  Emit(false);
+}
+void CefExternalTextInput::OnWebContentsLostFocus(content::RenderWidgetHost*) {
+  focused_ = false;
+  ++focus_token_;
+  Emit(true);
+}
+void CefExternalTextInput::OnFocusChangedInPage(
+    const content::FocusedNodeDetails& details) {
+  focused_node_ = details.global_dom_node_id;
+  ++focus_token_;
+  Emit(true);
+}
+void CefExternalTextInput::OnFrameFocused(content::RenderFrameHost* frame) {
+  if (focused_node_.document.AsRenderFrameHostIfValid() != frame) {
+    focused_node_ = {};
+    ++focus_token_;
+    Emit(true);
+  }
+}
+void CefExternalTextInput::PrimaryPageChanged(content::Page&) {
+  focused_node_ = {};
+  ++focus_token_;
+  Emit(true);
+}
+void CefExternalTextInput::RenderFrameDeleted(content::RenderFrameHost* frame) {
+  auto* target = focused_node_.document.AsRenderFrameHostIfValid();
+  if (!target || target == frame) {
+    focused_node_ = {};
+    ++focus_token_;
+    Emit(true);
+  }
+}
+void CefExternalTextInput::Emit(bool cancelled) {
+  CefExternalTextSnapshot snapshot;
+  snapshot.revision = ++revision_;
+  snapshot.cancelled = cancelled;
+  if (HasNativeTarget()) {
+    // Never fetch state from updated_view. That view may be unregistering,
+    // and the active editable widget may belong to a cross-origin child.
+    if (const auto* state = manager_->GetTextInputState()) {
+      snapshot.focus_token = focus_token_;
+      snapshot.type = state->type;
+      snapshot.flags = state->flags;
+      snapshot.node = state->node_id;
+      snapshot.editable = state->type != ui::TEXT_INPUT_TYPE_NONE;
+      snapshot.secure = state->type == ui::TEXT_INPUT_TYPE_PASSWORD ||
+          (state->flags & (ui::TEXT_INPUT_FLAG_HAS_BEEN_PASSWORD |
+                           ui::TEXT_INPUT_FLAG_HAS_BEEN_CUSTOM_PASSWORD));
+      snapshot.selection = state->selection;
+      if (!cancelled && state->composition)
+        snapshot.composition = *state->composition;
+      // Mirror Chromium's secure-input boundary. Do not forward any previous
+      // surrounding-text cache when moving into a password field.
+      if (!snapshot.secure && selection_text_token_ == focus_token_) {
+        if (const auto* selection = manager_->GetTextSelection();
+            selection && selection->text().size() <= 65536) {
+          snapshot.has_surrounding = true;
+          snapshot.surrounding = selection->text();
+          snapshot.surrounding_offset = selection->offset();
+          snapshot.selection = selection->range();
+        }
+      }
+      snapshot.selection_bounds = manager_->GetTextSelectionBounds();
+      if (snapshot.selection.IsValid()) {
+        if (snapshot.selection.is_empty())
+          snapshot.caret_bounds = snapshot.selection_bounds;
+        // EditContext bounds above are optional. Ordinary inputs use the
+        // selection region, already transformed into root-page DIP by TIM.
+        if (selection_geometry_token_ == focus_token_) {
+          if (const auto* region = manager_->GetSelectionRegion()) {
+            if (!snapshot.selection_bounds)
+              snapshot.selection_bounds = region->first_selection_rect;
+            if (snapshot.selection.is_empty() && !snapshot.caret_bounds)
+              snapshot.caret_bounds = region->caret_rect;
+          }
+        }
+      }
+      if (!cancelled && composition_geometry_token_ == focus_token_) {
+        if (const auto* info = manager_->GetCompositionRangeInfo();
+            info && snapshot.composition.IsValid() &&
+            info->range == snapshot.composition &&
+            info->character_bounds.size() == info->range.length() &&
+            info->character_bounds.size() <= 4096) {
+          snapshot.composition_bounds = info->character_bounds;
+        }
+      }
+    }
+  }
+  auto callback = callback_;
+  if (callback) callback.Run(std::move(snapshot));
+}
+void CefExternalTextInput::OnUpdateTextInputStateCalled(
+    content::TextInputManager*, content::RenderWidgetHostViewBase*, bool) {
+  Emit(false);
+}
+void CefExternalTextInput::OnImeCancelComposition(
+    content::TextInputManager*, content::RenderWidgetHostViewBase* view) {
+  if (IsActiveView(view) || !HasNativeTarget()) Emit(true);
+}
+void CefExternalTextInput::OnSelectionBoundsChanged(
+    content::TextInputManager*, content::RenderWidgetHostViewBase* view) {
+  if (IsActiveView(view)) selection_geometry_token_ = focus_token_;
+  Emit(false);
+}
+void CefExternalTextInput::OnImeCompositionRangeChanged(
+    content::TextInputManager*, content::RenderWidgetHostViewBase* view,
+    bool character_bounds_changed) {
+  if (character_bounds_changed && IsActiveView(view))
+    composition_geometry_token_ = focus_token_;
+  Emit(false);
+}
+void CefExternalTextInput::OnTextSelectionChanged(
+    content::TextInputManager*, content::RenderWidgetHostViewBase* view) {
+  if (IsActiveView(view)) selection_text_token_ = focus_token_;
+  Emit(false);
+}
