@@ -0,0 +1,55 @@
+#include "cef/libcef/browser/views/external_text_value.h"
+#include "cef/libcef/browser/views/external_text_input.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace {
+CefRefPtr<CefDictionaryValue> RectValue(const gfx::Rect& rect) {
+  auto result = CefDictionaryValue::Create();
+  result->SetInt("x", rect.x());
+  result->SetInt("y", rect.y());
+  result->SetInt("width", rect.width());
+  result->SetInt("height", rect.height());
+  return result;
+}
+CefRefPtr<CefDictionaryValue> RangeValue(const gfx::Range& range) {
+  auto result = CefDictionaryValue::Create();
+  result->SetBool("valid", range.IsValid());
+  if (range.IsValid()) {
+    result->SetDouble("start", range.start());
+    result->SetDouble("end", range.end());
+  }
+  return result;
+}
+}  // namespace
+CefRefPtr<CefDictionaryValue> CefExternalTextValue(
+    const CefExternalTextSnapshot& state) {
+  auto result = CefDictionaryValue::Create();
+  result->SetInt("stateVersion", 1);
+  result->SetString("coordinateSpace", "rootPage");
+  result->SetString("revision", base::NumberToString(state.revision));
+  result->SetString("focusToken", base::NumberToString(state.focus_token));
+  result->SetBool("editable", state.editable);
+  result->SetBool("secure", state.secure);
+  result->SetBool("cancelled", state.cancelled);
+  result->SetInt("type", static_cast<int>(state.type));
+  result->SetDouble("flags", state.flags);
+  result->SetInt("node", state.node);
+  result->SetDictionary("selection", RangeValue(state.selection));
+  result->SetDictionary("composition", RangeValue(state.composition));
+  result->SetBool("hasSurrounding", state.has_surrounding && !state.secure);
+  if (state.has_surrounding && !state.secure) {
+    result->SetString("surrounding", CefString(state.surrounding));
+    result->SetString("surroundingOffset",
+                      base::NumberToString(state.surrounding_offset));
+  }
+  if (state.selection_bounds)
+    result->SetDictionary("selectionBounds", RectValue(*state.selection_bounds));
+  if (state.caret_bounds)
+    result->SetDictionary("caretBounds", RectValue(*state.caret_bounds));
+  auto bounds = CefListValue::Create();
+  bounds->SetSize(state.composition_bounds.size());
+  for (size_t i = 0; i < state.composition_bounds.size(); ++i)
+    bounds->SetDictionary(i, RectValue(state.composition_bounds[i]));
+  result->SetList("compositionBounds", bounds);
+  return result;
+}
