+// Candidate native text observer for Yab's experimental source SDK.
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "content/browser/renderer_host/text_input_manager.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/global_dom_node_id.h"
+#include "ui/base/ime/text_input_type.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/range/range.h"
+
+// Values use native UTF-16 ranges. Rectangles are root-page DIP, never the
+// concealed producer window's screen coordinates. The client maps them into
+// its actual window before answering NSTextInputClient geometry queries.
+struct CefExternalTextSnapshot {
+  uint64_t revision = 0;
+  uint64_t focus_token = 0;  // Zero means no validated native editing target.
+  bool editable = false, secure = false, cancelled = false;
+  bool has_surrounding = false;
+  ui::TextInputType type = ui::TEXT_INPUT_TYPE_NONE;
+  uint32_t flags = 0;
+  int node = 0;
+  std::u16string surrounding;
+  size_t surrounding_offset = 0;
+  gfx::Range selection = gfx::Range::InvalidRange();
+  gfx::Range composition = gfx::Range::InvalidRange();
+  std::optional<gfx::Rect> selection_bounds;
+  std::optional<gfx::Rect> caret_bounds;
+  std::vector<gfx::Rect> composition_bounds;
+};
+
+class CefExternalTextInput final : public content::WebContentsObserver,
+                                   public content::TextInputManager::Observer {
+ public:
+  using content::WebContentsObserver::OnTextSelectionChanged;
+  using Callback = base::RepeatingCallback<void(CefExternalTextSnapshot)>;
+  CefExternalTextInput(content::WebContents* contents, Callback callback);
+  ~CefExternalTextInput() override;
+  void Publish();
+  // UI sequence only. Check immediately before a composition operation; a
+  // previously published selection range alone never authorizes text input.
+  bool MatchesFocus(uint64_t token) const;
+  void WebContentsDestroyed() override;
+  void OnWebContentsFocused(content::RenderWidgetHost*) override;
+  void OnWebContentsLostFocus(content::RenderWidgetHost*) override;
+  void OnFocusChangedInPage(const content::FocusedNodeDetails&) override;
+  void OnFrameFocused(content::RenderFrameHost*) override;
+  void PrimaryPageChanged(content::Page&) override;
+  void RenderFrameDeleted(content::RenderFrameHost*) override;
+  void OnUpdateTextInputStateCalled(content::TextInputManager*,
+      content::RenderWidgetHostViewBase*, bool) override;
+  void OnImeCancelComposition(content::TextInputManager*,
+      content::RenderWidgetHostViewBase*) override;
+  void OnSelectionBoundsChanged(content::TextInputManager*,
+      content::RenderWidgetHostViewBase*) override;
+  void OnImeCompositionRangeChanged(content::TextInputManager*,
+      content::RenderWidgetHostViewBase*, bool) override;
+  void OnTextSelectionChanged(content::TextInputManager*,
+      content::RenderWidgetHostViewBase*) override;
+ private:
+  void Detach();
+  void Emit(bool cancelled);
+  bool HasNativeTarget() const;
+  bool IsActiveView(content::RenderWidgetHostViewBase*) const;
+  raw_ptr<content::TextInputManager> manager_ = nullptr;
+  Callback callback_;
+  uint64_t revision_ = 0;
+  uint64_t focus_token_ = 1;
+  bool focused_ = false;
+  content::GlobalDOMNodeId focused_node_;
+  uint64_t selection_text_token_ = 0;
+  uint64_t selection_geometry_token_ = 0;
+  uint64_t composition_geometry_token_ = 0;
+};
