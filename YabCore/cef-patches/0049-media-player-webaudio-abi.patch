+// AudioContext has no original video target, duration/rate or captions. Keep
+// the new MediaPlayer ABI complete without claiming HTMLMediaElement controls.
+void AudioContext::RequestNativeControlState(RequestNativeControlStateCallback callback) {
+  auto state = media::mojom::blink::MediaPlayerControlState::New();
+  state->known = false;
+  std::move(callback).Run(std::move(state));
+}
+void AudioContext::RequestNativePlaybackRate(double rate) {}
+void AudioContext::RequestNativeCaptions(bool enabled) {}
+
 void AudioContext::SetVolumeMultiplier(double multiplier) {
   volume_multiplier_ = multiplier;
 }
