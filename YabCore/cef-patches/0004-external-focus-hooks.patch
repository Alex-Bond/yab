+  auto browser = CefBrowserHostBase::FromBrowser(browser_view->GetBrowser());
+  auto* contents = browser ? browser->GetWebContents() : nullptr;
+  auto* view = contents ? contents->GetRenderWidgetHostView() : nullptr;
+  auto* host = widget ? views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+                            widget->GetNativeWindow()) : nullptr;
+  if (!view || !host) return false;
+  auto* base_view = static_cast<content::RenderWidgetHostViewBase*>(view);
+  if (base_view->IsRenderWidgetHostViewChildFrame() ||
+      !host->SetExternalHostFocus(focused)) return false;
+  static_cast<content::RenderWidgetHostViewMac*>(view)->SetExternalHostFocus(focused);
+  if (focused) browser_view->RequestFocus();
+  return true;
+}
