+  ns_view_->SetExternalHostFocus(focused);
+  // Ignore asynchronous physical-window notifications after the opt-in.
+  // The explicit first-responder path also updates the focused child widget.
+  if (focused) {
+    ns_view_->MakeFirstResponder();
+    OnFirstResponderChanged(true);
+    OnWindowIsKeyChanged(true);
+  } else {
+    OnWindowIsKeyChanged(false);
+    OnFirstResponderChanged(false);
+  }
+}
