 namespace {
+
+// The signed owning app keeps the existing Safe Storage item. Only the
+// browser process requests it, once, over its private launch channel. Never
+// put the secret in switches/environment or fall back to a new/basic key.
+std::string PasswordFromOwningApp(const std::string& path) {
+  CHECK(!path.empty() && path.size() < sizeof(sockaddr_un::sun_path));
+  base::ScopedFD channel(socket(AF_UNIX, SOCK_STREAM, 0));
+  CHECK(channel.is_valid());
+  sockaddr_un address = {};
+  address.sun_family = AF_UNIX;
+  address.sun_len = sizeof(address);
+  memcpy(address.sun_path, path.c_str(), path.size() + 1);
+  CHECK_EQ(connect(channel.get(), reinterpret_cast<sockaddr*>(&address),
+                   sizeof(address)), 0);
+  pid_t peer = 0;
+  socklen_t size = sizeof(peer);
+  CHECK_EQ(getsockopt(channel.get(), SOL_LOCAL, LOCAL_PEERPID, &peer, &size), 0);
+  CHECK_EQ(peer, getppid());
+  auto read_exactly = [&](void* bytes, size_t count) {
+    auto* next = static_cast<char*>(bytes);
+    while (count) {
+      const ssize_t got = HANDLE_EINTR(read(channel.get(), next, count));
+      CHECK_GT(got, 0) << "Owning app could not provide Yab Safe Storage";
+      next += got;
+      count -= got;
+    }
+  };
+  uint32_t length = 0;
+  read_exactly(&length, sizeof(length));
+  length = ntohl(length);
+  CHECK_GT(length, 0u) << "Owning app could not read Yab Safe Storage";
+  CHECK_LE(length, 4096u);
+  std::string password(length, '\0');
+  read_exactly(password.data(), password.size());
+  return password;
+}
 
