+#ifndef COMPONENTS_DOWNLOAD_PUBLIC_COMMON_DOWNLOAD_PUBLICATION_H_
+#define COMPONENTS_DOWNLOAD_PUBLIC_COMMON_DOWNLOAD_PUBLICATION_H_
+
+#include "base/functional/callback.h"
+#include "base/supports_user_data.h"
+#include "components/download/public/common/download_item.h"
+
+namespace download {
+// A native DownloadItem owns this adapter. It synchronizes the real journal
+// after a trusted embedder publishes the completed bytes, without extending
+// DownloadItem's public vtable or keeping a second filename registry.
+class DownloadPublication : public base::SupportsUserData::Data {
+ public:
+  using MoveCallback = base::RepeatingCallback<bool(const base::FilePath&,
+                                                   const base::FilePath&)>;
+  static void Attach(DownloadItem& item, MoveCallback callback) {
+    item.SetUserData(&key_, std::make_unique<DownloadPublication>(std::move(callback)));
+  }
+  static bool Move(DownloadItem& item, const base::FilePath& previous,
+                   const base::FilePath& path) {
+    auto* adapter = static_cast<DownloadPublication*>(item.GetUserData(&key_));
+    return adapter && adapter->callback_.Run(previous, path);
+  }
+  explicit DownloadPublication(MoveCallback callback) : callback_(std::move(callback)) {}
+
+ private:
+  inline static constexpr char key_ = 0;
+  MoveCallback callback_;
+};
+}  // namespace download
+#endif  // COMPONENTS_DOWNLOAD_PUBLIC_COMMON_DOWNLOAD_PUBLICATION_H_
