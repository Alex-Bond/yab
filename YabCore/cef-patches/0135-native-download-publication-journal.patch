+bool DownloadItemImpl::UpdatePublishedPath(const base::FilePath& previous_path,
+                                           const base::FilePath& path) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (state_ != COMPLETE_INTERNAL || previous_path != GetFullPath() ||
+      path.empty() || !path.IsAbsolute()) {
+    return false;
+  }
+  destination_info_.target_path = path;
+  SetFullPath(path);
+  display_name_ = path.BaseName();
+  file_externally_removed_ = false;
+  UpdateObservers();
+  return true;
+}
