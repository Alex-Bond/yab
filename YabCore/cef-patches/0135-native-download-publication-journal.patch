+bool CefRequestContextImpl::SetDownloadPublishedPath(
+    int64_t identifier, const CefString& previous_path, const CefString& path) {
+  CEF_REQUIRE_UIT_RETURN(false);
+  auto* context = GetBrowserContext();
+  auto* manager = context ? context->AsBrowserContext()->GetDownloadManager() : nullptr;
+  if (!manager || identifier <= 0 || identifier > UINT32_MAX) return false;
+  auto* item = manager->GetDownload(static_cast<uint32_t>(identifier));
+  // An already-removed item has no journal left to synchronize.
+  return !item || download::DownloadPublication::Move(
+      *item, base::FilePath(previous_path), base::FilePath(path));
+}
