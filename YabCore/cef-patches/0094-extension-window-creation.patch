+// Only Chromium's original windows.create marks a native extension window.
+#ifndef CHROME_BROWSER_EXTENSIONS_EXTERNAL_EXTENSION_WINDOW_H_
+#define CHROME_BROWSER_EXTENSIONS_EXTERNAL_EXTENSION_WINDOW_H_
+#include <memory>
+#include <optional>
+#include "base/supports_user_data.h"
+#include "content/public/browser/web_contents.h"
+namespace extensions {
+class ExternalExtensionWindow : public base::SupportsUserData::Data {
+ public:
+  // The bounds the extension asked for; unset when it gave none.
+  static void Mark(content::WebContents* contents, std::optional<int> left,
+                   std::optional<int> top, std::optional<int> width,
+                   std::optional<int> height) {
+    if (!contents || contents->IsBeingDestroyed()) return;
+    auto window = std::make_unique<ExternalExtensionWindow>();
+    window->left_ = left;
+    window->top_ = top;
+    window->width_ = width;
+    window->height_ = height;
+    contents->SetUserData(&kKey, std::move(window));
+  }
+  static const ExternalExtensionWindow* Get(content::WebContents* contents) {
+    return contents && !contents->IsBeingDestroyed()
+        ? static_cast<ExternalExtensionWindow*>(contents->GetUserData(&kKey))
+        : nullptr;
+  }
+  std::optional<int> left() const { return left_; }
+  std::optional<int> top() const { return top_; }
+  std::optional<int> width() const { return width_; }
+  std::optional<int> height() const { return height_; }
+ private:
+  inline static const int kKey = 0;
+  std::optional<int> left_, top_, width_, height_;
+};
+}  // namespace extensions
+#endif
