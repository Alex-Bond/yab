+namespace {
+// windows.create({type: 'popup'}) from an extension of an embedder that
+// presents bound pages itself. Capture the original native owner as
+// WebAuthFlow does: an action popup's owner, never the popup, which closes
+// once its window shows; a worker's focused owner; else the calling page.
+content::WebContents* ExternalExtensionWindowOwner(
+    content::WebContents* sender, const std::string& extension_id,
+    content::BrowserContext* context) {
+  auto* owner = sender;
+  if (auto* action = sender ? ExternalActionOrigin::Get(sender) : nullptr) {
+    if (action->extension_id() != extension_id) return nullptr;
+    owner = action->Owner(sender);
+  } else if (!sender) {
+    owner = ExternalTabFocus::Get(context);
+  }
+  auto* model = owner ? ExternalTabModel::Get(owner) : nullptr;
+  if (!owner || owner->GetBrowserContext() != context || !model ||
+      !model->embedded() || !ExternalTabWindow::Bound(owner)) {
+    return nullptr;
+  }
+  return owner;
+}
+}  // namespace
