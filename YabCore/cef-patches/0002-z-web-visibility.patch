+namespace {
+class ExternalVisibility
+    : public content::WebContentsObserver,
+      public views::WidgetObserver,
+      public content::WebContentsUserData<ExternalVisibility> {
+ public:
+  void Bind(views::Widget* widget) {
+    observation_.Reset();
+    observation_.Observe(widget);
+    Publish(widget->IsVisible());
+  }
+  void Reset() {
+    observation_.Reset();
+    Publish(std::nullopt);
+  }
+  void OnWidgetVisibilityChanged(views::Widget*, bool visible) override {
+    Publish(visible);
+  }
+  void OnWidgetDestroying(views::Widget*) override {
+    observation_.Reset();
+    Publish(false);
+  }
+  void WebContentsDestroyed() override {
+    observation_.Reset();
+    Observe(nullptr);
+  }
+ private:
+  friend class content::WebContentsUserData<ExternalVisibility>;
+  explicit ExternalVisibility(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<ExternalVisibility>(*contents) {}
+  void Publish(std::optional<bool> visible) {
+    if (!web_contents() || web_contents()->IsBeingDestroyed()) return;
+    auto* view = static_cast<content::WebContentsImpl*>(web_contents())->GetView();
+    if (view)
+      static_cast<content::WebContentsViewMac*>(view)->SetExternalVisibility(visible);
+  }
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ExternalVisibility);
+}  // namespace
+
+void Attach(views::Widget* widget, CefBrowserHostBase* browser) {
+  auto* contents = browser ? browser->GetWebContents() : nullptr;
+  if (!widget || !contents) return;
+  auto* host = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+      widget->GetNativeWindow());
+  if (host && host->externally_hosted()) {
+    ExternalVisibility::GetOrCreateForWebContents(contents)->Bind(widget);
+  } else if (auto* owner = ExternalVisibility::FromWebContents(contents)) {
+    owner->Reset();
+  }
+}
