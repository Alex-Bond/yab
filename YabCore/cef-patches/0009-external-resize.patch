+void CefBrowserContentsDelegate::OnBackgroundColorChanged() {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !web_contents()) return;
+  const auto color = web_contents()->GetBackgroundColor();
+  if (auto c = client()) {
+    if (auto handler = c->GetDisplayHandler()) {
+      handler->OnBackgroundColorChange(browser(), color.value_or(0),
+                                       color.has_value());
+    }
+  }
+}
