+TEST_F(UserMediaIndependentDevicesTest, CameraReachesBrowserWhileMicrophoneWaits) {
+  user_media_client_impl_->RequestUserMediaForTest(AudioRequest());
+  user_media_client_impl_->RequestUserMediaForTest(VideoRequest());
+  EXPECT_EQ(1, audio_dispatcher_.request_stream_counter());
+  EXPECT_EQ(1, video_dispatcher_.request_stream_counter());
+}
+
+TEST_F(UserMediaIndependentDevicesTest, MicrophoneReachesBrowserWhileCameraWaits) {
+  user_media_client_impl_->RequestUserMediaForTest(VideoRequest());
+  user_media_client_impl_->RequestUserMediaForTest(AudioRequest());
+  EXPECT_EQ(1, audio_dispatcher_.request_stream_counter());
+  EXPECT_EQ(1, video_dispatcher_.request_stream_counter());
+}
+
+TEST_F(UserMediaIndependentDevicesTest, SameDeviceRequestsRemainSerialized) {
+  user_media_client_impl_->RequestUserMediaForTest(AudioRequest());
+  user_media_client_impl_->RequestUserMediaForTest(AudioRequest());
+  EXPECT_EQ(1, audio_dispatcher_.request_stream_counter());
+  EXPECT_EQ(0, video_dispatcher_.request_stream_counter());
+}
+
+TEST_F(UserMediaIndependentDevicesTest, CancelOneRequestKeepsTheOtherPending) {
+  auto* audio = AudioRequest();
+  auto* video = VideoRequest();
+  user_media_client_impl_->RequestUserMediaForTest(audio);
+  user_media_client_impl_->RequestUserMediaForTest(video);
+  const int32_t audio_id = audio->request_id();
+  user_media_client_impl_->CancelUserMediaRequest(audio);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_THAT(audio_dispatcher_.cancelled_requests(),
+              ::testing::ElementsAre(audio_id));
+  EXPECT_TRUE(video_dispatcher_.cancelled_requests().empty());
+  EXPECT_EQ(1, video_dispatcher_.request_stream_counter());
+  user_media_client_impl_->RequestUserMediaForTest(AudioRequest());
+  EXPECT_EQ(2, audio_dispatcher_.request_stream_counter());
+}
+
+TEST_F(UserMediaIndependentDevicesTest, DocumentTeardownRetiresBothQueues) {
+  auto* audio = AudioRequest();
+  auto* video = VideoRequest();
+  user_media_client_impl_->RequestUserMediaForTest(audio);
+  user_media_client_impl_->RequestUserMediaForTest(video);
+  const int32_t audio_id = audio->request_id();
+  const int32_t video_id = video->request_id();
+  LoadNewDocumentInFrame();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(user_media_client_impl_->IsCapturing());
+  EXPECT_THAT(audio_dispatcher_.cancelled_requests(),
+              ::testing::ElementsAre(audio_id));
+  EXPECT_THAT(video_dispatcher_.cancelled_requests(),
+              ::testing::ElementsAre(video_id));
+}
 
