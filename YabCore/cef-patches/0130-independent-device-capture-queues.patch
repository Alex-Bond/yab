+// Hold the original dispatcher callbacks, as while a permission card is
+// unanswered. A second device must reach its own original dispatcher now,
+// without granting, completing or cancelling the first request.
+class CaptureQueueDispatcher : public MockMojoMediaStreamDispatcherHost {
+ public:
+  void CancelRequest(int32_t request_id) override {
+    cancelled_requests_.push_back(request_id);
+    MockMojoMediaStreamDispatcherHost::CancelRequest(request_id);
+  }
+  const Vector<int32_t>& cancelled_requests() const {
+    return cancelled_requests_;
+  }
+
+ private:
+  Vector<int32_t> cancelled_requests_;
+};
+
+class UserMediaIndependentDevicesTest : public UserMediaClientTest {
+ public:
+  UserMediaIndependentDevicesTest()
+      : audio_receiver_(&media_devices_dispatcher_),
+        video_receiver_(&media_devices_dispatcher_) {}
+
+  void SetUp() override {
+    UserMediaClientTest::SetUp();
+    user_media_client_impl_->ContextDestroyed();
+    user_media_client_receiver_.reset();
+    auto* frame = &dummy_page_holder_->GetFrame();
+    user_media_processor_ = MakeGarbageCollected<UserMediaProcessorUnderTest>(
+        frame, std::make_unique<WebMediaStreamDeviceObserver>(nullptr),
+        video_receiver_.BindNewPipeAndPassRemote(), &state_);
+    user_media_processor_->set_media_stream_dispatcher_host_for_testing(
+        video_dispatcher_.CreatePendingRemoteAndBind());
+    audio_processor_ = MakeGarbageCollected<UserMediaProcessorUnderTest>(
+        frame, std::make_unique<WebMediaStreamDeviceObserver>(nullptr),
+        audio_receiver_.BindNewPipeAndPassRemote(), &state_);
+    audio_processor_->set_media_stream_dispatcher_host_for_testing(
+        audio_dispatcher_.CreatePendingRemoteAndBind());
+    user_media_client_impl_ = MakeGarbageCollected<UserMediaClientUnderTest>(
+        frame, user_media_processor_, display_user_media_processor_,
+        audio_processor_, &state_);
+    user_media_client_impl_->SetMediaDevicesDispatcherForTesting(
+        user_media_client_receiver_.BindNewPipeAndPassRemote());
+    audio_dispatcher_.DoNotRunCallback();
+    video_dispatcher_.DoNotRunCallback();
+  }
+
+ protected:
+  UserMediaRequest* AudioRequest() {
+    return UserMediaRequest::CreateForTesting(CreateDefaultConstraints(),
+                                               MediaConstraints());
+  }
+  UserMediaRequest* VideoRequest() {
+    return UserMediaRequest::CreateForTesting(MediaConstraints(),
+                                               CreateDefaultConstraints());
+  }
+  CaptureQueueDispatcher audio_dispatcher_;
+  CaptureQueueDispatcher video_dispatcher_;
+  mojo::Receiver<mojom::blink::MediaDevicesDispatcherHost> audio_receiver_;
+  mojo::Receiver<mojom::blink::MediaDevicesDispatcherHost> video_receiver_;
+  WeakPersistent<UserMediaProcessorUnderTest> audio_processor_;
+};
