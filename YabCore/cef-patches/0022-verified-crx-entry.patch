+bool InstallVerifiedCrx(CefBrowserHostBase* owner, const CefString& path,
+                        const CefString& expected,
+                        CefRefPtr<CefExtensionInstallCallback> callback) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !owner || !callback ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch("yab-extension-consent") ||
+      !extensions::GetExternalExtensionHooks().install_consent || Installs().size() >= 8)
+    return false;
+  auto* contents = owner->GetWebContents();
+  if (!contents || contents->IsBeingDestroyed() || !contents->GetPrimaryMainFrame()) return false;
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  const std::string file = path.ToString(), extension = expected.ToString();
+  if (!profile || profile->IsOffTheRecord() || !base::FilePath(file).IsAbsolute() ||
+      file.find('\0') != std::string::npos || !crx_file::id_util::IdIsValid(extension)) return false;
+  const std::string token = base::UnguessableToken::Create().ToString();
+  auto operation = std::make_unique<NativeInstall>(token, contents, profile, extension, callback);
+  auto* begin = operation.get();
+  Installs()[token] = std::move(operation);
+  begin->Begin(profile, base::FilePath(file));
+  return true;
+}
