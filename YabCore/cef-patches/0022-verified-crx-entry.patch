+class NativeInstall;
+using Registry = std::map<std::string, std::unique_ptr<NativeInstall>>;
+Registry& Installs();
+std::unique_ptr<NativeInstall> TakeInstall(const std::string& token);
+
+class NativeInstall : public content::WebContentsObserver, public ProfileObserver {
+ public:
+  NativeInstall(std::string token, content::WebContents* owner, Profile* profile,
+      std::string expected, CefRefPtr<CefExtensionInstallCallback> callback)
+      : content::WebContentsObserver(owner), token_(std::move(token)),
+        expected_(std::move(expected)), callback_(std::move(callback)) {
+    profile_.Observe(profile);
+  }
+  void Begin(Profile* profile, const base::FilePath& path) {
+    auto prompt = VerifiedPrompt::Create(web_contents(),
+        base::BindRepeating([](base::WeakPtr<NativeInstall> self) {
+          return self && self->installer_ ? self->installer_->original_manifest_bytes() : std::string();
+        }, weak_.GetWeakPtr()),
+        base::BindRepeating([](base::WeakPtr<NativeInstall> self) {
+          return self && !self->finished_;
+        }, weak_.GetWeakPtr()),
+        base::BindOnce(&NativeInstall::Approved, weak_.GetWeakPtr()));
+    prompt_ = prompt->GetWeakPtr();
+    installer_ = extensions::CrxInstaller::Create(profile, std::move(prompt));
+    installer_->set_expected_id(expected_);
+    installer_->set_allow_silent_install(false);
+    installer_->set_require_external_consent(true);
+    installer_->set_delete_source(false);
+    installer_->set_is_gallery_install(true);
+    installer_->set_off_store_install_allow_reason(extensions::CrxInstaller::OffStoreInstallDisallowed);
+    installer_->set_was_triggered_by_user_download();
+    installer_->AddInstallerCallback(base::BindOnce(&NativeInstall::Completed, weak_.GetWeakPtr()));
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(FROM_HERE,
+        base::BindOnce(&NativeInstall::ReviewTimeout, weak_.GetWeakPtr()), base::Seconds(120));
+    extensions::CRXFileInfo package(path, crx_file::VerifierFormat::CRX3_WITH_PUBLISHER_PROOF);
+    package.extension_id = expected_;
+    installer_->InstallCrxFile(package);
+  }
+  void PrimaryPageChanged(content::Page&) override { OwnerRetired(); }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override { OwnerRetired(); }
+  void WebContentsDestroyed() override { OwnerRetired(); }
+  void OnProfileWillBeDestroyed(Profile*) override {
+    if (finished_) return;
+    auto self = weak_.GetWeakPtr();
+    if (!authorized_ && prompt_) prompt_->Retire();
+    if (self) self->Finish("cancelled", "Profile retired");
+  }
+ private:
+  void Approved() { authorized_ = true; }
+  void OwnerRetired() {
+    if (authorized_) { Observe(nullptr); return; }  // Chrome now owns this accepted commit.
+    Cancel("Original install owner retired");
+  }
+  void ReviewTimeout() { if (!authorized_) Cancel("Install review timed out"); }
+  void Cancel(const std::string& reason) {
+    if (finished_) return;
+    auto self = weak_.GetWeakPtr();
+    if (prompt_) prompt_->Retire();
+    if (self) self->Finish("cancelled", reason);
+  }
+  void Completed(const std::optional<extensions::CrxInstallError>& error) {
+    if (!error) { Finish("installed", std::string()); return; }
+    bool cancelled = false;
+    if (error->type() == extensions::CrxInstallErrorType::OTHER) {
+      const auto detail = error->detail();
+      cancelled = detail == extensions::CrxInstallErrorDetail::USER_CANCELED ||
+          detail == extensions::CrxInstallErrorDetail::USER_ABORTED ||
+          detail == extensions::CrxInstallErrorDetail::PROFILE_SHUTTING_DOWN;
+    }
+    Finish(cancelled ? "cancelled" : "error", base::UTF16ToUTF8(error->message()));
+  }
+  void Finish(const std::string& status, const std::string& error) {
+    if (finished_) return;
+    finished_ = true;
+    Observe(nullptr); profile_.Reset();
+    auto result = CefDictionaryValue::Create();
+    result->SetString("request", token_);
+    result->SetString("status", status);
+    result->SetString("extensionId", expected_);
+    const auto* extension = installer_ ? installer_->extension() : nullptr;
+    result->SetString("version", status == "installed" && extension ? extension->GetVersionForDisplay() : std::string());
+    result->SetString("error", error);
+    auto callback = std::move(callback_);
+    auto held = TakeInstall(token_);  // Retain this object across client reentrancy.
+    if (callback) callback->OnComplete(result);
+  }
+  const std::string token_, expected_;
+  CefRefPtr<CefExtensionInstallCallback> callback_;
+  scoped_refptr<extensions::CrxInstaller> installer_;
+  base::WeakPtr<VerifiedPrompt> prompt_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_{this};
+  bool authorized_ = false, finished_ = false;
+  base::WeakPtrFactory<NativeInstall> weak_{this};
+};
+Registry& Installs() { static base::NoDestructor<Registry> registry; return *registry; }
+std::unique_ptr<NativeInstall> TakeInstall(const std::string& token) {
+  auto it = Installs().find(token);
+  if (it == Installs().end()) return nullptr;
+  auto held = std::move(it->second); Installs().erase(it); return held;
+}
