+using PromptClient = extensions::ExtensionInstallPromptClient;
+using Payload = PromptClient::DoneCallbackPayload;
+using Result = PromptClient::Result;
+constexpr size_t kMaxManifest = 1024 * 1024;
+struct Bytes { bool ok = false; std::string text; };
+Bytes ReadManifest(base::FilePath path) {
+  Bytes bytes;
+  bytes.ok = base::ReadFileToStringWithMaxSize(path.AppendASCII("manifest.json"), &bytes.text, kMaxManifest);
+  return bytes;
+}
+bool Accepted(Result result) {
+  return result == Result::ACCEPTED || result == Result::ACCEPTED_WITH_WITHHELD_PERMISSIONS;
+}
+
+// Real Chrome prompt, real native warnings and retained verified Extension.
+// The wrapper checks the original document and unchanged sanitized manifest
+// immediately before forwarding a positive reply to the original installer.
+class VerifiedPrompt : public ExtensionInstallPrompt,
+                       public content::WebContentsObserver {
+ public:
+  using Original = base::RepeatingCallback<std::string()>;
+  using Live = base::RepeatingCallback<bool()>;
+  static std::unique_ptr<VerifiedPrompt> Create(content::WebContents* owner,
+      Original original, Live live, base::OnceClosure approved) {
+    auto data = std::make_unique<extensions::InstallPromptData>(
+        extensions::InstallPromptData::UNSET_PROMPT_TYPE);
+    auto* raw = data.get();
+    return std::unique_ptr<VerifiedPrompt>(new VerifiedPrompt(owner, std::move(data), raw,
+        std::move(original), std::move(live), std::move(approved)));
+  }
+  base::WeakPtr<VerifiedPrompt> GetWeakPtr() { return weak_.GetWeakPtr(); }
+  void ConfirmInstall(PromptClient::DoneCallback done,
+                      const extensions::Extension* extension) override {
+    original_done_ = std::move(done);
+    verified_ = extension;
+    const std::string bytes = original_.Run();
+    if (!IsLive() || !extension || bytes.empty() || bytes.size() > kMaxManifest ||
+        !base::IsStringUTF8(bytes)) { Finish(Payload(Result::ABORTED)); return; }
+    prompt_data_->SetVerifiedManifestForExternalReview(bytes,
+        base::BindRepeating([](base::WeakPtr<VerifiedPrompt> self) {
+          return self && self->IsLive();
+        }, weak_.GetWeakPtr()));
+    prompt_data_ = nullptr;  // Base may move/destroy this data during delivery.
+    base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&ReadManifest, verified_->path()),
+        base::BindOnce(&VerifiedPrompt::InitialRead, weak_.GetWeakPtr()));
+  }
+  void Retire() {
+    if (approved_) { Observe(nullptr); return; }
+    retired_ = true;
+    auto* parent = web_contents();
+    Observe(nullptr);
+    auto self = weak_.GetWeakPtr();
+    CancelInstallConsentFor(parent);  // May invoke Finish and destroy this.
+    if (self && !self->original_done_.is_null()) self->Finish(Payload(Result::ABORTED));
+  }
+  void PrimaryPageChanged(content::Page&) override { Retire(); }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override { Retire(); }
+  void WebContentsDestroyed() override { Retire(); }
+ private:
+  VerifiedPrompt(content::WebContents* owner,
+      std::unique_ptr<extensions::InstallPromptData> data,
+      extensions::InstallPromptData* raw, Original original, Live live,
+      base::OnceClosure approved)
+      : ExtensionInstallPrompt(owner, std::move(data)),
+        content::WebContentsObserver(owner), owner_(owner->GetWeakPtr()),
+        document_(owner->GetPrimaryMainFrame()->GetWeakDocumentPtr()),
+        prompt_data_(raw), original_(std::move(original)), operation_live_(std::move(live)),
+        approved_callback_(std::move(approved)) {
+    SetSkipPostInstallUI(true);
+    SetUseAppInstalledBubble(false);
+  }
+  bool IsLive() const {
+    return !retired_ && owner_ && !owner_->IsBeingDestroyed() &&
+        document_.AsRenderFrameHostIfValid() == owner_->GetPrimaryMainFrame() &&
+        !operation_live_.is_null() && operation_live_.Run();
+  }
+  void InitialRead(Bytes bytes) {
+    if (!IsLive() || !bytes.ok) { Finish(Payload(Result::ABORTED)); return; }
+    manifest_ = std::move(bytes.text);
+    ExtensionInstallPrompt::ConfirmInstall(
+        base::BindOnce(&VerifiedPrompt::Answered, weak_.GetWeakPtr()), verified_.get());
+  }
+  void Answered(Payload payload) {
+    if (!Accepted(payload.result)) { Finish(std::move(payload)); return; }
+    if (!IsLive()) { Finish(Payload(Result::ABORTED)); return; }
+    base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&ReadManifest, verified_->path()),
+        base::BindOnce(&VerifiedPrompt::FinalRead, weak_.GetWeakPtr(), std::move(payload)));
+  }
+  void FinalRead(Payload payload, Bytes bytes) {
+    if (!IsLive() || !bytes.ok || bytes.text != manifest_) {
+      Finish(Payload(Result::ABORTED)); return;
+    }
+    approved_ = true;
+    if (!approved_callback_.is_null()) std::move(approved_callback_).Run();
+    Finish(std::move(payload));
+  }
+  void Finish(Payload payload) {
+    auto done = std::move(original_done_);
+    if (!done.is_null()) std::move(done).Run(std::move(payload));
+    // The original installer callback can destroy this client.
+  }
+  base::WeakPtr<content::WebContents> owner_;
+  content::WeakDocumentPtr document_;
+  raw_ptr<extensions::InstallPromptData> prompt_data_;
+  Original original_;
+  Live operation_live_;
+  base::OnceClosure approved_callback_;
+  PromptClient::DoneCallback original_done_;
+  scoped_refptr<const extensions::Extension> verified_;
+  std::string manifest_;
+  bool retired_ = false, approved_ = false;
+  base::WeakPtrFactory<VerifiedPrompt> weak_{this};
+};
