+namespace cef::external_host {
+namespace {
+
+constexpr char kDesktopMediaSwitch[] = "yab-extension-desktop-media";
+constexpr size_t kMaxPending = 16;
+
+using Done = base::OnceCallback<void(const content::DesktopMediaID&)>;
+
+CefRefPtr<CefBrowserProcessHandler> Handler() {
+  auto app = CefAppManager::Get()->GetApplication();
+  return app ? app->GetBrowserProcessHandler() : nullptr;
+}
+
+std::map<std::string, Done>& Pending() {
+  static base::NoDestructor<std::map<std::string, Done>> pending;
+  return *pending;
+}
+
+// What the embedder picked, in the words of patch 0052's display grant:
+// "tab:<browser identifier>", "window:<CGWindowID>", "screen:<CGDirectDisplayID>".
+// Null when it no longer exists, which refuses.
+content::DesktopMediaID Parse(const std::string& source, bool audio) {
+  const auto parts = base::SplitString(source, ":", base::KEEP_WHITESPACE,
+                                       base::SPLIT_WANT_ALL);
+  int64_t id = 0;
+  if (parts.size() != 2 || !base::StringToInt64(parts[1], &id) || id < 0) {
+    return {};
+  }
+  content::DesktopMediaID media;
+  if (parts[0] == "tab") {
+    auto browser =
+        CefBrowserHostBase::GetBrowserForBrowserId(static_cast<int>(id));
+    auto* contents = browser ? browser->GetWebContents() : nullptr;
+    auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+    if (!frame || !frame->IsRenderFrameLive()) {
+      return {};
+    }
+    media = content::DesktopMediaID(
+        content::DesktopMediaID::TYPE_WEB_CONTENTS,
+        content::DesktopMediaID::kNullId,
+        content::WebContentsMediaCaptureId(frame->GetProcess()->GetDeprecatedID(),
+                                           frame->GetRoutingID()));
+    media.audio_share = audio;
+  } else if (parts[0] == "window") {
+    media = content::DesktopMediaID(content::DesktopMediaID::TYPE_WINDOW, id);
+  } else if (parts[0] == "screen") {
+    media = content::DesktopMediaID(content::DesktopMediaID::TYPE_SCREEN, id);
+  }
+  return media;
+}
+
+void Answer(const std::string& token, const std::string& source, bool audio) {
+  auto& pending = Pending();
+  auto found = pending.find(token);
+  if (found == pending.end()) {
+    return;  // Withdrawn or answered already.
+  }
+  Done done = std::move(found->second);
+  pending.erase(found);
+  std::move(done).Run(source.empty() ? content::DesktopMediaID()
+                                     : Parse(source, audio));
+}
+
+class DesktopMediaCallback : public CefExtensionDesktopMediaCallback {
+ public:
+  explicit DesktopMediaCallback(std::string token) : token_(std::move(token)) {}
+  ~DesktopMediaCallback() override { Finish(std::string(), false); }
+  void Choose(const CefString& source, bool audio) override {
+    Finish(source.ToString(), audio);
+  }
+
+ private:
+  void Finish(const std::string& source, bool audio) {
+    if (answered_.exchange(true)) {
+      return;
+    }
+    if (CEF_CURRENTLY_ON_UIT()) {
+      Answer(token_, source, audio);
+    } else {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&Answer, token_, source, audio));
+    }
+  }
+  const std::string token_;
+  std::atomic<bool> answered_{false};
+  IMPLEMENT_REFCOUNTING(DesktopMediaCallback);
+};
+
+// The page the picker is for: |contents| when it is a browser, else the
+// owner of the action popup that called.
+CefRefPtr<CefBrowserHostBase> BrowserFor(content::WebContents* contents) {
+  if (!contents || contents->IsBeingDestroyed()) {
+    return nullptr;
+  }
+  if (auto browser = CefBrowserHostBase::GetBrowserForContents(contents)) {
+    return browser;
+  }
+  auto* origin = extensions::ExternalActionOrigin::Get(contents);
+  auto* owner = origin ? origin->Owner(contents) : nullptr;
+  return owner ? CefBrowserHostBase::GetBrowserForContents(owner) : nullptr;
+}
+
+std::string Choose(content::WebContents* contents,
+                   const extensions::Extension* extension,
+                   const std::string& kinds,
+                   Done done) {
+  auto handler = Handler();
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !handler || !contents ||
+      !extension || Pending().size() >= kMaxPending) {
+    return std::string();
+  }
+  const std::string token = base::UnguessableToken::Create().ToString();
+  auto request = CefDictionaryValue::Create();
+  request->SetString("request", token);
+  request->SetString("extensionId", extension->id());
+  request->SetString("extensionName", extension->name());
+  auto sources = CefListValue::Create();
+  bool audio = false, exclude_self = false;
+  for (const auto& kind : base::SplitString(kinds, ",", base::TRIM_WHITESPACE,
+                                            base::SPLIT_WANT_NONEMPTY)) {
+    if (kind == "audio") {
+      audio = true;
+    } else if (kind == "excludeSelf") {
+      exclude_self = true;
+    } else {
+      sources->SetString(sources->GetSize(), kind);
+    }
+  }
+  request->SetList("sources", sources);
+  request->SetBool("audio", audio);
+  request->SetBool("excludeSelf", exclude_self);
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  request->SetString("profilePath",
+                     profile ? profile->GetPath().AsUTF8Unsafe() : std::string());
+  request->SetBool("offTheRecord", profile && profile->IsOffTheRecord());
+  CefRefPtr<CefBrowser> browser = BrowserFor(contents).get();
+  Pending()[token] = std::move(done);
+  // The answer may come before this returns; Answer() finds the token then.
+  handler->OnExtensionDesktopMedia(browser, request,
+                                   new DesktopMediaCallback(token));
+  // Answered (or refused) synchronously: the extension function has its
+  // reply, and must not wait on a request that no longer exists.
+  return Pending().count(token) ? token : std::string("answered");
+}
+
+void Cancel(const std::string& token) {
+  if (Pending().erase(token)) {
+    if (auto handler = Handler()) {
+      handler->OnExtensionDesktopMediaWithdrawn(token);
+    }
+  }
+}
+
+}  // namespace
+
+void InstallDesktopMediaHooks() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(kDesktopMediaSwitch)) {
+    return;
+  }
+  auto& hooks = extensions::GetExternalExtensionHooks();
+  hooks.desktop_media_choose = &Choose;
+  hooks.desktop_media_cancel = &Cancel;
+}
+
