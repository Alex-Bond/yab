@@ -0,0 +1,113 @@
+#include "external_capture.h"
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/media/webrtc/media_capture_devices_dispatcher.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+CefExternalCapture::CefExternalCapture(content::WebContents* contents,
+    Changed changed) : content::WebContentsObserver(contents),
+    changed_(std::move(changed)),
+    indicator_(MediaCaptureDevicesDispatcher::GetInstance()->GetMediaStreamCaptureIndicator()) {
+  indicator_->AddObserver(this);
+  PictureInPictureWindowManager::GetInstance()->AddObserver(this);
+  SchedulePublish();
+}
+CefExternalCapture::~CefExternalCapture() { Detach(); }
+void CefExternalCapture::Detach() {
+  if (!attached_) return;
+  attached_ = false;
+  indicator_->RemoveObserver(this);
+  PictureInPictureWindowManager::GetInstance()->RemoveObserver(this);
+  weak_.InvalidateWeakPtrs();
+  publish_pending_ = false;
+}
+CefRefPtr<CefDictionaryValue> CefExternalCapture::State() {
+  auto state = CefDictionaryValue::Create();
+  state->SetInt("version", 1);
+  state->SetString("scope", "browser");
+  state->SetBool("known", false);
+  auto* contents = web_contents();
+  auto* frame = contents && !contents->IsBeingDestroyed() ? contents->GetPrimaryMainFrame() : nullptr;
+  if (!attached_ || !frame || !frame->IsActive() || !frame->IsRenderFrameLive()) {
+    token_ = {}; document_ = {};
+    return state;
+  }
+  if (token_.is_empty() || document_.AsRenderFrameHostIfValid() != frame) {
+    document_ = frame->GetWeakDocumentPtr();
+    token_ = base::UnguessableToken::Create();
+  }
+  state->SetBool("known", true);
+  state->SetString("token", token_.ToString());
+  state->SetString("primaryDocument", static_cast<content::RenderFrameHostImpl*>(frame)->GetDocumentToken().ToString());
+  state->SetString("primaryFrameId", frame->GetDevToolsFrameToken().ToString());
+  state->SetBool("camera", indicator_->IsCapturingVideo(contents));
+  state->SetBool("microphone", indicator_->IsCapturingAudio(contents));
+  state->SetBool("tab", indicator_->IsCapturingTab(contents));
+  state->SetBool("window", indicator_->IsCapturingWindow(contents));
+  state->SetBool("display", indicator_->IsCapturingDisplay(contents));
+  state->SetBool("allScreens", indicator_->IsCapturingAllScreens(contents));
+  state->SetBool("screen", indicator_->IsCapturingTab(contents) ||
+      indicator_->IsCapturingWindow(contents) || indicator_->IsCapturingDisplay(contents) ||
+      indicator_->IsCapturingAllScreens(contents));
+  state->SetBool("mirrored", indicator_->IsBeingMirrored(contents));
+  state->SetBool("videoPiP", contents->HasPictureInPictureVideo());
+  state->SetBool("documentPiP", contents->HasPictureInPictureDocument());
+  // Do not mislabel site-declared MediaSession microphone/camera status as
+  // the native device's actual mute state. Unknown remains explicit.
+  state->SetString("microphoneMuted", "unknown");
+  state->SetString("cameraMuted", "unknown");
+  auto actions = CefListValue::Create();
+  if (indicator_->IsCapturingUserMedia(contents)) actions->SetString(actions->GetSize(), "stopUserMedia");
+  if (state->GetBool("screen") && !state->GetBool("allScreens")) actions->SetString(actions->GetSize(), "stopScreen");
+  state->SetList("actions", actions);
+  return state;
+}
+bool CefExternalCapture::Stop(const std::string& token, const std::string& kind) {
+  auto state = State();
+  if (token.empty() || !state->GetBool("known") || state->GetString("token").ToString() != token) return false;
+  int type = 0;
+  if (kind == "userMedia" && (state->GetBool("camera") || state->GetBool("microphone")))
+    type = MediaStreamCaptureIndicator::kUserMedia;
+  else if (kind == "screen" && state->GetBool("screen") && !state->GetBool("allScreens"))
+    type = MediaStreamCaptureIndicator::kDisplayMedia;
+  if (!type) return false;
+  // Stop is scoped to the authenticated browser. This is a dispatch receipt;
+  // completion arrives from the original native indicator, never inferred.
+  indicator_->StopMediaCapturing(web_contents(), type);
+  SchedulePublish();
+  return true;
+}
+void CefExternalCapture::SchedulePublish() {
+  if (!attached_ || publish_pending_) return;
+  publish_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce(&CefExternalCapture::Publish, weak_.GetWeakPtr()));
+}
+void CefExternalCapture::Publish() {
+  publish_pending_ = false;
+  changed_.Run(State());
+}
+void CefExternalCapture::OnIsCapturingVideoChanged(content::WebContents*, bool) { SchedulePublish(); }
+void CefExternalCapture::OnIsCapturingAudioChanged(content::WebContents*, bool) { SchedulePublish(); }
+void CefExternalCapture::OnIsBeingMirroredChanged(content::WebContents*, bool) { SchedulePublish(); }
+void CefExternalCapture::OnIsCapturingTabChanged(content::WebContents*, bool) { SchedulePublish(); }
+void CefExternalCapture::OnIsCapturingWindowChanged(content::WebContents*, bool) { SchedulePublish(); }
+void CefExternalCapture::OnIsCapturingDisplayChanged(content::WebContents*, bool) { SchedulePublish(); }
+void CefExternalCapture::OnEnterPictureInPicture() { SchedulePublish(); }
+void CefExternalCapture::OnExitPictureInPicture() { SchedulePublish(); }
+void CefExternalCapture::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (handle->HasCommitted() && handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+    token_ = {}; document_ = {};
+  }
+  SchedulePublish();
+}
+void CefExternalCapture::PrimaryMainFrameRenderProcessGone(base::TerminationStatus) {
+  token_ = {}; document_ = {}; SchedulePublish();
+}
+void CefExternalCapture::WebContentsDestroyed() {
+  Detach(); Observe(nullptr); token_ = {}; document_ = {};
+  changed_.Run(State());
+}
