+#ifndef CEF_LIBCEF_BROWSER_EXTERNAL_MEDIA_STREAM_UI_H_
+#define CEF_LIBCEF_BROWSER_EXTERNAL_MEDIA_STREAM_UI_H_
+#include <memory>
+#include <utility>
+#include "content/public/browser/media_stream_request.h"
+// Preserve CEF's original stream notification UI and Chrome's authoritative
+// device/stop registration on the same original native stream lifetime.
+class CefCaptureRegistrationUI final : public content::MediaStreamUI {
+ public:
+  CefCaptureRegistrationUI(std::unique_ptr<content::MediaStreamUI> indicator,
+      std::unique_ptr<content::MediaStreamUI> legacy)
+      :indicator_(std::move(indicator)),legacy_(std::move(legacy)) {}
+  gfx::NativeViewId OnStarted(base::RepeatingClosure stop,SourceCallback source,
+      const std::string& label,std::vector<content::DesktopMediaID> ids,
+      StateChangeCallback change) override {
+    if(started_)return 0;
+    started_=true;
+    gfx::NativeViewId native=indicator_?indicator_->OnStarted(stop,source,label,ids,change):0;
+    gfx::NativeViewId legacy=legacy_?legacy_->OnStarted(stop,std::move(source),label,std::move(ids),std::move(change)):0;
+    return legacy?legacy:native;
+  }
+  void OnDeviceStoppedForSourceChange(const std::string& label,
+      const content::DesktopMediaID& old_id,const content::DesktopMediaID& new_id,
+      bool captured_surface_control_active) override {
+    if(indicator_)indicator_->OnDeviceStoppedForSourceChange(label,old_id,new_id,captured_surface_control_active);
+    if(legacy_)legacy_->OnDeviceStoppedForSourceChange(label,old_id,new_id,captured_surface_control_active);
+  }
+  void OnDeviceStopped(const std::string& label,const content::DesktopMediaID& id) override {
+    if(indicator_)indicator_->OnDeviceStopped(label,id);
+    if(legacy_)legacy_->OnDeviceStopped(label,id);
+  }
+ private:
+  bool started_=false;
+  std::unique_ptr<content::MediaStreamUI> indicator_,legacy_;
+};
+#endif
