+// Native browser-scoped capture activity. Per-track mute is a separate API.
+#ifndef CEF_LIBCEF_BROWSER_EXTERNAL_CAPTURE_H_
+#define CEF_LIBCEF_BROWSER_EXTERNAL_CAPTURE_H_
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/unguessable_token.h"
+#include "cef/include/cef_values.h"
+#include "chrome/browser/media/webrtc/media_stream_capture_indicator.h"
+#include "chrome/browser/picture_in_picture/picture_in_picture_window_manager.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+
+class CefExternalCapture final : public content::WebContentsObserver,
+    public MediaStreamCaptureIndicator::Observer,
+    public PictureInPictureWindowManager::Observer {
+ public:
+  using Changed = base::RepeatingCallback<void(CefRefPtr<CefDictionaryValue>)>;
+  CefExternalCapture(content::WebContents* contents, Changed changed);
+  ~CefExternalCapture() override;
+  CefRefPtr<CefDictionaryValue> State();
+  bool Stop(const std::string& token, const std::string& kind);
+  void OnIsCapturingVideoChanged(content::WebContents*, bool) override;
+  void OnIsCapturingAudioChanged(content::WebContents*, bool) override;
+  void OnIsBeingMirroredChanged(content::WebContents*, bool) override;
+  void OnIsCapturingTabChanged(content::WebContents*, bool) override;
+  void OnIsCapturingWindowChanged(content::WebContents*, bool) override;
+  void OnIsCapturingDisplayChanged(content::WebContents*, bool) override;
+  void OnEnterPictureInPicture() override;
+  void OnExitPictureInPicture() override;
+  void DidFinishNavigation(content::NavigationHandle*) override;
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override;
+  void WebContentsDestroyed() override;
+ private:
+  void SchedulePublish();
+  void Publish();
+  void Detach();
+  Changed changed_;
+  scoped_refptr<MediaStreamCaptureIndicator> indicator_;
+  content::WeakDocumentPtr document_;
+  base::UnguessableToken token_;
+  bool attached_ = true;
+  bool publish_pending_ = false;
+  base::WeakPtrFactory<CefExternalCapture> weak_{this};
+};
+#endif
