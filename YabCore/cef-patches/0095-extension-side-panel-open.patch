+// An embedder that presents bound pages in its own UI also shows their
+// extension side panels itself: Chrome's panel would open in the concealed
+// physical Browser nobody sees. Only the extension's own pages are handed
+// over. Ordinary Chrome has no hook and no bound page, and keeps its path.
+bool OpenExternalSidePanel(const Extension& extension,
+                           content::WebContents* tab,
+                           const api::side_panel::PanelOptions& options) {
+  auto hook = GetExternalExtensionHooks().side_panel_open;
+  if (!hook || !tab || tab->IsBeingDestroyed() ||
+      !ExternalTabWindow::Bound(tab) || !options.path) {
+    return false;
+  }
+  // As the side panel coordinator resolves it, minus web URLs.
+  const GURL url = extension.ResolveExtensionURL(*options.path);
+  if (!url.is_valid() || !url.SchemeIs(kExtensionScheme) ||
+      url.host() != extension.id()) {
+    return false;
+  }
+  return hook(tab, extension.id(), url);
+}
+
+// The page a window-level open is for: with bound pages, the embedder's
+// logical active page of that window (patch 0019), not the physical one.
+content::WebContents* ExternalActivePage(content::WebContents* active) {
+  auto* model = ExternalTabModel::Get(active);
+  if (!model) {
+    return active;
+  }
+  for (auto* tab : model->tabs()) {
+    auto* candidate = ExternalTabModel::Get(tab);
+    if (candidate && candidate->active()) {
+      return tab;
+    }
+  }
+  return active;
+}
+#endif
