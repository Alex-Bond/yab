+// chrome.sidePanel.open() for a page the client presents: the client shows
+// the extension's panel for that page, as with "activate" above, on the
+// page's own browser. Without a display handler Chrome keeps its own path.
+bool SidePanelOpen(content::WebContents* contents,
+                   const std::string& extension_id, const GURL& panel_url) {
+  if (!contents || contents->IsBeingDestroyed() || extension_id.empty() ||
+      !panel_url.is_valid())
+    return false;
+  CefRefPtr<CefBrowserHostBase> browser;
+  auto handler = DisplayHandlerFor(contents, &browser);
+  if (!handler || !browser) return false;
+  auto value = CefDictionaryValue::Create();
+  value->SetString("requestedKind", "sidePanel");
+  value->SetString("extensionId", extension_id);
+  value->SetString("panelURL", panel_url.spec());
+  handler->OnExtensionTabCreated(browser.get(), value);
+  return true;
+}
