+// Chromium's WebAuthn requests, once Chromium's own checks pass, answered by
+// the embedder with UI of its own instead of Chromium's authenticator dialog.
+#ifndef CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_WEBAUTHN_H_
+#define CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_WEBAUTHN_H_
+#pragma once
+
+namespace cef::external_host {
+// Sets content's embedder WebAuthn request proxy (idempotent). Every create,
+// get and isUVPAA request of every profile then reaches
+// CefBrowserProcessHandler::OnWebAuthnRequest; with no handler, or one that
+// declines, it fails with NotAllowedError. Chromium's own authenticator UI
+// never shows. UI thread.
+void InstallWebAuthnProxy();
+}  // namespace cef::external_host
+
+#endif  // CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_WEBAUTHN_H_
