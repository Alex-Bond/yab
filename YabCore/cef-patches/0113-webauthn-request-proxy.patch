+namespace cef::external_host {
+namespace {
+
+using content::WebAuthenticationRequestProxy;
+using RequestId = WebAuthenticationRequestProxy::RequestId;
+using Pending = std::variant<WebAuthenticationRequestProxy::CreateCallback,
+                             WebAuthenticationRequestProxy::GetCallback,
+                             WebAuthenticationRequestProxy::IsUvpaaCallback>;
+
+constexpr char kNotAllowed[] = "NotAllowedError";
+constexpr char kNotAllowedMessage[] =
+    "The operation either timed out or was not allowed. See: "
+    "https://www.w3.org/TR/webauthn-2/#sctn-privacy-considerations-client.";
+
+void Answer(RequestId id,
+            std::string response,
+            std::string error_name,
+            std::string error_message);
+
+// Answers one request. The first Respond counts; a callback released
+// unanswered fails its request with NotAllowedError. Any thread; the answer
+// always reaches Chromium on a later UI task, never from inside
+// Signal*Request, which sets the request's pending id only once it returns.
+class WebAuthnCallback : public CefWebAuthnCallback {
+ public:
+  explicit WebAuthnCallback(RequestId id) : id_(id) {}
+  ~WebAuthnCallback() override { Finish("", kNotAllowed, kNotAllowedMessage); }
+  void Respond(const CefString& response,
+               const CefString& error_name,
+               const CefString& error_message) override {
+    Finish(response.ToString(), error_name.ToString(),
+           error_message.ToString());
+  }
+
+ private:
+  void Finish(std::string response, std::string name, std::string message) {
+    if (answered_.exchange(true)) {
+      return;
+    }
+    CEF_POST_TASK(CEF_UIT,
+                  base::BindOnce(&Answer, id_, std::move(response),
+                                 std::move(name), std::move(message)));
+  }
+  const RequestId id_;
+  std::atomic<bool> answered_{false};
+  IMPLEMENT_REFCOUNTING(WebAuthnCallback);
+};
+
+CefRefPtr<CefBrowserProcessHandler> Handler() {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL)) {
+    return nullptr;
+  }
+  auto app = CefAppManager::Get()->GetApplication();
+  return app ? app->GetBrowserProcessHandler() : nullptr;
+}
+
+const char* ViewTypeName(content::WebContents* contents) {
+  switch (extensions::GetViewType(contents)) {
+    case extensions::mojom::ViewType::kTabContents:
+      return "tab";
+    case extensions::mojom::ViewType::kExtensionPopup:
+      return "popup";
+    case extensions::mojom::ViewType::kAppWindow:
+      return "appWindow";
+    case extensions::mojom::ViewType::kExtensionSidePanel:
+      return "sidePanel";
+    case extensions::mojom::ViewType::kExtensionBackgroundPage:
+      return "background";
+    case extensions::mojom::ViewType::kOffscreenDocument:
+      return "offscreen";
+    default:
+      return "other";
+  }
+}
+
+// Only the DOMException names WebAuthn rejects with; anything else a client
+// names is NotAllowedError, as an unexplained failure is to a site.
+bool KnownErrorName(const std::string& name) {
+  return name == kNotAllowed || name == "InvalidStateError" ||
+         name == "SecurityError" || name == "AbortError" ||
+         name == "NotSupportedError" || name == "ConstraintError" ||
+         name == "UnknownError";
+}
+
+blink::mojom::WebAuthnDOMExceptionDetailsPtr Details(std::string name,
+                                                     std::string message) {
+  if (!KnownErrorName(name)) {
+    name = kNotAllowed;
+    message = kNotAllowedMessage;
+  }
+  return blink::mojom::WebAuthnDOMExceptionDetails::New(std::move(name),
+                                                        std::move(message));
+}
+
+class Proxy : public WebAuthenticationRequestProxy {
+ public:
+  bool IsActive(const url::Origin& caller_origin) override { return true; }
+
+  void SetRequestFrame(content::RenderFrameHost* frame) override {
+    frame_ = frame ? frame->GetGlobalId() : content::GlobalRenderFrameHostId();
+  }
+
+  RequestId SignalCreateRequest(
+      const blink::mojom::PublicKeyCredentialCreationOptionsPtr& options,
+      CreateCallback callback) override {
+    return Start("create", webauthn::ToValue(options),
+                 options->remote_desktop_client_override.get(),
+                 Pending(std::move(callback)));
+  }
+
+  RequestId SignalGetRequest(
+      const blink::mojom::PublicKeyCredentialRequestOptionsPtr& options,
+      GetCallback callback) override {
+    return Start("get", webauthn::ToValue(options),
+                 options->extensions->remote_desktop_client_override.get(),
+                 Pending(std::move(callback)));
+  }
+
+  RequestId SignalIsUvpaaRequest(IsUvpaaCallback callback) override {
+    return Start("isUvpaa", base::Value(base::Value::Type::DICT), nullptr,
+                 Pending(std::move(callback)));
+  }
+
+  void CancelRequest(RequestId id) override {
+    if (!pending_.erase(id)) {
+      return;
+    }
+    if (auto handler = Handler()) {
+      handler->OnWebAuthnRequestCanceled(base::NumberToString(id));
+    }
+  }
+
+  void Finish(RequestId id,
+              const std::string& response,
+              std::string name,
+              std::string message) {
+    auto node = pending_.extract(id);
+    if (node.empty()) {
+      return;  // Cancelled meanwhile: Chromium has answered the page.
+    }
+    Pending callback = std::move(node.mapped());
+    if (auto* uvpaa = std::get_if<IsUvpaaCallback>(&callback)) {
+      std::move(*uvpaa).Run(name.empty() && response == "true");
+      return;
+    }
+    std::optional<base::Value> value;
+    if (name.empty()) {
+      value = base::JSONReader::Read(response, base::JSON_PARSE_RFC);
+    }
+    if (auto* create = std::get_if<CreateCallback>(&callback)) {
+      if (value) {
+        auto [made, why] = webauthn::MakeCredentialResponseFromValue(*value);
+        if (made) {
+          std::move(*create).Run(id, nullptr, std::move(made));
+          return;
+        }
+        LOG(WARNING) << "Yab WebAuthn: unusable create answer: " << why;
+      }
+      std::move(*create).Run(id, Details(std::move(name), std::move(message)),
+                             nullptr);
+      return;
+    }
+    auto& get = std::get<GetCallback>(callback);
+    if (value) {
+      auto [got, why] = webauthn::GetAssertionResponseFromValue(*value);
+      if (got) {
+        std::move(get).Run(id, nullptr, std::move(got));
+        return;
+      }
+      LOG(WARNING) << "Yab WebAuthn: unusable get answer: " << why;
+    }
+    std::move(get).Run(id, Details(std::move(name), std::move(message)),
+                       nullptr);
+  }
+
+ private:
+  RequestId Start(const char* kind,
+                  base::Value options,
+                  const blink::mojom::RemoteDesktopClientOverride* caller,
+                  Pending callback) {
+    const RequestId id = ++next_id_;
+    const content::GlobalRenderFrameHostId frame =
+        std::exchange(frame_, content::GlobalRenderFrameHostId());
+    pending_.emplace(id, std::move(callback));
+    CefRefPtr<WebAuthnCallback> answer = new WebAuthnCallback(id);
+
+    auto* rfh = content::RenderFrameHost::FromID(frame);
+    auto* contents = rfh ? content::WebContents::FromRenderFrameHost(rfh)
+                         : nullptr;
+    auto handler = Handler();
+    if (!contents || !handler) {
+      // Nobody to ask: refused, as Chromium's own UI would stand in a
+      // window nobody sees. The callback's release answers.
+      return id;
+    }
+
+    // The extension the request was rewritten for is Chromium's business;
+    // the client gets the caller's origin separately.
+    if (base::DictValue* dict = options.GetIfDict()) {
+      if (base::DictValue* extensions = dict->FindDict("extensions")) {
+        extensions->Remove("remoteDesktopClientOverride");
+        if (extensions->empty()) {
+          dict->Remove("extensions");
+        }
+      }
+    }
+
+    content::RenderFrameHost* top = rfh->GetOutermostMainFrame();
+    const url::Origin top_origin = top->GetLastCommittedOrigin();
+    auto request = CefDictionaryValue::Create();
+    request->SetString("request", base::NumberToString(id));
+    request->SetString("kind", kind);
+    // The origin Chromium verified the request against (rpId, iframe
+    // permissions, related origins), never one the page states.
+    request->SetString("origin", caller ? caller->origin.Serialize()
+                                        : rfh->GetLastCommittedOrigin()
+                                              .Serialize());
+    request->SetBool("sameOriginWithAncestors",
+                     caller ? caller->same_origin_with_ancestors : true);
+    request->SetString("topOrigin", top_origin.Serialize());
+    request->SetBool("mainFrame", rfh == top);
+    request->SetString("options",
+                       base::WriteJson(options).value_or(std::string("{}")));
+    content::BrowserContext* context = contents->GetBrowserContext();
+    request->SetString("profilePath", context->GetPath().value());
+    request->SetBool("offTheRecord", context->IsOffTheRecord());
+    request->SetString("viewType", ViewTypeName(contents));
+    const GURL top_url = top->GetLastCommittedURL();
+    if (top_url.SchemeIs(extensions::kExtensionScheme)) {
+      request->SetString("extensionId", top_url.GetHost());
+    }
+
+    CefRefPtr<CefBrowser> browser =
+        CefBrowserHostBase::GetBrowserForContents(contents).get();
+    if (!handler->OnWebAuthnRequest(browser, request, answer.get())) {
+      answer->Respond(CefString(), kNotAllowed, kNotAllowedMessage);
+    }
+    return id;
+  }
+
+  std::map<RequestId, Pending> pending_;
+  RequestId next_id_ = 0;
+  content::GlobalRenderFrameHostId frame_;
+};
+
+Proxy& GetProxy() {
+  static base::NoDestructor<Proxy> proxy;
+  return *proxy;
+}
+
+void Answer(RequestId id,
+            std::string response,
+            std::string error_name,
+            std::string error_message) {
+  GetProxy().Finish(id, response, std::move(error_name),
+                    std::move(error_message));
+}
+
+}  // namespace
+
+void InstallWebAuthnProxy() {
+  content::SetEmbedderWebAuthenticationRequestProxy(&GetProxy());
+}
+
+}  // namespace cef::external_host
