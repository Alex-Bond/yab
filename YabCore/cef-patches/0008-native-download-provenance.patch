+
+CefString CefDownloadItemImpl::GetRequestInitiator() {
+  CEF_VALUE_VERIFY_RETURN(false, CefString());
+  const auto& origin = const_value().GetRequestInitiator();
+  if (!origin || origin->opaque()) {
+    return CefString();
+  }
+  return origin->Serialize();
+}
+
+CefString CefDownloadItemImpl::GetTabURL() {
+  CEF_VALUE_VERIFY_RETURN(false, CefString());
+  return const_value().GetTabUrl().spec();
+}
