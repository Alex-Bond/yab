+
+// Chrome's startup ends (the after-startup queue and the BEST_EFFORT fence of
+// AfterStartupTaskUtils) on its startup tab: first painted, or loaded and
+// idle. CEF opens no such tab, and an embedder's pages come later, often
+// hidden first, so only a visible page left to settle, or the 3-minute
+// failsafe, ended it: native hosts' kills, CEF's background runner and every
+// other BEST_EFFORT task waited for that. The embedder's first page painted
+// while visible is its startup's end.
+static void MaybeEndStartup(content::WebContents* contents) {
+  if (!AfterStartupTaskUtils::IsBrowserStartupComplete() &&
+      contents->GetVisibility() == content::Visibility::VISIBLE &&
+      contents->CompletedFirstVisuallyNonEmptyPaint()) {
+    AfterStartupTaskUtils::SetEmbedderFirstPagePainted();
+  }
+}
+
+void CefBrowserContentsDelegate::DidFirstVisuallyNonEmptyPaint() {
+  MaybeEndStartup(web_contents());
+}
+
+void CefBrowserContentsDelegate::OnVisibilityChanged(
+    content::Visibility visibility) {
+  MaybeEndStartup(web_contents());
 }
 
