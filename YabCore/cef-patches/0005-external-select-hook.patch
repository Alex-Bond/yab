+void RenderWidgetHostViewMac::ShowExternalSelect(
+    remote_cocoa::mojom::PopupMenuPtr menu,
+    base::OnceCallback<void(std::optional<uint32_t>)> closed) {
+  // Snapshot the callback; the external handler can dismiss its owner.
+  auto handler = external_select_callback_;
+  if (handler) {
+    handler.Run(std::move(menu), std::move(closed));
+  } else {
+    std::move(closed).Run(std::nullopt);
+  }
+}
