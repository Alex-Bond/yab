+// Embedder print UI for page-initiated prints.
+#ifndef CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_PRINT_H_
+#define CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_PRINT_H_
+#pragma once
+
+#include <string>
+
+namespace content {
+class WebContents;
+}
+
+namespace cef::external_host {
+// Sets Chrome's print hook when the process runs with --yab-native-print
+// (idempotent). UI thread.
+void InstallPrintHooks();
+// Finishes the print request |token| of |contents|. False if unknown.
+bool FinishPrint(content::WebContents* contents, const std::string& token);
+}  // namespace cef::external_host
+
+#endif  // CEF_LIBCEF_BROWSER_VIEWS_EXTERNAL_PRINT_H_
--- /dev/null
+++ b/cef/libcef/browser/views/external_print.cc
@@ -0,0 +1,137 @@
+#include "cef/libcef/browser/views/external_print.h"
+
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/functional/callback.h"
+#include "base/unguessable_token.h"
+#include "cef/include/cef_display_handler.h"
+#include "cef/include/cef_values.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/common/api_version_util.h"
+#include "chrome/browser/extensions/external_action_origin.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace cef::external_host {
+namespace {
+
+constexpr char kPrintSwitch[] = "yab-native-print";
+constexpr size_t kMaxPending = 4;
+
+CefRefPtr<CefDisplayHandler> DisplayHandler(content::WebContents* contents,
+                                            CefRefPtr<CefBrowserHostBase>* browser) {
+  *browser = CefBrowserHostBase::GetBrowserForContents(contents);
+  auto client = *browser ? (*browser)->client() : nullptr;
+  return client ? client->GetDisplayHandler() : nullptr;
+}
+
+// Page-initiated print requests waiting for the embedder, per WebContents.
+// Each holds the closure that ends Chromium's original request.
+class ExternalPrint : public content::WebContentsObserver,
+                      public content::WebContentsUserData<ExternalPrint> {
+ public:
+  size_t size() const { return pending_.size(); }
+
+  std::string Add(base::OnceClosure done, content::RenderFrameHost* frame) {
+    std::string token = base::UnguessableToken::Create().ToString();
+    pending_[token] = Entry{std::move(done), frame->GetGlobalId()};
+    return token;
+  }
+
+  bool Finish(const std::string& token) {
+    auto found = pending_.find(token);
+    if (found == pending_.end()) return false;
+    auto done = std::move(found->second.done);
+    pending_.erase(found);
+    std::move(done).Run();
+    return true;
+  }
+
+  // Chromium dropped the document: finish what is pending and say so.
+  void WithdrawAll(const content::GlobalRenderFrameHostId* only_frame) {
+    std::vector<std::string> tokens;
+    for (auto& [token, entry] : pending_) {
+      if (!only_frame || entry.frame == *only_frame) tokens.push_back(token);
+    }
+    for (const auto& token : tokens) {
+      auto found = pending_.find(token);
+      if (found == pending_.end()) continue;
+      auto done = std::move(found->second.done);
+      pending_.erase(found);
+      std::move(done).Run();
+      CefRefPtr<CefBrowserHostBase> browser;
+      if (web_contents()) {
+        if (auto handler = DisplayHandler(web_contents(), &browser)) {
+          handler->OnPrintRequestWithdrawn(browser.get(), token);
+        }
+      }
+    }
+  }
+
+  // WebContentsObserver:
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override {
+    auto id = frame->GetGlobalId();
+    WithdrawAll(&id);
+  }
+  void PrimaryPageChanged(content::Page&) override { WithdrawAll(nullptr); }
+  void WebContentsDestroyed() override { WithdrawAll(nullptr); }
+
+ private:
+  friend class content::WebContentsUserData<ExternalPrint>;
+  explicit ExternalPrint(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<ExternalPrint>(*contents) {}
+  struct Entry {
+    base::OnceClosure done;
+    content::GlobalRenderFrameHostId frame;
+  };
+  std::map<std::string, Entry> pending_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ExternalPrint);
+
+bool PrintRequest(content::WebContents* contents,
+                  content::RenderFrameHost* frame,
+                  bool scripted,
+                  base::OnceClosure done) {
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL) || !contents || !frame) return false;
+  CefRefPtr<CefBrowserHostBase> browser;
+  auto handler = DisplayHandler(contents, &browser);
+  if (!handler) return false;
+  auto* print = ExternalPrint::GetOrCreateForWebContents(contents);
+  // Past the limit Chrome's own preview takes over rather than piling up.
+  if (print->size() >= kMaxPending) return false;
+  const std::string token = print->Add(std::move(done), frame);
+  auto request = CefDictionaryValue::Create();
+  request->SetString("request", token);
+  request->SetBool("scripted", scripted);
+  request->SetString("url", frame->GetLastCommittedURL().spec());
+  request->SetBool("mainFrame", frame->IsInPrimaryMainFrame());
+  request->SetBool("pdf", frame->GetProcess()->IsPdf());
+  handler->OnPrintRequest(browser.get(), request);
+  return true;
+}
+
+}  // namespace
+
+void InstallPrintHooks() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(kPrintSwitch)) return;
+  extensions::GetExternalExtensionHooks().print_request = &PrintRequest;
+}
+
+bool FinishPrint(content::WebContents* contents, const std::string& token) {
+  auto* print = ExternalPrint::FromWebContents(contents);
+  return print && print->Finish(token);
+}
+
+}  // namespace cef::external_host
