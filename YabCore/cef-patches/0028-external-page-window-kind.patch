+// A bound external page is presented in the embedder's ordinary browser UI.
+// CEF internally uses TYPE_POPUP to suppress Chrome controls; that concealed
+// producer type is not the logical window kind extensions should query.
+class ExternalTabWindow : public base::SupportsUserData::Data {
+ public:
+  static void Set(content::WebContents* contents, bool bound) {
+    if (!contents) return;
+    if (bound && !contents->IsBeingDestroyed())
+      contents->SetUserData(&kKey, std::make_unique<ExternalTabWindow>());
+    else
+      contents->RemoveUserData(&kKey);
+  }
+  static bool Bound(content::WebContents* contents) {
+    return contents && !contents->IsBeingDestroyed() && contents->GetUserData(&kKey);
+  }
+ private:
+  inline static const int kKey = 0;
 };
