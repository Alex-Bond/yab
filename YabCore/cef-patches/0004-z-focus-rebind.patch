+namespace {
+// WebContents owns this state; the native owner is weak. Never retain a
+// CefBrowserView here, which could form a BrowserView/browser ownership cycle.
+class ExternalFocus : public content::WebContentsObserver,
+                      public views::WidgetObserver,
+                      public content::WebContentsUserData<ExternalFocus> {
+ public:
+  bool Set(views::Widget* widget, bool focused) {
+    if (!widget) return false;
+    auto self = weak_factory_.GetWeakPtr();
+    auto next_widget = widget->GetWeakPtr();
+    if (widget_ && widget_.get() != widget) {
+      desired_ = false;
+      Apply();
+      if (!self || !next_widget) return false;
+    }
+    if (widget_.get() != widget) {
+      observation_.Reset();
+      widget_ = widget->GetWeakPtr();
+      observation_.Observe(widget);
+    }
+    desired_ = focused;
+    const bool applied = Apply();
+    if (!self) return false;
+    if (applied) return true;
+    desired_ = false;
+    return false;
+  }
+  void OnWidgetDestroying(views::Widget*) override {
+    desired_ = false;
+    weak_factory_.InvalidateWeakPtrs();
+    observation_.Reset();
+    widget_.reset();
+    // Detach before native focus dispatch, which can destroy this owner.
+    // The native widget is already tearing down. Clear only its surviving
+    // renderer-side override; do not query its native window here.
+    auto* view = web_contents() ? web_contents()->GetRenderWidgetHostView() : nullptr;
+    if (view && !static_cast<content::RenderWidgetHostViewBase*>(view)
+                     ->IsRenderWidgetHostViewChildFrame())
+      static_cast<content::RenderWidgetHostViewMac*>(view)->SetExternalHostFocus(false);
+  }
+  void OnWidgetVisibilityChanged(views::Widget*, bool visible) override {
+    if (!visible) {
+      desired_ = false;
+      Apply();
+    }
+  }
+  void RenderViewReady() override { ScheduleApply(); }
+  void RenderViewHostChanged(content::RenderViewHost*,
+                             content::RenderViewHost*) override {
+    ScheduleApply();
+  }
+  void RenderFrameHostChanged(content::RenderFrameHost*,
+                              content::RenderFrameHost* new_host) override {
+    if (web_contents() && new_host == web_contents()->GetPrimaryMainFrame())
+      ScheduleApply();
+  }
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (visibility == content::Visibility::HIDDEN) {
+      desired_ = false;
+      Apply();
+    }
+  }
+  void WebContentsDestroyed() override {
+    desired_ = false;
+    weak_factory_.InvalidateWeakPtrs();
+    observation_.Reset();
+    widget_.reset();
+    Observe(nullptr);
+  }
+ private:
+  friend class content::WebContentsUserData<ExternalFocus>;
+  explicit ExternalFocus(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<ExternalFocus>(*contents) {}
+  bool Apply() {
+    auto* contents = web_contents();
+    auto* view = contents ? contents->GetRenderWidgetHostView() : nullptr;
+    auto* host = widget_
+        ? views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+              widget_->GetNativeWindow()) : nullptr;
+    if (!host || (desired_ && !view)) return false;
+    if (view && static_cast<content::RenderWidgetHostViewBase*>(view)
+                    ->IsRenderWidgetHostViewChildFrame()) return false;
+    auto self = weak_factory_.GetWeakPtr();
+    auto contents_weak = contents ? contents->GetWeakPtr()
+                                  : base::WeakPtr<content::WebContents>();
+    const bool focused = desired_;
+    if (!host->SetExternalHostFocus(focused) || !self) return false;
+    // Native activation can call client code and replace/destroy contents.
+    // Re-read the view only through a surviving owner after that dispatch.
+    view = contents_weak ? contents_weak->GetRenderWidgetHostView() : nullptr;
+    if (focused && !view) return false;
+    if (view) {
+      if (static_cast<content::RenderWidgetHostViewBase*>(view)
+              ->IsRenderWidgetHostViewChildFrame()) return false;
+      static_cast<content::RenderWidgetHostViewMac*>(view)
+          ->SetExternalHostFocus(focused);
+    }
+    return true;
+  }
+  void ApplyIfDesired() {
+    if (desired_) Apply();
+  }
+  void ScheduleApply() {
+    // Run after the current swap/attachment notification. No timer, JS focus
+    // or delayed text insertion substitutes for native renderer readiness.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ExternalFocus::ApplyIfDesired,
+                                 weak_factory_.GetWeakPtr()));
+  }
+  bool desired_ = false;
+  base::WeakPtr<views::Widget> widget_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+  base::WeakPtrFactory<ExternalFocus> weak_factory_{this};
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ExternalFocus);
+}  // namespace
