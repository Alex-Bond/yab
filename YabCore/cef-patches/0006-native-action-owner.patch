+// Experimental native identity prototype. No remote presentation is enabled.
+#ifndef CHROME_BROWSER_EXTENSIONS_EXTERNAL_ACTION_ORIGIN_H_
+#define CHROME_BROWSER_EXTENSIONS_EXTERNAL_ACTION_ORIGIN_H_
+
+#include <memory>
+#include <string>
+#include <utility>
+#include "base/memory/weak_ptr.h"
+#include "base/supports_user_data.h"
+#include "base/unguessable_token.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents.h"
+
+namespace extensions {
+// UI sequence only. Owned by the actual action popup WebContents. Capture at
+// TriggerPopup, before asynchronous toolbar animation or document loading.
+// Neither a window title nor the currently active tab can recreate this owner.
+class ExternalActionOrigin : public base::SupportsUserData::Data {
+ public:
+  static bool Attach(content::WebContents* popup, content::WebContents* owner,
+                     const std::string& extension_id) {
+    if (!popup || !owner || popup == owner || extension_id.empty() ||
+        popup->GetBrowserContext() != owner->GetBrowserContext() ||
+        !owner->GetPrimaryMainFrame() || owner->IsBeingDestroyed()) return false;
+    popup->SetUserData(&kKey, std::unique_ptr<ExternalActionOrigin>(
+        new ExternalActionOrigin(*popup, *owner, extension_id)));
+    return true;
+  }
+  static ExternalActionOrigin* Get(content::WebContents* popup) {
+    return popup && !popup->IsBeingDestroyed()
+        ? static_cast<ExternalActionOrigin*>(popup->GetUserData(&kKey)) : nullptr;
+  }
+  content::WebContents* Owner(content::WebContents* popup) const {
+    auto* document = document_.AsRenderFrameHostIfValid();
+    if (!popup || popup != popup_.get() || popup->IsBeingDestroyed() ||
+        !owner_ || owner_->IsBeingDestroyed() || !document ||
+        owner_->GetPrimaryMainFrame() != document ||
+        owner_->GetBrowserContext() != popup->GetBrowserContext()) return nullptr;
+    return owner_.get();
+  }
+  const std::string& extension_id() const { return extension_id_; }
+  const base::UnguessableToken& token() const { return token_; }
+ private:
+  ExternalActionOrigin(content::WebContents& popup, content::WebContents& owner,
+                       std::string extension_id)
+      : popup_(popup.GetWeakPtr()), owner_(owner.GetWeakPtr()),
+        document_(owner.GetPrimaryMainFrame()->GetWeakDocumentPtr()),
+        extension_id_(std::move(extension_id)),
+        token_(base::UnguessableToken::Create()) {}
+  inline static const int kKey = 0;
+  base::WeakPtr<content::WebContents> popup_, owner_;
+  content::WeakDocumentPtr document_;
+  const std::string extension_id_;
+  const base::UnguessableToken token_;
+};
+}  // namespace extensions
+#endif
