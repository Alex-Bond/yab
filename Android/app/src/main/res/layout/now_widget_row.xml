<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/now_widget_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="40dp" android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp"
    android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/now_widget_who" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/now_widget_primary" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/now_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="@color/now_widget_primary" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/now_widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="@color/now_widget_secondary" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
