<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@color/now_widget_surface">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/now_widget_name" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/now_widget_primary" />
    <LinearLayout android:id="@+id/now_widget_rows" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <LinearLayout android:id="@+id/now_widget_quiet" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/now_widget_search" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/entrance_search" android:textAllCaps="false" />
        <Button android:id="@+id/now_widget_ask" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/entrance_ask" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
