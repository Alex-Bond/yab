{
  "manifest_version": 2,
  "name": "Yab owned image downloads",
  "version": "1.0.1",
  "browser_specific_settings": {"gecko": {"id": "yab-owned-image@browser.local"}},
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "webRequest", "webRequestBlocking", "webNavigation", "scripting", "tabs", "<all_urls>"],
  "background": {"scripts": ["guards.js", "page-start.js", "background.js"]},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["guards.js", "content.js"], "run_at": "document_idle", "all_frames": false}]
}
