{
  "manifest_version": 2,
  "name": "Yab Shield",
  "version": "1.0.3",
  "browser_specific_settings": {"gecko": {"id": "yab-shield@browser.local"}},
  "permissions": ["nativeMessaging", "geckoViewAddons", "webRequest", "webRequestBlocking", "scripting", "publicSuffix", "tabs", "<all_urls>"],
  "background": {"scripts": ["matcher.js", "background.js"]},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["cosmetics.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}]
}
